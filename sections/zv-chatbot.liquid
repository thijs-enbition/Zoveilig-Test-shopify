{%- comment -%}
  FAQ chatbot section — wraps snippets/zv-chatbot.liquid with its own settings and loads
  its own JS/CSS. Deliberately self-contained (endpoint + anon key as section settings,
  not global theme settings) rather than sitewide, since the widget is only added to
  Klantenservice, Oplossingen and Contact (per docs/chatbot-faq-design-2026-09-17.md) —
  loading its JS/CSS only where this section is placed keeps the other pages from paying
  for a widget they don't show, matching the more recent per-form Supabase settings
  pattern (see sections/contact-page.liquid's capture_lead_endpoint/anon_key) rather than
  the older sitewide callback_endpoint theme setting.
{%- endcomment -%}

{{ 'zv-chatbot.css' | asset_url | stylesheet_tag }}

{% render 'zv-chatbot',
  endpoint: section.settings.chatbot_endpoint,
  anon_key: section.settings.chatbot_anon_key,
  id: section.id %}

<script src="{{ 'zv-chatbot.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "FAQ chatbot",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "chatbot-faq endpoint (Supabase)"
    },
    {
      "type": "text",
      "id": "chatbot_endpoint",
      "label": "chatbot-faq endpoint URL",
      "default": "https://lfwkpbooieiesuvblvse.supabase.co/functions/v1/chatbot-faq",
      "info": "Bijv. https://<project-ref>.supabase.co/functions/v1/chatbot-faq. Leeg = de chat toont een foutmelding bij versturen."
    },
    {
      "type": "text",
      "id": "chatbot_anon_key",
      "label": "Supabase anon (public) API key",
      "default": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxmd2twYm9vaWVpZXN1dmJsdnNlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0NjI2ODYsImV4cCI6MjEwNTAzODY4Nn0.mwOnoWN2pDZ5J8nj0RfEMbnrH8HUei0C6qCKGt4twaE",
      "info": "De publieke anon key van het Supabase-project, niet de service role key."
    }
  ],
  "presets": [{ "name": "FAQ chatbot" }]
}
{% endschema %}
