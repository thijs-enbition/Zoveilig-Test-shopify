{%- comment -%}
  Zo Veilig — 404 / pagina niet gevonden. 1:1 port of the design pack 404.
  Search posts to Shopify /search; helpful links via zv-route. Header/footer
  come from the theme layout.
{%- endcomment -%}

<div class="zv-404">
  <section class="nf">
    <div class="wrap">
      <div class="nf-grid">
        <div class="nf-code">4<span>0</span>4</div>
        <div class="nf-copy">
          <h1>Deze pagina konden we niet vinden</h1>
          <p>De link is misschien verouderd of verplaatst. Geen zorgen, we helpen u snel weer op weg naar wat u zocht.</p>
          <form class="nf-search" method="get" action="{{ routes.search_url }}" role="search">
            <input type="search" name="q" placeholder="Zoek in onze site, bijv. sensoren of meldkamer" aria-label="Zoeken">
            <button class="btn btn--indigo" type="submit">Zoek</button>
          </form>
          <div class="nf-cta">
            <a class="btn btn--gold" href="{% render 'zv-route', key: 'home' %}">Naar de homepagina
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="btn btn--ghost" href="{% render 'zv-route', key: 'contact' %}">Neem contact op</a>
            <a class="btn btn--ghost" href="mailto:klantenservice@zoveilig.nl">Mail de klantenservice</a>
          </div>
          <div class="nf-links">
            <h4>Misschien zoekt u dit</h4>
            <ul>
              <li><a href="{% render 'zv-route', key: 'oplossingen' %}?cat=living">Langer Thuis<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
              <li><a href="{% render 'zv-route', key: 'vergelijk-pakketten' %}">Vergelijk pakketten<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
              <li><a href="{% render 'zv-route', key: 'kenniscentrum' %}">Kenniscentrum<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
              <li><a href="{% render 'zv-route', key: 'faq' %}">Veelgestelde vragen<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.zv-404 {
  --ink:#1a1230; --indigo:#322469; --paper:#fffdf8; --cream:#fdfaf2;
  --gold:#e4a311; --gold-lt:#f5c84a; --belt:#b67e0a; --line:#e7e0cf; --line-2:#ddd4c0;
  --muted:#6f6786; --muted-2:#8c84a6;
  color:var(--ink); line-height:1.5; background:var(--cream);
}
.zv-404 .wrap { max-width:1180px; margin:0 auto; padding:0 clamp(20px,3.6vw,52px); }
.zv-404 .nf { display:flex; align-items:center; padding:clamp(48px,7vw,110px) 0; background:radial-gradient(70% 120% at 92% 0%,rgba(228,163,17,.14),transparent 58%); }
.zv-404 .nf-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(32px,5vw,72px); align-items:center; }
@media(max-width:820px){ .zv-404 .nf-grid { grid-template-columns:1fr; } }
.zv-404 .nf-code { font-size:clamp(120px,20vw,240px); font-weight:900; letter-spacing:-.05em; line-height:.82; color:var(--indigo); position:relative; }
.zv-404 .nf-code span { color:var(--gold); }
.zv-404 .nf-code::after { content:"Pagina niet gevonden"; position:absolute; left:6px; bottom:-4px; font-size:13px; font-weight:800; letter-spacing:.2em; text-transform:uppercase; color:var(--belt); }
.zv-404 .nf h1 { font-size:clamp(28px,3.4vw,42px); font-weight:900; color:var(--indigo); letter-spacing:-.02em; line-height:1.05; text-wrap:balance; }
.zv-404 .nf p { font-size:17px; font-weight:500; color:#5b5374; margin-top:16px; max-width:46ch; line-height:1.6; }
.zv-404 .btn { display:inline-flex; align-items:center; gap:9px; border:none; cursor:pointer; border-radius:999px; font:inherit; font-weight:800; text-decoration:none; padding:13px 22px; }
.zv-404 .btn svg { width:18px; height:18px; }
.zv-404 .btn--gold { background:linear-gradient(180deg,var(--gold-lt),var(--gold)); color:#3a2a06; box-shadow:0 14px 30px -18px rgba(228,163,17,.9); }
.zv-404 .btn--indigo { background:var(--indigo); color:#fff; }
.zv-404 .btn--ghost { background:transparent; color:var(--indigo); border:1.5px solid var(--line); }
.zv-404 .btn--ghost:hover { background:var(--paper); }
.zv-404 .nf-search { margin-top:26px; display:flex; gap:10px; max-width:420px; }
.zv-404 .nf-search input { flex:1; background:#fff; border:1.5px solid var(--line-2); border-radius:999px; padding:13px 20px; font:inherit; font-size:15px; font-weight:600; color:var(--ink); }
.zv-404 .nf-search input:focus { outline:none; border-color:var(--indigo); }
.zv-404 .nf-cta { display:flex; gap:13px; flex-wrap:wrap; margin-top:28px; }
.zv-404 .nf-links { margin-top:34px; padding-top:24px; border-top:1px solid var(--line); }
.zv-404 .nf-links h4 { font-size:11.5px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; color:var(--muted-2); margin-bottom:14px; }
.zv-404 .nf-links ul { list-style:none; display:grid; grid-template-columns:1fr 1fr; gap:10px 22px; }
@media(max-width:520px){ .zv-404 .nf-links ul { grid-template-columns:1fr; } }
.zv-404 .nf-links a { display:inline-flex; align-items:center; gap:9px; font-size:15px; font-weight:700; color:var(--indigo); text-decoration:none; }
.zv-404 .nf-links a svg { width:16px; height:16px; color:var(--gold); transition:transform .15s; }
.zv-404 .nf-links a:hover svg { transform:translateX(3px); }
{% endstylesheet %}

{% schema %}
{
  "name": "404 pagina",
  "tag": "section",
  "settings": []
}
{% endschema %}
