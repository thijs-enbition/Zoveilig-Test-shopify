{%- include 'zv-pricing' -%}
{%- comment -%}
  Zo Veilig — Vergelijk pakketten. 1:1 port of the design pack
  "Zo Veilig Vergelijk Pakketten.html": hero, Langer Thuis comparison table
  (Inzicht/Zeker/Beschermd, FINAL prices), Mijn Thuis + Veilig Onderweg cards
  (prijs volgt), Keuzehulp help-CTA. Header + footer come from the theme.
  Prices are the finalized Langer Thuis tiers per the project constitution.

  PAKKET-MATCHER (scenario cards + comparison table): rendered via the shared
  snippets/zv-pakket-matcher.liquid — the same snippet sections/oplossingen.liquid uses to
  embed the matcher under the Langer Thuis pricing cards, so there is exactly one copy of
  the matcher markup and (in assets/zv-vergelijk-pakketten.js) its scoring/highlight logic.
  See that snippet's header comment for the full mapping/scoring notes.
{%- endcomment -%}

{{ 'zv-vergelijk-pakketten.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zv-vergelijk-pakketten.js' | asset_url }}" defer="defer"></script>

{%- assign activation_variant_id = all_products[zv_activation_handle].selected_or_first_available_variant.id -%}
{%- liquid
  assign arrow = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>'
  assign opl = '/pages/oplossingen'
  assign scenarios = section.blocks | where: 'type', 'scenario'
-%}

<div class="zv-vergelijk">
  <!-- HERO -->
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="d"></span>{{ section.settings.eyebrow | default: 'Vergelijk pakketten' | escape }}</span>
      <h1>{{ section.settings.heading | default: 'Welk pakket past bij uw situatie?' | escape }}</h1>
      <p class="sub">{{ section.settings.sub | default: 'Drie niveaus, van een geruststellend seintje tot volledige meldkameropvolging. U kunt altijd later uitbreiden.' | escape }}</p>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="cmp">
    <div class="wrap">
      <div class="cmp-lead">Langer Thuis</div>
      <h2>Vergelijk de drie niveaus</h2>
      <p class="sub">Alle pakketten werken zonder camera. U kiest hoeveel opvolging en zekerheid u wilt.</p>
    </div>

    {%- render 'zv-pakket-matcher',
      scenarios: scenarios,
      collection: section.settings.collection,
      pm_heading: section.settings.pm_heading,
      pm_sub: section.settings.pm_sub,
      advies_label: section.settings.advies_label,
      cta_label: section.settings.cta_label,
      cta_added: section.settings.cta_added,
      cta_view_cart: section.settings.cta_view_cart,
      match_badge: section.settings.match_badge,
      tagline_inzicht: section.settings.tagline_inzicht,
      tagline_zeker: section.settings.tagline_zeker,
      tagline_beschermd: section.settings.tagline_beschermd,
      activation_variant_id: activation_variant_id,
      zv_inzicht_monthly: zv_inzicht_monthly,
      zv_zeker_monthly: zv_zeker_monthly,
      zv_beschermd_monthly: zv_beschermd_monthly,
      opl_url: opl
    -%}

    <div class="wrap">
      <!-- OTHER LINES -->
      <div class="cmp-more">
        <div class="cmp-card">
          <span class="k">Mijn Thuis</span>
          <h3>Woningbeveiliging tegen inbraak en brand</h3>
          <p>Een slim alarmsysteem dat inbraak, brand of onraad direct opmerkt en u meteen waarschuwt. Uit te breiden met camera en meldkameropvolging.</p>
          <div class="cmp-tiers"><span class="cmp-tier">Alert</span><span class="cmp-tier">Protect</span><span class="cmp-tier">Vista</span></div>
          <span class="soon">Prijzen volgen binnenkort</span>
          <a class="lk" href="{{ opl }}">Bekijk Mijn Thuis {{ arrow }}</a>
        </div>
        <div class="cmp-card">
          <span class="k">Veilig Onderweg</span>
          <h3>Persoonlijke alarmering, waar u ook bent</h3>
          <p>Een persoonlijk alarm met GPS en valdetectie dat met één druk op de knop hulp inschakelt. Voor iedereen die met een gerust gevoel op pad wil.</p>
          <div class="cmp-tiers"><span class="cmp-tier">Paniek Meldkamer</span><span class="cmp-tier">Zorgmeldkamer</span></div>
          <span class="soon">Prijzen volgen binnenkort</span>
          <a class="lk" href="{{ opl }}">Bekijk Veilig Onderweg {{ arrow }}</a>
        </div>
      </div>

      <div class="cmp-help">
        <h3>Nog niet zeker welk pakket past?</h3>
        <p>Beantwoord een paar korte vragen in de Keuzehulp en ontdek de oplossing die bij uw situatie past.</p>
        <div class="row">
          <a class="btn btn--gold" href="{% render 'zv-route', key: 'keuzehulp' %}">Doe de Keuzehulp {{ arrow }}</a>
          <a class="btn btn--ghost-light" href="{% render 'zv-route', key: 'klantenservice' %}#contact">Vraag advies</a>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Vergelijk pakketten",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Vergelijk pakketten" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Welk pakket past bij uw situatie?" },
    { "type": "textarea", "id": "sub", "label": "Subtekst" },
    { "type": "header", "content": "Pakket-matcher (scenariokaarten)" },
    { "type": "text", "id": "pm_heading", "label": "Kop", "default": "Welk pakket past bij uw situatie?" },
    { "type": "text", "id": "pm_sub", "label": "Subtekst", "default": "Kies wat herkenbaar is." },
    { "type": "collection", "id": "collection", "label": "Pakketten-collectie", "info": "Producten met een custom.finder_key metafield (aware, aware_plus, care). Standaard: langer-thuis." },
    { "type": "text", "id": "advies_label", "label": "Advies-label", "default": "Ons advies:" },
    { "type": "text", "id": "cta_label", "label": "Knoptekst · toevoegen", "default": "Voeg [pakket] toe aan winkelwagen", "info": "[pakket] wordt vervangen door de pakketnaam." },
    { "type": "text", "id": "cta_added", "label": "Knoptekst · toegevoegd", "default": "Toegevoegd ✓" },
    { "type": "text", "id": "cta_view_cart", "label": "Knoptekst · bekijk winkelwagen", "default": "Bekijk winkelwagen" },
    { "type": "text", "id": "match_badge", "label": "Badge bij passend pakket", "default": "Past bij uw situatie" },
    { "type": "header", "content": "Vergelijkingstabel · Meest geschikt voor" },
    { "type": "text", "id": "tagline_inzicht", "label": "Inzicht", "default": "Rustig eerste inzicht" },
    { "type": "text", "id": "tagline_zeker", "label": "Zeker", "default": "Vroeg signaleren van veranderingen" },
    { "type": "text", "id": "tagline_beschermd", "label": "Beschermd", "default": "Snelle hulp bij een val of noodsituatie" }
  ],
  "blocks": [
    {
      "type": "scenario",
      "name": "Scenariokaart",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "text", "id": "quote", "label": "Voorbeeldmelding (cursief)" },
        { "type": "select", "id": "package", "label": "Past bij pakket", "options": [
          { "value": "inzicht", "label": "Inzicht" },
          { "value": "zeker", "label": "Zeker" },
          { "value": "beschermd", "label": "Beschermd" }
        ], "default": "zeker" },
        { "type": "select", "id": "row", "label": "Rij", "options": [
          { "value": "1", "label": "Rij 1" },
          { "value": "2", "label": "Rij 2" },
          { "value": "3", "label": "Rij 3" }
        ], "default": "1" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{
    "name": "Vergelijk pakketten",
    "blocks": [
      { "type": "scenario", "settings": { "title": "Weet dat de dag goed is begonnen", "quote": "Vanochtend om 08:27 opgestaan.", "package": "inzicht", "row": "1" } },
      { "type": "scenario", "settings": { "title": "Zie wanneer er iets verandert", "quote": "Vannacht meerdere keren beweging.", "package": "zeker", "row": "1" } },
      { "type": "scenario", "settings": { "title": "Krijg een seintje als het stil blijft", "quote": "Sinds 13:45 geen beweging.", "package": "inzicht", "row": "1" } },
      { "type": "scenario", "settings": { "title": "Waarschuwing bij onverwachte situaties", "quote": "Voordeur is vannacht om 03:18 geopend.", "package": "zeker", "row": "1" } },
      { "type": "scenario", "settings": { "title": "Een mogelijke val eerder signaleren", "quote": "10:41, looproute stopt onverwacht in de gang.", "package": "zeker", "row": "2" } },
      { "type": "scenario", "settings": { "title": "Zie wanneer een routine ineens verandert", "quote": "09:15, de keuken is vandaag nog niet bezocht.", "package": "zeker", "row": "2" } },
      { "type": "scenario", "settings": { "title": "Snelle hulp als iedere seconde telt", "quote": "04:40 noodknop ingedrukt, meldkamer belt contactpersonen.", "package": "beschermd", "row": "2" } },
      { "type": "scenario", "settings": { "title": "Rook en brandbeveiliging", "quote": "06:38 brandalarm, meldkamer schakelt direct de hulpdiensten in.", "package": "beschermd", "row": "3" } },
      { "type": "scenario", "settings": { "title": "Opvolging aan huis mogelijk", "quote": "Als extra optie is een zorgpartner aan huis mogelijk.", "package": "beschermd", "row": "3" } }
    ]
  }]
}
{% endschema %}
