{%- include 'zv-pricing' -%}
{%- comment -%}
  Zo Veilig — Actie: 50% korting (Langer Thuis + Mijn Thuis).
  Promo landing page for the intro offer (pricing/pricing.config.json "promo":
  intro-3-months-50). This page only surfaces it commercially; every price and the
  discount rate itself come from the zv-pricing include, never a literal here (CI
  check #9 in scripts/check_pricing.py enforces that).

  Whether the promo is actually live right now is controlled by the Shopify theme
  setting `zv_promo_live` (Zo Veilig · Introductiekorting) — a checkbox Thijs can flip
  from the theme editor, no code change or redeploy needed. `zv_promo_active` (from
  zv-pricing, i.e. pricing.config.json `promo.enabled`/`ratePercent`) confirms the
  mechanism itself is valid; both must be true for the discount to show. While either
  is off, the whole page degrades to a plain package overview: no discount badge, no
  struck-through "was" price, no disclosure text. It stays live rather than being
  unpublished so the URL keeps working; turning the setting on brings the discount
  framing straight back with no further changes here.

  Cards link out to the existing, tested purchase flow on /pages/oplossingen (deep-linked
  per package via zv-route's "pakket" key) rather than re-implementing add-to-cart, so this
  stays a lightweight top-of-funnel page.
{%- endcomment -%}

{%- assign zv_promo_mechanism_active = zv_promo_active -%}
{%- assign zv_promo_active = false -%}
{%- if zv_promo_mechanism_active and settings.zv_promo_live -%}
  {%- assign zv_promo_active = true -%}
{%- endif -%}
{%- liquid
  assign arrow = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>'
-%}

<div class="zv-actie">
  <!-- HERO -->
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="d"></span>{{ section.settings.eyebrow | default: 'Tijdelijke actie' | escape }}</span>
      {%- if zv_promo_active -%}
        <h1>{{ zv_promo_badge }} op Langer Thuis en Mijn Thuis</h1>
        <p class="sub">{{ section.settings.sub | default: 'Kies het pakket dat past bij uw situatie. De eerste maanden betaalt u nog maar de helft, daarna gewoon het vaste maandbedrag. Geen verrassingen, wel meteen gemoedsrust.' | escape }}</p>
      {%- else -%}
        <h1>Onze pakketten voor Langer Thuis en Mijn Thuis</h1>
        <p class="sub">Kies het pakket dat past bij uw situatie. Vast maandbedrag, geen verrassingen.</p>
      {%- endif -%}
      <div class="hero-cta">
        <a class="btn btn--gold" href="#pakketten">Bekijk de pakketten{{ arrow }}</a>
        <a class="btn btn--ghost-light" href="{% render 'zv-route', key: 'keuzehulp' %}" data-zv-finder>Doe de Keuzehulp</a>
      </div>
    </div>
  </section>

  <!-- LANGER THUIS -->
  <section class="grp" id="pakketten">
    <div class="wrap">
      <div class="grp-lead">Langer Thuis</div>
      <h2>Een dierbare langer zelfstandig, zonder camera</h2>
      <p class="sub">Slimme sensoren zien wanneer de dag goed begint en waarschuwen alleen als er iets afwijkt.</p>

      <div class="pgrid">
        {%- liquid
          assign lt_ids = 'inzicht,zeker,beschermd' | split: ','
          assign lt_fks = 'aware,aware_plus,care' | split: ','
          assign lt_names = 'Inzicht,Zeker,Beschermd' | split: ','
          assign lt_hooks = 'Weet dat de dag normaal en veilig is begonnen.,Zie subtiele veranderingen vóór het misgaat.,Complete bescherming met 24/7 meldkamer.' | split: ','
          assign lt_popular = ',Meest gekozen,'  | split: ','
        -%}
        {%- for id in lt_ids -%}
          {%- assign i = forloop.index0 -%}
          {%- case id -%}
            {%- when 'inzicht' -%}{%- assign monthly = zv_inzicht_monthly -%}{%- assign promo_monthly = zv_inzicht_promo_monthly -%}
            {%- when 'zeker' -%}{%- assign monthly = zv_zeker_monthly -%}{%- assign promo_monthly = zv_zeker_promo_monthly -%}
            {%- when 'beschermd' -%}{%- assign monthly = zv_beschermd_monthly -%}{%- assign promo_monthly = zv_beschermd_promo_monthly -%}
          {%- endcase -%}
          {%- unless zv_promo_active -%}{%- assign promo_monthly = blank -%}{%- endunless -%}
          {%- render 'zv-actie-card', name: lt_names[i], hook: lt_hooks[i], popular: lt_popular[i], monthly: monthly, promo_monthly: promo_monthly, promo_badge: zv_promo_badge, fk: lt_fks[i] -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- MIJN THUIS -->
  <section class="grp alt">
    <div class="wrap">
      <div class="grp-lead">Mijn Thuis</div>
      <h2>Uw woning beschermd tegen inbraak, brand en onraad</h2>
      <p class="sub">Van een slim alarm dat u zelf beheert tot een aansluiting op een 24/7 meldkamer.</p>

      <div class="pgrid">
        {%- liquid
          assign mt_ids = 'alert,protect,vista' | split: ','
          assign mt_fks = 'secure,guard,secure_plus' | split: ','
          assign mt_names = 'Alert,Protect,Vista' | split: ','
          assign mt_hooks = 'Slim alarm dat u zelf in de gaten houdt.,Alarm met 24/7 meldkamer die meekijkt.,Complete beveiliging met meldkamer én camera.' | split: ','
          assign mt_popular = ',Meest gekozen,' | split: ','
        -%}
        {%- for id in mt_ids -%}
          {%- assign i = forloop.index0 -%}
          {%- case id -%}
            {%- when 'alert' -%}{%- assign monthly = zv_alert_monthly -%}{%- assign promo_monthly = zv_alert_promo_monthly -%}
            {%- when 'protect' -%}{%- assign monthly = zv_protect_monthly -%}{%- assign promo_monthly = zv_protect_promo_monthly -%}
            {%- when 'vista' -%}{%- assign monthly = zv_vista_monthly -%}{%- assign promo_monthly = blank -%}
          {%- endcase -%}
          {%- unless zv_promo_active -%}{%- assign promo_monthly = blank -%}{%- endunless -%}
          {%- render 'zv-actie-card', name: mt_names[i], hook: mt_hooks[i], popular: mt_popular[i], monthly: monthly, promo_monthly: promo_monthly, promo_badge: zv_promo_badge, fk: mt_fks[i] -%}
        {%- endfor -%}
      </div>

      {%- if zv_promo_active -%}<p class="fine">{{ zv_promo_disclosure }}</p>{%- endif -%}
    </div>
  </section>

  <!-- HELP -->
  <section class="grp">
    <div class="wrap">
      <div class="help">
        <h3>{{ section.settings.help_heading | default: 'Nog niet zeker welk pakket bij u past?' | escape }}</h3>
        <p>{{ section.settings.help_sub | default: 'Doe de Keuzehulp en ontdek in een paar vragen welke oplossing bij uw situatie past. Deze actie geldt voor een beperkte periode.' | escape }}</p>
        <div class="row">
          <a class="btn btn--gold" href="{% render 'zv-route', key: 'keuzehulp' %}" data-zv-finder>Doe de Keuzehulp{{ arrow }}</a>
          <a class="btn btn--ghost-light" href="{% render 'zv-route', key: 'klantenservice' %}#contact">Vraag advies</a>
        </div>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.zv-actie {
  --ink:#1a1230; --indigo:#322469; --indigo-deep:#281c54; --indigo-soft:#efecf7; --paper:#fffdf8;
  --cream:#fdfaf2; --band:#f4f0e6; --gold:#e4a311; --gold-lt:#f5c84a; --gold-soft:#fbf0d4; --belt:#b67e0a;
  --line:#e7e0cf; --line-2:#dcd2bd; --muted:#6f6786; --muted-2:#8c84a6; --danger:#c52e2f;
  color:var(--ink); line-height:1.5;
}
.zv-actie .wrap { max-width:1080px; margin:0 auto; padding:0 clamp(20px,3.6vw,52px); }
.zv-actie .btn { font-weight:800; font-size:14.5px; border:none; border-radius:12px; padding:13px 20px; line-height:1; display:inline-flex; align-items:center; justify-content:center; gap:8px; cursor:pointer; text-decoration:none; transition:transform .15s,box-shadow .15s; white-space:nowrap; }
.zv-actie .btn svg { width:16px; height:16px; }
.zv-actie .btn--gold { background:var(--gold); color:var(--ink); box-shadow:0 10px 26px -14px rgba(180,126,10,.85); }
.zv-actie .btn--gold:hover { transform:translateY(-2px); }
.zv-actie .btn--ghost-light { color:#fff; border:1.5px solid rgba(255,255,255,.4); background:transparent; }
.zv-actie .btn--ghost-light:hover { background:rgba(255,255,255,.12); }
.zv-actie a:focus-visible, .zv-actie button:focus-visible { outline:2px solid var(--gold-lt); outline-offset:2px; }

.zv-actie .page-hero { background:radial-gradient(64% 120% at 92% 0%,rgba(197,46,47,.34) 0%,rgba(197,46,47,0) 55%),radial-gradient(66% 122% at 4% 102%,rgba(0,80,159,.5) 0%,rgba(0,80,159,0) 58%),linear-gradient(180deg,#2c3076 0%,#241c54 100%); color:#fff; padding:clamp(48px,6vw,84px) 0 clamp(40px,5vw,60px); }
.zv-actie .page-hero .eyebrow { display:inline-flex; align-items:center; gap:9px; font-size:12px; font-weight:800; letter-spacing:.24em; text-transform:uppercase; color:var(--gold-lt); }
.zv-actie .page-hero .eyebrow .d { width:8px; height:8px; border-radius:50%; background:var(--gold); }
.zv-actie .page-hero h1 { font-size:clamp(30px,4vw,50px); font-weight:900; letter-spacing:-.02em; line-height:1.05; margin-top:14px; max-width:22ch; text-wrap:balance; }
.zv-actie .page-hero .sub { font-size:clamp(16px,1.5vw,19px); font-weight:500; color:#e4dffb; margin-top:16px; max-width:56ch; line-height:1.5; }
.zv-actie .hero-cta { display:flex; gap:13px; flex-wrap:wrap; margin-top:28px; }

.zv-actie .grp { background:var(--cream); padding:clamp(30px,4vw,56px) 0; }
.zv-actie .grp.alt { background:var(--paper); }
.zv-actie .grp-lead { font-size:12px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; color:var(--belt); margin-bottom:8px; }
.zv-actie .grp h2 { font-size:clamp(22px,2.6vw,32px); font-weight:900; color:var(--indigo); letter-spacing:-.02em; }
.zv-actie .grp .sub { font-size:15.5px; font-weight:500; color:var(--muted); margin-top:10px; max-width:60ch; line-height:1.55; }
.zv-actie .fine { font-size:12.5px; font-weight:500; color:var(--muted-2); margin-top:26px; max-width:70ch; line-height:1.5; }

.zv-actie .pgrid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:26px; }
@media (max-width:900px) { .zv-actie .pgrid { grid-template-columns:1fr; } }

.zv-actie .help { margin-top:6px; background:var(--indigo-deep); color:#fff; border-radius:20px; padding:clamp(28px,3.5vw,46px); text-align:center; position:relative; overflow:hidden; }
.zv-actie .help::before { content:""; position:absolute; width:460px; height:460px; border-radius:50%; left:-140px; bottom:-180px; background:radial-gradient(circle,rgba(0,80,159,.4),transparent 60%); }
.zv-actie .help h3 { font-size:clamp(22px,2.4vw,30px); font-weight:900; letter-spacing:-.015em; position:relative; }
.zv-actie .help p { font-size:16px; color:#d8d2ef; margin:12px auto 0; max-width:52ch; line-height:1.55; position:relative; }
.zv-actie .help .row { display:flex; gap:13px; justify-content:center; flex-wrap:wrap; margin-top:24px; position:relative; }

.zv-actie .acard { background:var(--paper); border:1px solid var(--line); border-radius:18px; padding:26px 24px; box-shadow:0 20px 48px -44px rgba(26,18,48,.5); display:flex; flex-direction:column; position:relative; }
.zv-actie .acard.pop { border-color:var(--gold); box-shadow:0 0 0 1px var(--gold),0 18px 44px -22px rgba(180,126,10,.4); }
.zv-actie .acard__flag { align-self:flex-start; margin-bottom:12px; color:var(--belt); font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; background:var(--gold-soft); border-radius:999px; padding:4px 11px; }
.zv-actie .acard h3 { font-size:21px; font-weight:900; color:var(--indigo); letter-spacing:-.01em; }
.zv-actie .acard__hook { font-size:14px; font-weight:500; color:var(--muted); margin-top:6px; line-height:1.5; min-height:2.6em; }
.zv-actie .acard__price { display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; margin-top:16px; }
.zv-actie .acard__price .now { font-size:27px; font-weight:900; color:var(--ink); letter-spacing:-.01em; }
.zv-actie .acard__price .per { font-size:13px; font-weight:700; color:var(--muted); }
.zv-actie .acard__price .was { font-size:14px; font-weight:700; color:var(--muted-2); text-decoration:line-through; }
.zv-actie .acard__badge { display:inline-block; align-self:flex-start; margin-top:8px; font-size:11.5px; font-weight:800; color:#fff; background:var(--danger); border-radius:999px; padding:4px 11px; }
.zv-actie .acard .btn--ghost { background:transparent; color:var(--indigo); border:1.6px solid var(--line-2); margin-top:20px; }
.zv-actie .acard .btn--ghost:hover { border-color:var(--indigo); }
{% endstylesheet %}

{% schema %}
{
  "name": "Actie korting",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tijdelijke actie" },
    { "type": "textarea", "id": "sub", "label": "Subtekst onder de kop" },
    { "type": "text", "id": "help_heading", "label": "Kop hulpblok", "default": "Nog niet zeker welk pakket bij u past?" },
    { "type": "textarea", "id": "help_sub", "label": "Tekst hulpblok" }
  ],
  "presets": [{ "name": "Actie korting" }]
}
{% endschema %}
