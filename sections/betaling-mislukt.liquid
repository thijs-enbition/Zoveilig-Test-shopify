{%- comment -%}
  Zo Veilig — Betaling mislukt. 1:1 port of the design pack payment-failed page.
  Centered reassurance card: retry to checkout, back to cart, common causes,
  phone help. Header/footer come from the theme layout.
{%- endcomment -%}

<div class="zv-payfail">
  <div class="pf">
    <div class="wrap">
      <div class="pf-card">
        <div class="pf-ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 10h18" stroke="currentColor" stroke-width="2"/><path d="M9 21l6-18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
        <h1>{{ section.settings.title | default: 'De betaling is niet gelukt' | escape }}</h1>
        <p class="lead">{{ section.settings.lead | default: 'Er is niets afgeschreven en uw bestelling staat nog klaar. U kunt de betaling zo opnieuw proberen, uw winkelwagen is bewaard.' | escape }}</p>
        {%- if section.settings.ref != blank -%}
          <div class="pf-ref">Bestelling <b>{{ section.settings.ref | escape }}</b> · nog niet betaald</div>
        {%- endif -%}
        <div class="pf-reasons">
          <h3>Dit gaat meestal om iets kleins</h3>
          <ul>
            <li>De daglimiet van uw bank of pas was bereikt.</li>
            <li>De betaling is per ongeluk afgebroken of het tabblad is gesloten.</li>
            <li>Er zat een tijdelijke storing bij de betaalprovider.</li>
            <li>De gegevens van de betaalmethode klopten net niet.</li>
          </ul>
        </div>
        <div class="pf-cta">
          <a class="btn btn--gold" href="{{ routes.cart_url }}?checkout">Probeer opnieuw te betalen <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a class="btn btn--ghost" href="{{ routes.cart_url }}">Terug naar winkelwagen</a>
        </div>
        <div class="pf-help">Lukt het nog steeds niet? We helpen u graag persoonlijk verder.<br><a class="call" href="tel:0881221111"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 14l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>088 122 11 11</a></div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.zv-payfail {
  --ink:#1a1230; --indigo:#322469; --paper:#fffdf8; --cream:#fdfaf2;
  --gold:#e4a311; --gold-lt:#f5c84a; --line:#e7e0cf; --muted:#6f6786; --rood:#e24b4a;
  color:var(--ink); line-height:1.5;
  background:linear-gradient(180deg,#fbf5e9,#f4ecda);
}
.zv-payfail .wrap { max-width:1180px; margin:0 auto; padding:0 clamp(20px,3.6vw,52px); }
.zv-payfail .pf { display:flex; align-items:center; padding:clamp(40px,6vw,90px) 0; }
.zv-payfail .pf-card { max-width:620px; margin:0 auto; background:var(--paper); border:1px solid var(--line); border-radius:24px; padding:clamp(30px,4vw,52px); box-shadow:0 34px 74px -46px rgba(26,18,48,.55); text-align:center; }
.zv-payfail .pf-ic { width:84px; height:84px; border-radius:50%; background:rgba(226,75,74,.12); color:var(--rood); display:grid; place-items:center; margin:0 auto 22px; }
.zv-payfail .pf-ic svg { width:44px; height:44px; }
.zv-payfail .pf-card h1 { font-size:clamp(26px,3.2vw,38px); font-weight:900; color:var(--indigo); letter-spacing:-.02em; line-height:1.05; }
.zv-payfail .pf-card p.lead { font-size:16.5px; font-weight:500; color:#5b5374; margin:14px auto 0; max-width:46ch; line-height:1.6; }
.zv-payfail .pf-ref { display:inline-flex; align-items:center; gap:9px; margin-top:20px; background:var(--cream); border:1px solid var(--line); border-radius:999px; padding:9px 18px; font-size:13.5px; font-weight:700; color:var(--muted); }
.zv-payfail .pf-ref b { color:var(--ink); font-weight:900; }
.zv-payfail .pf-reasons { text-align:left; background:var(--cream); border:1px solid var(--line); border-radius:16px; padding:22px 24px; margin-top:26px; }
.zv-payfail .pf-reasons h3 { font-size:13px; font-weight:800; letter-spacing:.02em; color:var(--indigo); margin-bottom:12px; }
.zv-payfail .pf-reasons ul { list-style:none; display:flex; flex-direction:column; gap:10px; }
.zv-payfail .pf-reasons li { position:relative; padding-left:26px; font-size:14.5px; font-weight:600; color:#5b5374; line-height:1.5; }
.zv-payfail .pf-reasons li::before { content:""; position:absolute; left:0; top:6px; width:14px; height:14px; border-radius:50%; border:2px solid var(--gold); }
.zv-payfail .pf-cta { display:flex; gap:13px; justify-content:center; flex-wrap:wrap; margin-top:28px; }
.zv-payfail .btn { display:inline-flex; align-items:center; gap:9px; border:none; cursor:pointer; border-radius:12px; font:inherit; font-weight:800; text-decoration:none; padding:14px 24px; }
.zv-payfail .btn svg { width:18px; height:18px; }
.zv-payfail .btn--gold { background:linear-gradient(180deg,var(--gold-lt),var(--gold)); color:#3a2a06; box-shadow:0 14px 30px -18px rgba(228,163,17,.9); }
.zv-payfail .btn--gold:hover { filter:brightness(1.03); }
.zv-payfail .btn--ghost { background:transparent; color:var(--indigo); border:1.5px solid var(--line); }
.zv-payfail .btn--ghost:hover { background:var(--cream); }
.zv-payfail .pf-help { margin-top:24px; padding-top:22px; border-top:1px solid var(--line); font-size:14.5px; font-weight:600; color:var(--muted); }
.zv-payfail .pf-help a { font-weight:800; }
.zv-payfail .pf-help .call { display:inline-flex; align-items:center; gap:8px; font-size:17px; font-weight:900; color:var(--indigo); margin-top:8px; text-decoration:none; }
.zv-payfail .pf-help .call svg { width:18px; height:18px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Betaling mislukt",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "De betaling is niet gelukt" },
    { "type": "textarea", "id": "lead", "label": "Lead" },
    { "type": "text", "id": "ref", "label": "Bestelreferentie (voorbeeld, leeg = verbergen)", "info": "Illustratief; leeg laten voor een echte pagina." }
  ],
  "presets": [{ "name": "Betaling mislukt" }]
}
{% endschema %}
