{%- comment -%}
  Zo Veilig — Contact & afspraak. 1:1 port of the design pack Contact page
  (page-hero + cn-grid: adviesgesprek-formulier + belopties/openingstijden).
  The Netlify form is converted to a Shopify {% form 'contact' %}; success is
  handled by Shopify's form.posted_successfully?. Header/footer come from the
  theme layout, so only the page body is rendered here.
{%- endcomment -%}

<div class="zv-contact">
  <section class="page-hero">
    <div class="wrap">
      <div class="crumbs"><a href="{% render 'zv-route', key: 'home' %}">Home</a> <span>›</span> <b>{{ section.settings.crumb | default: 'Contact' | escape }}</b></div>
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Contact & afspraak' | escape }}</span>
      <h1>{{ section.settings.title | default: 'Persoonlijk advies, wanneer het u uitkomt' | escape }}</h1>
      <p class="lead">{{ section.settings.lead | default: 'Liever even overleggen voordat u kiest? Onze adviseurs denken graag met u mee, vrijblijvend en zonder verkooppraat. Plan een gratis adviesgesprek of stel uw vraag hieronder.' | escape }}</p>
    </div>
  </section>

  <section class="cn-wrap">
    <div class="wrap">
      <div class="cn-grid">
        <div class="cn-card">
          <h2>Plan een gratis adviesgesprek</h2>
          <p class="hint">Vul uw gegevens in, dan bellen we u terug op een moment dat u uitkomt. Meestal binnen één werkdag.</p>

          {%- form 'contact', id: 'zv-contact-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="cn-ok" style="display:block">Bedankt, we hebben uw aanvraag ontvangen. Een adviseur neemt binnen één werkdag contact met u op.</div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="cn-err">Controleer even de gemarkeerde velden en probeer het opnieuw.</div>
              {%- endif -%}
              <div class="fld-row">
                <div class="fld"><label for="c-naam">Naam</label><input id="c-naam" name="contact[Naam]" placeholder="Voor- en achternaam" required></div>
                <div class="fld"><label for="c-tel">Telefoon</label><input id="c-tel" name="contact[Telefoon]" type="tel" placeholder="06 12 34 56 78" required></div>
              </div>
              <div class="fld-row">
                <div class="fld"><label for="c-mail">E-mailadres</label><input id="c-mail" name="contact[email]" type="email" placeholder="uw@email.nl" required></div>
                <div class="fld"><label for="c-ond">Onderwerp</label><select id="c-ond" name="contact[Onderwerp]"><option>Advies over een oplossing</option><option>Langer Thuis (zorg &amp; sensoren)</option><option>Mijn Thuis (alarm &amp; camera)</option><option>Veilig Onderweg (personenalarm)</option><option>Zakelijk</option><option>Bestaande klant / service</option></select></div>
              </div>
              <div class="fld"><label for="c-tijd">Wanneer belt u het liefst?</label><select id="c-tijd" name="contact[Voorkeurstijd]"><option>Maakt niet uit</option><option>Ochtend (09:00 - 12:00)</option><option>Middag (12:00 - 17:00)</option><option>Avond (17:00 - 20:00)</option></select></div>
              <div class="fld"><label for="c-msg">Uw vraag of situatie (optioneel)</label><textarea id="c-msg" name="contact[body]" placeholder="Vertel kort waar u mee zit, dan kunnen we u gerichter helpen."></textarea></div>
              <input type="hidden" name="contact[Bron]" value="Contactpagina">
              <div class="cn-submit">
                <button class="btn btn--gold" type="submit">Vraag adviesgesprek aan <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <span class="cn-priv">Uw gegevens worden alleen gebruikt om contact met u op te nemen. Zie de <a href="{% render 'zv-route', key: 'privacyverklaring' %}">privacyverklaring</a>.</span>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>

        <div class="cn-side">
          <div class="cn-opt"><span class="ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 14l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span><div><h3>Bel ons direct</h3><p>Persoonlijk contact met een adviseur.</p><a class="big" href="tel:0881221111">088-122 11 11</a><div class="sub">Ma t/m vr 08:30 - 17:30</div></div></div>
          <div class="cn-opt"><span class="ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><div><h3>Stuur een e-mail</h3><p>Voor niet-urgente vragen. We reageren binnen één werkdag.</p><a class="big" href="mailto:klantenservice@zoveilig.nl" style="font-size:16px">klantenservice@zoveilig.nl</a></div></div>
          <div class="cn-hours"><h3>Meldkamer &amp; klantenservice</h3><ul><li><span>Klantenservice</span><b>Ma - vr 08:30 - 17:30</b></li><li><span>Meldkamer</span><b>24 uur, 7 dagen</b></li></ul><span class="now"><i></i>Nu bereikbaar</span></div>
        </div>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.zv-contact {
  --ink:#1a1230; --indigo:#322469; --indigo-deep:#281c54; --indigo-soft:#ece8fb;
  --paper:#fffdf8; --cream:#fdfaf2; --gold:#e4a311; --gold-lt:#f5c84a;
  --line:#e7e0cf; --line-2:#ddd4c0; --muted:#6f6786; --ok:#2f8f5b;
  color:var(--ink); line-height:1.5;
}
.zv-contact .wrap { max-width:1180px; margin:0 auto; padding:0 clamp(20px,3.6vw,52px); }
.zv-contact .page-hero { background:radial-gradient(64% 120% at 92% 0%,rgba(197,46,47,.3) 0%,rgba(197,46,47,0) 55%),linear-gradient(180deg,#2c3076 0%,#241c54 100%); color:#fff; padding:clamp(38px,4.6vw,64px) 0 clamp(30px,3.5vw,46px); }
.zv-contact .page-hero .crumbs { font-size:12.5px; font-weight:700; color:#cdc6e8; display:flex; gap:8px; align-items:center; }
.zv-contact .page-hero .crumbs a { color:#cdc6e8; text-decoration:none; }
.zv-contact .page-hero .crumbs a:hover { color:#fff; }
.zv-contact .page-hero .crumbs b { color:#fff; }
.zv-contact .page-hero .eyebrow { display:inline-block; margin-top:14px; font-size:12px; font-weight:800; letter-spacing:.22em; text-transform:uppercase; color:var(--gold-lt); }
.zv-contact .page-hero h1 { font-size:clamp(28px,3.6vw,46px); font-weight:900; letter-spacing:-.02em; line-height:1.05; margin-top:10px; }
.zv-contact .page-hero .lead { font-size:clamp(15px,1.5vw,17.5px); font-weight:500; color:#dcd6f0; margin-top:14px; max-width:60ch; line-height:1.6; }
.zv-contact .cn-wrap { padding:clamp(40px,4.5vw,68px) 0 clamp(56px,6vw,90px); background:var(--cream); }
.zv-contact .cn-grid { display:grid; grid-template-columns:1.15fr .85fr; gap:clamp(26px,3.5vw,44px); align-items:start; }
@media(max-width:900px){ .zv-contact .cn-grid { grid-template-columns:1fr; } }
.zv-contact .cn-card { background:var(--paper); border:1px solid var(--line); border-radius:20px; padding:clamp(24px,3vw,38px); box-shadow:0 24px 54px -44px rgba(26,18,48,.5); }
.zv-contact .cn-card h2 { font-size:24px; font-weight:900; color:var(--indigo); letter-spacing:-.015em; }
.zv-contact .cn-card p.hint { font-size:14.5px; font-weight:500; color:var(--muted); margin-top:8px; line-height:1.5; }
.zv-contact .fld { margin-top:18px; }
.zv-contact .fld label { display:block; font-size:13px; font-weight:800; color:var(--ink); margin-bottom:7px; }
.zv-contact .fld input, .zv-contact .fld select, .zv-contact .fld textarea { width:100%; background:var(--cream); border:1.5px solid var(--line-2); border-radius:12px; padding:13px 15px; font:inherit; font-size:15px; font-weight:600; color:var(--ink); }
.zv-contact .fld textarea { min-height:120px; resize:vertical; }
.zv-contact .fld input:focus, .zv-contact .fld select:focus, .zv-contact .fld textarea:focus { outline:none; border-color:var(--indigo); background:#fff; }
.zv-contact .fld-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
@media(max-width:520px){ .zv-contact .fld-row { grid-template-columns:1fr; } }
.zv-contact .cn-submit { margin-top:22px; display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
.zv-contact .cn-priv { font-size:12.5px; font-weight:600; color:var(--muted); max-width:34ch; line-height:1.45; }
.zv-contact .cn-priv a { color:var(--indigo); font-weight:800; }
.zv-contact .cn-ok { margin-top:0; background:rgba(47,143,91,.1); border:1px solid rgba(47,143,91,.4); border-radius:12px; padding:16px 18px; color:#256b45; font-size:14.5px; font-weight:700; }
.zv-contact .cn-err { background:rgba(197,46,47,.08); border:1px solid rgba(197,46,47,.35); border-radius:12px; padding:13px 16px; color:#9a2b2b; font-size:14px; font-weight:700; margin-bottom:4px; }
.zv-contact .btn { display:inline-flex; align-items:center; gap:9px; border:none; cursor:pointer; border-radius:12px; font:inherit; font-weight:800; text-decoration:none; }
.zv-contact .btn svg { width:18px; height:18px; }
.zv-contact .btn--gold { background:linear-gradient(180deg,var(--gold-lt),var(--gold)); color:#3a2a06; padding:14px 24px; box-shadow:0 14px 30px -18px rgba(228,163,17,.9); }
.zv-contact .btn--gold:hover { filter:brightness(1.03); }
.zv-contact .cn-side { display:flex; flex-direction:column; gap:16px; }
.zv-contact .cn-opt { display:flex; gap:15px; align-items:flex-start; background:var(--paper); border:1px solid var(--line); border-radius:16px; padding:20px; box-shadow:0 16px 40px -38px rgba(26,18,48,.5); }
.zv-contact .cn-opt .ic { flex:none; width:46px; height:46px; border-radius:13px; background:var(--indigo-soft); color:var(--indigo); display:grid; place-items:center; }
.zv-contact .cn-opt .ic svg { width:24px; height:24px; }
.zv-contact .cn-opt h3 { font-size:16px; font-weight:900; color:var(--indigo); }
.zv-contact .cn-opt p { font-size:14px; font-weight:500; color:#5b5374; margin-top:5px; line-height:1.5; }
.zv-contact .cn-opt a.big { display:inline-block; font-size:18px; font-weight:900; color:var(--ink); margin-top:6px; text-decoration:none; }
.zv-contact .cn-opt .sub { font-size:12.5px; font-weight:700; color:var(--muted); margin-top:4px; }
.zv-contact .cn-hours { background:var(--indigo-deep); color:#fff; border-radius:16px; padding:22px; }
.zv-contact .cn-hours h3 { font-size:15px; font-weight:900; letter-spacing:.01em; }
.zv-contact .cn-hours ul { list-style:none; margin-top:14px; display:flex; flex-direction:column; gap:9px; }
.zv-contact .cn-hours li { display:flex; justify-content:space-between; font-size:14px; font-weight:600; color:#d8d2ef; border-bottom:1px solid rgba(255,255,255,.12); padding-bottom:9px; }
.zv-contact .cn-hours li b { color:#fff; font-weight:800; }
.zv-contact .cn-hours .now { display:inline-flex; align-items:center; gap:8px; margin-top:14px; font-size:13px; font-weight:800; color:#c9f0d8; }
.zv-contact .cn-hours .now i { width:8px; height:8px; border-radius:50%; background:var(--ok); }
{% endstylesheet %}

{% schema %}
{
  "name": "Contactpagina",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "crumb", "label": "Broodkruimel", "default": "Contact" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact & afspraak" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Persoonlijk advies, wanneer het u uitkomt" },
    { "type": "textarea", "id": "lead", "label": "Lead" }
  ],
  "presets": [{ "name": "Contactpagina" }]
}
{% endschema %}
