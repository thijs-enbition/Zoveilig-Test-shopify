{%- comment -%}
  Story band. 1:1 port of the homepage .story block (image stage + overlapping cream card).
  One-off narrative content, so it uses section settings (not a metaobject): background
  image, eyebrow, heading, text, link text + link. All merchant-editable, nothing hardcoded.
{%- endcomment -%}

<section class="story">
  <div class="wrap">
    {%- if section.settings.image != blank -%}
      {%- assign story_img = section.settings.image | image_url: width: 1600 -%}
    {%- else -%}
      {%- assign story_img = 'ons-verhaal.jpg' | asset_url -%}
    {%- endif -%}
    <div class="story-stage" style="background-image:url('{{ story_img }}');">
      <div class="story-card">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.link_text != blank -%}
          <a class="sc-link" href="{{ section.settings.link | default: '#' }}">
            {{ section.settings.link_text }}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.story { padding: clamp(56px, 6vw, 104px) 0; background: var(--paper); }
/* Focal point 60% 30% keeps the woman and her mother central and every face visible. */
.story-stage { position: relative; display: flex; align-items: center; border-radius: 8px; overflow: visible; min-height: clamp(420px, 46vw, 560px); background-size: cover; background-position: 60% 30%; background-repeat: no-repeat; background-color: #cdbfae; box-shadow: 0 40px 90px -54px rgba(26, 18, 48, 0.6); }
.story-stage::after { content: ""; position: absolute; inset: 0; border-radius: 8px; background: linear-gradient(90deg, rgba(40, 28, 84, 0.34), rgba(40, 28, 84, 0) 52%); pointer-events: none; }
/* Negative left margin overlaps the card onto the image for depth (per design). */
.story-card { position: relative; z-index: 2; background: var(--cream); max-width: 430px; margin: 0 0 0 clamp(-56px, -3.5vw, -20px); padding: clamp(32px, 3.4vw, 48px); border-radius: 6px; box-shadow: 0 40px 80px -40px rgba(26, 18, 48, 0.6); }
.story-card .eyebrow { color: var(--belt); display: block; }
.story-card h2 { font-size: clamp(26px, 3vw, 40px); font-weight: 900; color: var(--indigo); letter-spacing: -0.02em; line-height: 1.04; margin-top: 13px; text-wrap: balance; }
.story-card p { font-size: 16px; font-weight: 500; color: #5b5374; margin-top: 16px; line-height: 1.6; }
.story-card .sc-link { display: inline-flex; align-items: center; gap: 9px; font-size: 15px; font-weight: 800; color: var(--rood); margin-top: 22px; letter-spacing: 0.02em; text-decoration: none; }
.story-card .sc-link svg { width: 18px; height: 18px; transition: transform 0.18s; }
.story-card .sc-link:hover svg { transform: translateX(4px); }
/* On small screens keep the card below the faces (image anchored to the top). */
@media (max-width: 760px) {
  .story-stage { align-items: flex-end; background-position: 50% 22%; }
  .story-card { margin: 0 16px -28px; max-width: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Story",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Achtergrondfoto" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ons verhaal" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Veiligheid is veranderd. Wij ook." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Bijna twintig jaar geleden begonnen we met het beschermen van woningen. Vandaag beschermen we ook de mensen die er wonen." },
    { "type": "text", "id": "link_text", "label": "Linktekst", "default": "Lees ons verhaal" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Story" }]
}
{% endschema %}
