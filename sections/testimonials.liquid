{%- comment -%}
  Trustpilot reviews. 1:1 port of the homepage .reviews block (headcard + slider + foot).
  Content from the testimonial metaobject: review_title, quote, customer_name,
  customer_context, customer_image, rating, featured, active.

  Rendering rules: active only; featured first, then the rest. The Trustpilot summary
  numbers (score, rating word, count) are section settings, not per-testimonial data.
  The slider is a real, keyboard-usable carousel over the rendered cards, not a mock-up.
{%- endcomment -%}

{%- liquid
  assign all = shop.metaobjects.testimonial.values | where: 'active', true
  assign featured = all | where: 'featured', true
  assign rest = all | where: 'featured', false
-%}

{%- if all.size > 0 -%}
  <section class="reviews" id="ervaringen">
    <div class="wrap">
      {%- if section.settings.trustpilot_url != blank -%}<a class="rv-headcard" href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener">{%- else -%}<div class="rv-headcard">{%- endif -%}
        <img class="rv-tp" src="{{ 'trustpilot-logo.png' | asset_url }}" alt="Trustpilot" width="120" height="26">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
        <div class="rv-rating">
          {%- if section.settings.score != blank -%}<span class="rv-num">{{ section.settings.score }}</span>{%- endif -%}
          {%- if section.settings.stars > 0 -%}
            <span class="rv-stars" aria-hidden="true">
              {%- for i in (1..5) -%}<span class="tp-star{% if i > section.settings.stars %} off{% endif %}"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.7 5.9 20.4l1.4-6.8L2.2 9l6.9-.7L12 2z"/></svg></span>{%- endfor -%}
            </span>
          {%- endif -%}
          <span class="rv-meta"><b>{{ section.settings.rating_word | default: 'Uitstekend' }}</b> · {{ section.settings.review_count | default: '650' }} beoordelingen</span>
        </div>
      {%- if section.settings.trustpilot_url != blank -%}</a>{%- else -%}</div>{%- endif -%}

      <div class="rv-slider" data-rv-slider>
        <button class="rv-nav prev" type="button" aria-label="Vorige beoordelingen" data-rv-prev>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="rv-viewport" data-rv-viewport>
          <div class="rv-track" data-rv-track>
            {%- for group in featured -%}{%- render 'zv-testimonial-card', t: group -%}{%- endfor -%}
            {%- for group in rest -%}{%- render 'zv-testimonial-card', t: group -%}{%- endfor -%}
          </div>
        </div>
        <button class="rv-nav next" type="button" aria-label="Volgende beoordelingen" data-rv-next>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="rv-foot">
        <div class="rv-dots" data-rv-dots></div>
        {%- if section.settings.trustpilot_url != blank -%}
          <a class="rv-all" href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener">Bekijk alle beoordelingen<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="reviews"><div class="wrap"><p style="text-align:center;color:#cdc6e8;padding:40px;">Testimonials: geen actieve testimonial entries.</p></div></section>
{%- endif -%}

{% stylesheet %}
.reviews { padding: clamp(46px, 5vw, 84px) 0; color: #fff; overflow: hidden; background: radial-gradient(64% 120% at 95% 0%, rgba(197, 46, 47, 0.42) 0%, rgba(197, 46, 47, 0) 55%), radial-gradient(66% 122% at 3% 102%, rgba(0, 80, 159, 0.6) 0%, rgba(0, 80, 159, 0) 58%), linear-gradient(180deg, #2c3076 0%, #262a64 100%); }
.reviews .rv-headcard { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; text-decoration: none; color: inherit; background: var(--paper); border-radius: 16px; padding: 26px 28px; max-width: 520px; margin: 0 auto 32px; box-shadow: 0 30px 60px -34px rgba(0, 0, 0, 0.6); transition: transform 0.15s; }
.reviews .rv-headcard:hover { transform: translateY(-2px); }
.rv-tp { height: 26px; width: auto; margin-bottom: 8px; }
.reviews .rv-headcard h2 { font-size: clamp(22px, 2.4vw, 30px); font-weight: 900; color: var(--indigo); letter-spacing: -0.015em; }
.reviews .rv-headcard p { font-size: 14px; font-weight: 600; color: var(--muted); }
.rv-rating { display: flex; align-items: center; gap: 11px; margin-top: 14px; flex-wrap: wrap; justify-content: center; }
.rv-num { font-size: 30px; font-weight: 900; color: var(--ink); letter-spacing: -0.01em; }
.rv-stars { display: inline-flex; gap: 3px; }
.tp-star { width: 26px; height: 26px; border-radius: 4px; background: #00b67a; display: grid; place-items: center; }
.tp-star svg { width: 18px; height: 18px; color: #fff; }
.tp-star.off { background: #d8cdb4; }
.rv-meta { font-size: 13px; font-weight: 600; color: var(--muted); }
.rv-meta b { color: var(--ink); font-weight: 800; }

.rv-slider { display: flex; align-items: center; gap: 14px; }
.rv-viewport { overflow: hidden; flex: 1; }
.rv-track { display: flex; gap: 18px; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
.rv-nav { flex: none; width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.22); background: rgba(255, 255, 255, 0.08); color: #fff; cursor: pointer; display: grid; place-items: center; transition: background 0.15s, opacity 0.15s; }
.rv-nav:hover { background: rgba(255, 255, 255, 0.18); }
.rv-nav svg { width: 22px; height: 22px; }
.rv-nav:disabled { opacity: 0.3; cursor: default; }
@media (max-width: 600px) { .rv-nav { display: none; } }

.rv-card { flex: 0 0 calc((100% - 36px) / 3); box-sizing: border-box; background: var(--paper); border-radius: 14px; padding: 22px 22px 18px; display: flex; flex-direction: column; color: var(--ink); box-shadow: 0 24px 46px -34px rgba(0, 0, 0, 0.5); }
@media (max-width: 900px) { .rv-card { flex-basis: calc((100% - 18px) / 2); } }
@media (max-width: 600px) { .rv-card { flex-basis: 100%; } }
.rv-cstars { display: inline-flex; gap: 3px; margin-bottom: 13px; }
.rv-cstars .tp-star { width: 22px; height: 22px; }
.rv-cstars .tp-star svg { width: 15px; height: 15px; }
.rv-card h4 { font-size: 17px; font-weight: 900; color: var(--indigo); letter-spacing: -0.01em; line-height: 1.2; }
.rv-body { font-size: 14px; font-weight: 500; color: #4a4458; margin-top: 8px; line-height: 1.5; flex: 1; }
.rv-by { display: flex; align-items: center; gap: 11px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); }
.rv-ava { width: 38px; height: 38px; border-radius: 50%; background: var(--indigo-soft); color: var(--indigo); font-size: 13px; font-weight: 800; display: grid; place-items: center; flex: none; overflow: hidden; }
.rv-ava img { width: 100%; height: 100%; object-fit: cover; }
.rv-name { font-size: 14px; font-weight: 800; color: var(--ink); line-height: 1.1; }
.rv-date { font-size: 12px; font-weight: 600; color: var(--muted); margin-top: 2px; }
.rv-verif { margin-left: auto; display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; color: var(--ok); white-space: nowrap; }
.rv-verif svg { width: 15px; height: 15px; }

.rv-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 24px; flex-wrap: wrap; }
.rv-dots { display: flex; gap: 8px; }
.rv-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255, 255, 255, 0.28); border: none; cursor: pointer; padding: 0; transition: background 0.15s, width 0.15s; }
.rv-dot.on { background: var(--gold); width: 22px; border-radius: 999px; }
.rv-all { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 800; color: #fff; text-decoration: none; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 999px; padding: 11px 19px; transition: background 0.15s; }
.rv-all:hover { background: rgba(255, 255, 255, 0.2); }
.rv-all svg { width: 16px; height: 16px; }
{% endstylesheet %}

{% javascript %}
/* Trustpilot slider: paged transform carousel with arrows, dots and autoplay. */
document.querySelectorAll('[data-rv-slider]').forEach(function (slider) {
  var viewport = slider.querySelector('[data-rv-viewport]');
  var track = slider.querySelector('[data-rv-track]');
  if (!viewport || !track) return;
  var cards = track.children;
  var count = cards.length;
  var prev = slider.querySelector('[data-rv-prev]');
  var next = slider.querySelector('[data-rv-next]');
  var dotsWrap = slider.parentElement.querySelector('[data-rv-dots]');
  var index = 0, perView = 3, timer = null;

  function calcPV() { var w = viewport.clientWidth; return w < 600 ? 1 : (w < 900 ? 2 : 3); }
  function maxI() { return Math.max(0, count - perView); }
  function cardStep() { var c = cards[0]; return c ? c.getBoundingClientRect().width + 18 : viewport.clientWidth; }
  function buildDots() {
    if (!dotsWrap) return;
    dotsWrap.innerHTML = '';
    for (var i = 0; i <= maxI(); i++) {
      (function (i) {
        var b = document.createElement('button');
        b.className = 'rv-dot' + (i === index ? ' on' : '');
        b.type = 'button';
        b.setAttribute('aria-label', 'Beoordeling ' + (i + 1));
        b.addEventListener('click', function () { index = i; update(); });
        dotsWrap.appendChild(b);
      })(i);
    }
  }
  function update() {
    index = Math.min(Math.max(0, index), maxI());
    track.style.transform = 'translateX(-' + (index * cardStep()) + 'px)';
    if (prev) prev.disabled = index <= 0;
    if (next) next.disabled = index >= maxI();
    if (dotsWrap) { [].forEach.call(dotsWrap.children, function (d, i) { d.classList.toggle('on', i === index); }); }
  }
  function resize() { var pv = calcPV(); if (pv !== perView) { perView = pv; buildDots(); } update(); }

  if (prev) prev.addEventListener('click', function () { index--; update(); });
  if (next) next.addEventListener('click', function () { index++; update(); });
  window.addEventListener('resize', resize);
  perView = calcPV(); buildDots(); update();

  function tick() { index = index >= maxI() ? 0 : index + 1; update(); }
  function start() { if (!timer && maxI() > 0) timer = setInterval(tick, 5000); }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  slider.addEventListener('mouseenter', stop);
  slider.addEventListener('mouseleave', start);
  slider.addEventListener('focusin', stop);
  start();
});
{% endjavascript %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Wat onze klanten zeggen" },
    { "type": "text", "id": "subtext", "label": "Subtekst", "default": "Echte beoordelingen van Zo Veilig-klanten op Trustpilot" },
    { "type": "text", "id": "score", "label": "Score", "default": "4,7" },
    { "type": "range", "id": "stars", "label": "Sterren", "min": 0, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "rating_word", "label": "Waardering", "default": "Uitstekend" },
    { "type": "text", "id": "review_count", "label": "Aantal beoordelingen", "default": "650" },
    { "type": "url", "id": "trustpilot_url", "label": "Trustpilot-link" }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
