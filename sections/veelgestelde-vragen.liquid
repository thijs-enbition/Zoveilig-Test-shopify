{%- comment -%}
  Zo Veilig — Veelgestelde vragen (FAQ hub). 1:1 port of the design pack
  "Zo Veilig Veelgestelde Vragen.html": hero + zoek, category pills, 5 grouped
  accordions, empty state, contact CTA. Header + footer come from the theme.
  Category filter + search + accessible accordion are progressive-enhancement JS.
{%- endcomment -%}

{%- liquid
  assign r_keuze = '/#keuzehulp'
-%}

<div class="zv-faqhub">
  <!-- HERO -->
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="d"></span>{{ section.settings.eyebrow | default: 'Veelgestelde vragen' | escape }}</span>
      <h1>{{ section.settings.heading | default: 'Antwoord op de vragen die we het vaakst horen' | escape }}</h1>
      <div class="searchbar" role="search">
        <input id="fqq" type="search" placeholder="{{ section.settings.search_placeholder | default: 'Zoek in de veelgestelde vragen' | escape }}" aria-label="Zoek in veelgestelde vragen" autocomplete="off">
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="fq">
    <div class="wrap">
      <div class="fq-cats" role="group" aria-label="Filter op onderwerp">
        <button type="button" class="fq-cat on" data-cat="all" aria-pressed="true">Alle vragen</button>
        <button type="button" class="fq-cat" data-cat="alg" aria-pressed="false">Algemeen</button>
        <button type="button" class="fq-cat" data-cat="lt" aria-pressed="false">Langer Thuis</button>
        <button type="button" class="fq-cat" data-cat="best" aria-pressed="false">Bestellen &amp; betalen</button>
        <button type="button" class="fq-cat" data-cat="inst" aria-pressed="false">Installatie &amp; service</button>
        <button type="button" class="fq-cat" data-cat="priv" aria-pressed="false">Meldkamer &amp; privacy</button>
      </div>

      {%- comment -%} Groups {%- endcomment -%}
      <div class="fq-group" data-cat="alg">
        <h2><span class="ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M9.5 10a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.7M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>Algemeen</h2>
        {%- assign a1 = 'fqa-alg-1' -%}
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="{{ a1 }}">Wat doet Zo Veilig precies?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="{{ a1 }}" role="region"><div class="fq-a-in">Zo Veilig combineert 20 jaar ervaring in woningbeveiliging met slimme zorgtechnologie. We helpen mensen langer veilig zelfstandig thuis wonen (Langer Thuis), beveiligen woningen tegen inbraak en brand (Mijn Thuis) en bieden persoonlijke alarmering onderweg (Veilig Onderweg).</div></div></div>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-alg-2">Voor wie is Zo Veilig bedoeld?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-alg-2" role="region"><div class="fq-a-in">Voor iedereen die met een gerust hart thuis of onderweg wil zijn: van mantelzorgers die een oogje in het zeil willen houden bij een ouder, tot gezinnen die hun woning willen beveiligen. Doe de <a href="{{ r_keuze }}">Keuzehulp</a> om te zien wat bij uw situatie past.</div></div></div>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-alg-3">Zit ik ergens aan vast?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-alg-3" role="region"><div class="fq-a-in">Abonnementen kennen een looptijd die bij het pakket staat vermeld. Daarna kunt u maandelijks opzeggen. U heeft bovendien 14 dagen bedenktijd, zie het <a href="{% render 'zv-route', key: 'herroepingsrecht' %}">herroepingsrecht</a>.</div></div></div>
      </div>

      <div class="fq-group" data-cat="lt">
        <h2><span class="ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10l8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>Langer Thuis</h2>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-lt-1">Kijkt Zo Veilig met camera's mee bij Langer Thuis?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-lt-1" role="region"><div class="fq-a-in">Nee. Langer Thuis werkt met discrete sensoren, geen camera of microfoon. De sensoren herkennen patronen in dagelijkse routines en geven alleen een melding wanneer daar aanleiding voor is.</div></div></div>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-lt-2">Wat merkt mijn dierbare ervan?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-lt-2" role="region"><div class="fq-a-in">Zo min mogelijk. De sensoren zijn klein en onopvallend. Uw dierbare hoeft niets te bedienen en kan gewoon zelfstandig blijven wonen. U en andere mantelzorgers zien de meldingen in de app.</div></div></div>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-lt-3">Wanneer krijg ik een melding?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-lt-3" role="region"><div class="fq-a-in">Alleen bij een afwijking van het normale patroon, bijvoorbeeld als er 's ochtends geen beweging is terwijl dat wel gebruikelijk is. Zo hoeft u niet steeds zelf te controleren.</div></div></div>
      </div>

      <div class="fq-group" data-cat="best">
        <h2><span class="ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 10h18" stroke="currentColor" stroke-width="2"/></svg></span>Bestellen &amp; betalen</h2>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-best-1">Hoe reken ik af?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-best-1" role="region"><div class="fq-a-in">U rekent veilig online af via iDEAL. Het maandbedrag van een abonnement wordt daarna via automatische incasso (SEPA) afgeschreven. Eenmalige kosten, zoals installatie, betaalt u bij de eerste betaling.</div></div></div>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-best-2">Wat kost een pakket?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-best-2" role="region"><div class="fq-a-in">Langer Thuis start bij €19,95 per maand (Inzicht), Zeker is €24,95 en Beschermd €39,95. Voor de andere lijnen volgen de prijzen. Bekijk het volledige overzicht op <a href="{% render 'zv-route', key: 'oplossingen' %}">de oplossingen</a>.</div></div></div>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-best-3">Kan ik mijn bestelling annuleren?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-best-3" role="region"><div class="fq-a-in">Ja. U heeft 14 dagen bedenktijd. Hoe u herroept en wat de voorwaarden zijn, leest u op de pagina <a href="{% render 'zv-route', key: 'herroepingsrecht' %}">Herroepingsrecht</a>.</div></div></div>
      </div>

      <div class="fq-group" data-cat="inst">
        <h2><span class="ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 7l3 3-7 7-3-3 7-7z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M14 7l2-2 3 3-2 2" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>Installatie &amp; service</h2>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-inst-1">Installeert u zelf?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-inst-1" role="region"><div class="fq-a-in">Ja. Een monteur installeert en test alles bij u thuis, koppelt de app en legt de werking rustig uit. U hoeft zelf niets te installeren.</div></div></div>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-inst-2">Hoe snel kan ik geholpen worden?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-inst-2" role="region"><div class="fq-a-in">Na uw bestelling nemen we binnen één werkdag contact op voor een installatieafspraak. Installatie vindt doorgaans binnen 5 tot 10 werkdagen plaats.</div></div></div>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-inst-3">Wat als er iets kapot gaat?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-inst-3" role="region"><div class="fq-a-in">Bij een abonnement hoort jaarlijks onderhoud en ondersteuning. Merkt u een storing? Geef het door via de <a href="{% render 'zv-route', key: 'klantenservice' %}">klantenservice</a>, dan lossen we het snel op.</div></div></div>
      </div>

      <div class="fq-group" data-cat="priv">
        <h2><span class="ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v6c0 4-3 6.5-7 9-4-2.5-7-5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>Meldkamer &amp; privacy</h2>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-priv-1">Hoe werkt de meldkamer?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-priv-1" role="region"><div class="fq-a-in">Bij een melding komt het signaal binnen bij onze Nederlandse, gecertificeerde meldkamer (bewaakt door Securitas). Zij beoordelen de situatie en schakelen waar nodig hulp of uw contactpersonen in. Lees meer in het <a href="{% render 'zv-route', key: 'kc/hoe-werkt-een-meldkamer' %}">kenniscentrum</a>.</div></div></div>
        <div class="fq-item"><button class="fq-q" type="button" aria-expanded="false" aria-controls="fqa-priv-2">Wat gebeurt er met mijn gegevens?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span></button><div class="fq-a" id="fqa-priv-2" role="region"><div class="fq-a-in">We gaan zorgvuldig en volgens de AVG met uw gegevens om. We meten patronen, geen beeld of geluid. Alles staat in onze <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">privacyverklaring</a>.</div></div></div>
      </div>

      <div class="fq-empty" id="fqEmpty">Geen vragen gevonden. Probeer een andere zoekterm of neem <a href="{% render 'zv-route', key: 'klantenservice' %}">contact</a> op.</div>

      <div class="fq-cta">
        <h3>Zit uw vraag er niet bij?</h3>
        <p>Onze adviseurs helpen u graag persoonlijk verder, zonder verplichtingen.</p>
        <div class="row">
          <a class="btn btn--gold" href="{% render 'zv-route', key: 'klantenservice' %}#contact">Stel uw vraag</a>
          <a class="btn btn--ghost-light" href="tel:0881221111">Bel 088-122 11 11</a>
        </div>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.zv-faqhub {
  --ink:#1a1230; --indigo:#322469; --indigo-deep:#281c54; --indigo-soft:#efecf7; --paper:#fffdf8;
  --cream:#fdfaf2; --gold:#e4a311; --gold-lt:#f5c84a; --belt:#b67e0a; --line:#e7e0cf; --line-2:#dcd2bd; --muted:#6f6786;
  color:var(--ink); line-height:1.5;
}
.zv-faqhub .wrap { max-width:1000px; margin:0 auto; padding:0 clamp(20px,3.6vw,52px); }
.zv-faqhub .btn { font-weight:800; font-size:15px; border:none; border-radius:999px; padding:14px 24px; line-height:1; display:inline-flex; align-items:center; gap:9px; cursor:pointer; text-decoration:none; transition:transform .15s,box-shadow .15s; }
.zv-faqhub .btn--gold { background:var(--gold); color:var(--ink); box-shadow:0 10px 26px -12px rgba(180,126,10,.85); }
.zv-faqhub .btn--gold:hover { transform:translateY(-2px); }
.zv-faqhub .btn--ghost-light { color:#fff; border:1.5px solid rgba(255,255,255,.4); background:transparent; }
.zv-faqhub a:focus-visible, .zv-faqhub button:focus-visible { outline:2px solid var(--gold-lt); outline-offset:2px; }

/* hero */
.zv-faqhub .page-hero { background:radial-gradient(64% 120% at 92% 0%,rgba(197,46,47,.34) 0%,rgba(197,46,47,0) 55%),radial-gradient(66% 122% at 4% 102%,rgba(0,80,159,.5) 0%,rgba(0,80,159,0) 58%),linear-gradient(180deg,#2c3076 0%,#241c54 100%); color:#fff; padding:clamp(48px,6vw,84px) 0 clamp(40px,5vw,64px); }
.zv-faqhub .page-hero .eyebrow { display:inline-flex; align-items:center; gap:9px; font-size:12px; font-weight:800; letter-spacing:.24em; text-transform:uppercase; color:var(--gold-lt); }
.zv-faqhub .page-hero .eyebrow .d { width:8px; height:8px; border-radius:50%; background:var(--gold); }
.zv-faqhub .page-hero h1 { font-size:clamp(30px,4vw,52px); font-weight:900; letter-spacing:-.02em; line-height:1.03; margin-top:14px; max-width:20ch; text-wrap:balance; }
.zv-faqhub .page-hero .searchbar { display:flex; gap:10px; max-width:560px; margin-top:24px; }
.zv-faqhub .page-hero .searchbar input { flex:1; background:#fff; border:1.5px solid transparent; border-radius:999px; padding:15px 22px; font:inherit; font-size:16px; font-weight:600; color:var(--ink); box-shadow:0 20px 40px -26px rgba(0,0,0,.6); }
.zv-faqhub .page-hero .searchbar input:focus { outline:none; border-color:var(--gold-lt); }

/* faq */
.zv-faqhub .fq { background:var(--cream); padding:clamp(30px,4vw,56px) 0 clamp(50px,6vw,90px); }
.zv-faqhub .fq-cats { display:flex; gap:9px; flex-wrap:wrap; margin-bottom:26px; }
.zv-faqhub .fq-cat { font-size:13.5px; font-weight:800; color:var(--indigo); background:var(--paper); border:1.5px solid var(--line-2); border-radius:999px; padding:10px 17px; cursor:pointer; transition:all .15s; }
.zv-faqhub .fq-cat:hover { border-color:var(--indigo); }
.zv-faqhub .fq-cat.on { background:var(--indigo); color:#fff; border-color:var(--indigo); }
.zv-faqhub .fq-group { margin-bottom:34px; }
.zv-faqhub .fq-group > h2 { font-size:20px; font-weight:900; color:var(--indigo); letter-spacing:-.01em; margin-bottom:14px; display:flex; align-items:center; gap:10px; }
.zv-faqhub .fq-group > h2 .ic { width:32px; height:32px; border-radius:9px; background:var(--indigo-soft); color:var(--indigo); display:grid; place-items:center; flex:none; }
.zv-faqhub .fq-group > h2 .ic svg { width:19px; height:19px; }
.zv-faqhub .fq-item { background:var(--paper); border:1px solid var(--line); border-radius:14px; margin-bottom:10px; overflow:hidden; box-shadow:0 12px 30px -34px rgba(26,18,48,.5); }
.zv-faqhub .fq-q { width:100%; display:flex; align-items:center; justify-content:space-between; gap:16px; text-align:left; background:none; border:none; padding:18px 20px; font-size:16px; font-weight:800; color:var(--indigo); line-height:1.35; cursor:pointer; }
.zv-faqhub .fq-q .pm { flex:none; width:26px; height:26px; border-radius:50%; background:var(--cream); color:var(--indigo); display:grid; place-items:center; transition:transform .2s,background .15s; }
.zv-faqhub .fq-q .pm svg { width:15px; height:15px; }
.zv-faqhub .fq-item.open .fq-q .pm { transform:rotate(45deg); background:var(--gold); }
.zv-faqhub .fq-a { max-height:0; overflow:hidden; transition:max-height .28s ease; }
.zv-faqhub .fq-a-in { padding:0 20px 20px; font-size:15px; font-weight:500; color:#5b5374; line-height:1.6; }
.zv-faqhub .fq-a-in a { font-weight:800; color:var(--indigo); }
.zv-faqhub .fq-empty { display:none; text-align:center; color:var(--muted); font-size:15px; font-weight:600; padding:30px; }
.zv-faqhub .fq-empty a { color:var(--indigo); font-weight:800; }
.zv-faqhub .fq-cta { background:var(--indigo-deep); color:#fff; border-radius:20px; padding:clamp(28px,3.5vw,46px); text-align:center; margin-top:12px; position:relative; overflow:hidden; }
.zv-faqhub .fq-cta::before { content:""; position:absolute; width:420px; height:420px; border-radius:50%; right:-120px; top:-140px; background:radial-gradient(circle,rgba(228,163,17,.22),transparent 62%); }
.zv-faqhub .fq-cta h3 { font-size:clamp(22px,2.4vw,30px); font-weight:900; letter-spacing:-.015em; position:relative; }
.zv-faqhub .fq-cta p { font-size:16px; color:#d8d2ef; margin:12px auto 0; max-width:52ch; line-height:1.55; position:relative; }
.zv-faqhub .fq-cta .row { display:flex; gap:13px; justify-content:center; flex-wrap:wrap; margin-top:24px; position:relative; }
{% endstylesheet %}

{% javascript %}
(function () {
  var scope = document.querySelector('.zv-faqhub');
  if (!scope) return;
  var cats = scope.querySelectorAll('.fq-cat');
  var groups = scope.querySelectorAll('.fq-group');
  var items = scope.querySelectorAll('.fq-item');
  var empty = scope.querySelector('#fqEmpty');
  var input = scope.querySelector('#fqq');

  // Accordion
  items.forEach(function (it) {
    var q = it.querySelector('.fq-q'); var a = it.querySelector('.fq-a');
    if (!q || !a) return;
    q.addEventListener('click', function () {
      var open = it.classList.toggle('open');
      q.setAttribute('aria-expanded', open ? 'true' : 'false');
      a.style.maxHeight = open ? a.scrollHeight + 'px' : '0';
    });
  });

  // Category filter
  cats.forEach(function (btn) {
    btn.addEventListener('click', function () {
      cats.forEach(function (b) { b.classList.remove('on'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('on'); btn.setAttribute('aria-pressed', 'true');
      var cat = btn.getAttribute('data-cat');
      if (input) input.value = '';
      items.forEach(function (it) { it.style.display = ''; });
      var any = false;
      groups.forEach(function (g) {
        var show = cat === 'all' || g.getAttribute('data-cat') === cat;
        g.style.display = show ? '' : 'none';
        if (show) any = true;
      });
      if (empty) empty.style.display = any ? 'none' : 'block';
    });
  });

  // Search across all items
  if (input) input.addEventListener('input', function () {
    var q = input.value.toLowerCase().trim();
    cats.forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-cat') === 'all'); b.setAttribute('aria-pressed', b.getAttribute('data-cat') === 'all' ? 'true' : 'false'); });
    var any = false;
    groups.forEach(function (g) {
      var vis = 0;
      g.querySelectorAll('.fq-item').forEach(function (it) {
        var m = !q || it.innerText.toLowerCase().indexOf(q) > -1;
        it.style.display = m ? '' : 'none'; if (m) vis++;
      });
      g.style.display = vis > 0 ? '' : 'none';
      if (vis > 0) any = true;
    });
    if (empty) empty.style.display = any ? 'none' : 'block';
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Veelgestelde vragen",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Veelgestelde vragen" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Antwoord op de vragen die we het vaakst horen" },
    { "type": "text", "id": "search_placeholder", "label": "Zoek-placeholder", "default": "Zoek in de veelgestelde vragen" }
  ],
  "presets": [{ "name": "Veelgestelde vragen" }]
}
{% endschema %}
