{%- comment -%}
  FAQ section. 1:1 port of the homepage .community block (cq-card grid).
  Content from the faq_item metaobject: internal_name, question, answer, category,
  display_order, active.

  Rendering rules: active only, sorted by display_order. An optional category filter
  lets multiple FAQ sections reuse the same faq_item data (e.g. a "privacy" FAQ block
  and a "kosten" FAQ block drawing from one pool).
{%- endcomment -%}

{%- liquid
  assign items = shop.metaobjects.faq_item.values | where: 'active', true | sort: 'display_order'
  assign filter = section.settings.category | strip
-%}

{%- if items.size > 0 -%}
  <section class="community">
    <div class="wrap">
      <div class="pf-intro">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color:var(--belt);">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>

      <div class="cq-grid">
        {%- assign shown = 0 -%}
        {%- for faq in items -%}
          {%- if filter != blank and faq.category != filter -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <article class="cq-card">
            <span class="cq-topic">
              <span class="cq-no">{{ shown | prepend: '0' | slice: -2, 2 }}</span>
              {{ faq.category }}
            </span>
            <blockquote class="cq-q">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v11H8l-4 4V5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
              {{ faq.question }}
            </blockquote>
            <div class="cq-a">
              <span class="cq-brand">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="#2f8f5b"/><path d="M8.4 12.2l2.3 2.3 4.7-5.1" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Zo Veilig
              </span>
              {{ faq.answer | metafield_tag }}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.close_heading != blank -%}
        <div class="cq-close">
          <h3>{{ section.settings.close_heading }}</h3>
          {%- if section.settings.close_text != blank -%}<p>{{ section.settings.close_text }}</p>{%- endif -%}
          <div class="cq-actions">
            {%- if section.settings.btn1_label != blank -%}
              <a class="btn btn--gold" href="{{ section.settings.btn1_link | default: '#' }}" data-zv-finder>
                {{ section.settings.btn1_label }}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.btn2_label != blank -%}
              <a class="btn btn--ghost" href="{{ section.settings.btn2_link | default: '#' }}">
                {{ section.settings.btn2_label }}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.btn3_label != blank -%}
              <a class="btn btn--ghost" href="{{ section.settings.btn3_link | default: '#' }}">
                {{ section.settings.btn3_label }}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="community"><div class="wrap"><p style="text-align:center;color:var(--muted);padding:40px;">FAQ: geen actieve faq_item entries.</p></div></section>
{%- endif -%}

{% stylesheet %}
.community { padding: clamp(56px, 6vw, 100px) 0; background: var(--band); }
.community .pf-intro { text-align: center; max-width: 760px; margin: 0 auto clamp(40px, 4vw, 60px); }
.community .pf-intro .eyebrow { display: block; color: var(--belt); }
.community .pf-intro h2 { font-size: clamp(28px, 3.4vw, 44px); font-weight: 900; color: var(--indigo); letter-spacing: -0.02em; line-height: 1.05; margin-top: 14px; text-wrap: balance; }
.cq-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.cq-card { display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 24px 22px; box-shadow: 0 12px 30px -20px rgba(26, 18, 48, 0.4), 0 2px 5px -3px rgba(26, 18, 48, 0.1); transition: transform 0.18s, box-shadow 0.18s; }
.cq-card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -34px rgba(26, 18, 48, 0.5); }
.cq-topic { display: flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--belt); }
.cq-topic .cq-no { color: var(--gold); font-variant-numeric: tabular-nums; }
.cq-q { position: relative; margin-top: 14px; background: var(--indigo-soft); color: var(--indigo); border-radius: 12px; padding: 14px 16px 14px 46px; font-size: 15px; font-weight: 600; line-height: 1.5; border: none; }
.cq-q svg { position: absolute; left: 15px; top: 16px; width: 21px; height: 21px; color: var(--indigo-2); opacity: 0.75; }
.cq-a { margin-top: 16px; }
.cq-brand { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 900; color: var(--indigo); letter-spacing: 0.01em; }
.cq-brand svg { width: 16px; height: 16px; flex: none; }
.cq-a p { font-size: 14.5px; font-weight: 500; color: #5b5374; margin-top: 8px; line-height: 1.55; }
@media (max-width: 900px) { .cq-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 620px) { .cq-grid { grid-template-columns: 1fr; max-width: 460px; margin-left: auto; margin-right: auto; } }
.cq-close { margin: clamp(36px, 4vw, 52px) auto 0; max-width: 820px; background: var(--paper); border: 1px solid var(--line); border-radius: 16px; padding: clamp(28px, 3vw, 44px); text-align: center; box-shadow: 0 20px 44px -30px rgba(26, 18, 48, 0.4); }
.cq-close h3 { font-size: clamp(22px, 2.4vw, 30px); font-weight: 900; color: var(--indigo); letter-spacing: -0.015em; text-wrap: balance; }
.cq-close p { font-size: 16px; font-weight: 500; color: var(--muted); margin: 14px auto 0; line-height: 1.6; max-width: 60ch; }
.cq-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; align-items: center; margin-top: 26px; }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Uit de praktijk" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Vragen die we vaak horen" },
    { "type": "text", "id": "category", "label": "Categorie-filter (optioneel)", "info": "Laat leeg om alle vragen te tonen. Vul een categorie in om te filteren." },
    { "type": "header", "content": "Afsluitkaart" },
    { "type": "text", "id": "close_heading", "label": "Kop", "default": "Niet zeker welke ondersteuning past?" },
    { "type": "textarea", "id": "close_text", "label": "Tekst", "default": "Elke familie is anders. Beantwoord een paar eenvoudige vragen en ontdek welke ondersteuning logisch is voor uw situatie." },
    { "type": "text", "id": "btn1_label", "label": "Knop 1", "default": "Start de Keuzehulp" },
    { "type": "url", "id": "btn1_link", "label": "Knop 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Knop 2", "default": "Bezoek het kenniscentrum" },
    { "type": "url", "id": "btn2_link", "label": "Knop 2 link" },
    { "type": "text", "id": "btn3_label", "label": "Knop 3", "default": "Waar kunnen we u mee helpen?" },
    { "type": "url", "id": "btn3_link", "label": "Knop 3 link" }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
