{%- comment -%}
  Zo Veilig — Winkelwagen. Visual 1:1 port of the design pack cart, wired to
  the live Shopify {{ cart }}: real line items, quantities (/cart/change),
  and checkout.

  "Vandaag te betalen" = the FULL live cart total (every line, minus cart-level
  discounts) — i.e. exactly what Shopify will actually charge at checkout, full
  stop. It is never reduced by excluding subscription line items: Shopify always
  charges the complete cart regardless of how a line is categorised in the
  theme, so a total that hid part of the cart would show a smaller number than
  the customer is actually charged (confirmed live 2026-09-09: a cart holding
  one Langer Thuis Zeker line + the activation-fee line charges the sum of
  both, not the activation fee alone).

  Subscription detection: a line is a subscription if its product's `type`
  equals section setting `sub_type` (default "Beveiligingsabonnement" — the
  real product_type shared by every live package across Langer Thuis, Mijn
  Thuis and Veilig Onderweg, confirmed from actual store data), OR if it
  carries the `sub_tag` tag (default "abonnement", kept for forward
  compatibility — no live product currently uses this tag; tags differ per
  line, e.g. Langer Thuis carries "Langer Thuis" + "keuzehulp", Mijn Thuis
  carries "Mijn Thuis" + "keuzehulp", so a tag alone can't identify a
  subscription across all lines the way `type` reliably does). This
  classification drives the "p/m" badge and the "Maandbedrag" line — it no
  longer subtracts anything from "Vandaag te betalen". Header/footer come
  from the theme layout.

  The "p/m" price and "Maandbedrag" total are NOT read from `item.final_line_price` —
  they come from the confirmed per-package monthly rate in the central pricing model
  (via zv-pricing + snippets/zv-package-monthly-cents), scaled by `item.quantity`. This is
  deliberate, not a stray literal: once the interim intro-promo mechanism is live, the
  package product's live Shopify price represents a discounted multi-month bundle (charged
  in full today), not one month — see zv-checkout-overview.liquid's header comment for the
  full rationale and the known gap this leaves (no live signal left to catch the confirmed
  monthly rate drifting from whatever Odoo actually bills). A line whose finder_key can't be
  resolved falls back to its own live price (degraded, same convention as an unrecognized
  package elsewhere in the theme). "Vandaag te betalen" is untouched by any of this — it
  stays 100% live, per the paragraph above.

  Renders zv-cart-guard: if a subscription package ever ends up in the cart
  without the activation fee (e.g. added via the standalone Shopify product
  page, which doesn't wire the fee in), it's added automatically and the
  page reloads. See snippets/zv-cart-guard.liquid.
{%- endcomment -%}

{%- include 'zv-pricing' -%}
{%- assign sub_type = section.settings.sub_type | default: 'Beveiligingsabonnement' -%}
{%- assign sub_tag = section.settings.sub_tag | default: 'abonnement' -%}
{%- assign activation_variant_id = all_products[zv_activation_handle].selected_or_first_available_variant.id -%}
{%- render 'zv-cart-guard', activation_variant_id: activation_variant_id, sub_type: sub_type -%}
<div class="zv-cart">
  <section class="cartbar">
    <div class="wrap">
      <h1>Winkelwagen</h1>
      <span class="cnt">{{ cart.item_count }} {% if cart.item_count == 1 %}artikel{% else %}artikelen{% endif %}</span>
      <a class="cont" href="{% render 'zv-route', key: 'oplossingen' %}"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Verder winkelen</a>
    </div>
  </section>

  <section class="cwrap">
    <div class="wrap">
      {%- if cart.item_count > 0 -%}
        <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="clayout">
          <div class="citems">
            {%- for item in cart.items -%}
              {%- assign is_sub = false -%}
              {%- if item.product.type == sub_type or item.product.tags contains sub_tag -%}{%- assign is_sub = true -%}{%- endif -%}
              {%- if is_sub -%}
                {%- assign item_fk = item.product.metafields.custom.finder_key.value -%}
                {%- capture li_monthly_cents_raw -%}{%- render 'zv-package-monthly-cents', finder_key: item_fk, inzicht: zv_inzicht_monthly_cents, zeker: zv_zeker_monthly_cents, beschermd: zv_beschermd_monthly_cents, alert: zv_alert_monthly_cents, protect: zv_protect_monthly_cents -%}{%- endcapture -%}
                {%- assign li_monthly_cents = li_monthly_cents_raw | strip | plus: 0 -%}
                {%- if li_monthly_cents > 0 -%}
                  {%- assign li_month_total_cents = li_monthly_cents | times: item.quantity -%}
                {%- else -%}
                  {%- assign li_month_total_cents = item.final_line_price -%}
                {%- endif -%}
              {%- endif -%}
              <div class="citem">
                <div class="ci-thumb">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 176 }}" alt="{{ item.product.title | escape }}" width="88" height="88" loading="lazy">
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 8l9-4 9 4-9 4-9-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M3 8v8l9 4 9-4V8M12 12v8" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                  {%- endif -%}
                </div>
                <div>
                  {%- if item.product.type != blank -%}<span class="ci-line">{{ item.product.type | escape }}</span>{%- endif -%}
                  <div class="ci-name"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></div>
                  {%- unless item.variant.title contains 'Default' -%}<div class="ci-meta">{{ item.variant.title | escape }}</div>{%- endunless -%}
                  {%- if item.selling_plan_allocation -%}<div class="ci-meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</div>{%- endif -%}
                  {%- if item.properties.size > 0 -%}
                    <div class="ci-tags">
                      {%- for p in item.properties -%}{%- unless p.last == blank or p.first contains '_' -%}<span class="ci-tag">{{ p.first | escape }}: {{ p.last | escape }}</span>{%- endunless -%}{%- endfor -%}
                    </div>
                  {%- endif -%}
                  <div class="ci-actions">
                    <div class="qty">
                      <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | minus: 1 }}" aria-label="Aantal verlagen" class="qbtn">−</a>
                      <span>{{ item.quantity }}</span>
                      <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | plus: 1 }}" aria-label="Aantal verhogen" class="qbtn">+</a>
                    </div>
                    <a class="ci-remove" href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Verwijderen</a>
                  </div>
                </div>
                <div class="ci-right">
                  {%- if is_sub -%}
                    <div class="ci-price" style="color:var(--indigo)">{{ li_month_total_cents | money }} <span>p/m</span></div>
                    <span class="ci-badge">Abonnement</span>
                    <span class="ci-note">Inbegrepen bij vandaag te betalen.<br>Loopt daarna door via SEPA-incasso.</span>
                  {%- else -%}
                    <div class="ci-price">{{ item.final_line_price | money }}</div>
                    {%- if item.original_line_price > item.final_line_price -%}<span class="ci-note">Korting toegepast</span>{%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          <aside class="csummary">
            <h2>Overzicht</h2>
            {%- assign today_cents = 0 -%}
            {%- assign true_month_cents = 0 -%}
            {%- for item in cart.items -%}
              {%- assign li_sub = false -%}
              {%- if item.product.type == sub_type or item.product.tags contains sub_tag -%}{%- assign li_sub = true -%}{%- endif -%}
              {%- assign today_cents = today_cents | plus: item.final_line_price -%}
              {%- if li_sub -%}
                {%- assign item_fk = item.product.metafields.custom.finder_key.value -%}
                {%- capture li_monthly_cents_raw -%}{%- render 'zv-package-monthly-cents', finder_key: item_fk, inzicht: zv_inzicht_monthly_cents, zeker: zv_zeker_monthly_cents, beschermd: zv_beschermd_monthly_cents, alert: zv_alert_monthly_cents, protect: zv_protect_monthly_cents -%}{%- endcapture -%}
                {%- assign li_monthly_cents = li_monthly_cents_raw | strip | plus: 0 -%}
                {%- if li_monthly_cents > 0 -%}
                  {%- assign li_month_total_cents = li_monthly_cents | times: item.quantity -%}
                {%- else -%}
                  {%- assign li_month_total_cents = item.final_line_price -%}
                {%- endif -%}
                {%- assign true_month_cents = true_month_cents | plus: li_month_total_cents -%}
                <div class="srow"><span>{{ item.product.title | escape }}<br><span class="s-sub">Maandelijks · via SEPA-incasso</span></span><b>{{ li_month_total_cents | money }}<span style="font-size:12px;color:var(--muted)"> p/m</span></b></div>
              {%- else -%}
                <div class="srow"><span>{{ item.product.title | escape }}</span><b>{{ item.final_line_price | money }}</b></div>
              {%- endif -%}
            {%- endfor -%}
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for d in cart.cart_level_discount_applications -%}
                {%- assign today_cents = today_cents | minus: d.total_allocated_amount -%}
                <div class="srow"><span>Korting · {{ d.title | escape }}</span><b>−{{ d.total_allocated_amount | money }}</b></div>
              {%- endfor -%}
            {%- endif -%}
            <div class="srow total"><span>Vandaag te betalen</span><b>{{ today_cents | money }}</b></div>
            {%- if true_month_cents > 0 -%}
              <div class="s-sub">U betaalt vandaag {{ today_cents | money }}. Daarna {{ true_month_cents | money }} per maand via SEPA-incasso. Prijzen incl. btw.</div>
            {%- else -%}
              <div class="s-sub">Verzend- en eventuele installatiekosten worden bij het afrekenen berekend. Prijzen incl. btw.</div>
            {%- endif -%}
            <a href="{{ routes.cart_url }}?view=overzicht" class="btn btn--gold cta-checkout">Naar afrekenen <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <div class="c-guarantee">
              <div><i><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 14l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></i>Nederlandse meldkamer, 24/7 bewaakt</div>
              <div><i><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12l5 5 11-11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></i>14 dagen bedenktijd (herroepingsrecht)</div>
              <div><i><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2"/></svg></i>Veilig betalen via iDEAL &amp; SEPA</div>
            </div>
            <div class="pay-row"><span>Betaalmethoden</span><span class="pay-chip">iDEAL</span><span class="pay-chip">SEPA</span><span class="pay-chip">Creditcard</span></div>
          </aside>
        </form>
      {%- else -%}
        <div class="cempty">
          <div class="ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 4h3l2.2 12.2a2 2 0 0 0 2 1.6h7.1a2 2 0 0 0 2-1.55L22 8H6.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="21" r="1.6" fill="currentColor"/><circle cx="19" cy="21" r="1.6" fill="currentColor"/></svg></div>
          <h2>Uw winkelwagen is leeg</h2>
          <p>Nog niets gekozen? Doe de Keuzehulp, dan vinden we samen de oplossing die bij uw situatie past.</p>
          <div class="ce-cta"><a class="btn btn--gold" href="{% render 'zv-route', key: 'keuzehulp' %}">Vind uw oplossing <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a><a class="btn btn--ghost" href="{% render 'zv-route', key: 'oplossingen' %}">Bekijk oplossingen</a></div>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% stylesheet %}
.zv-cart {
  --ink:#1a1230; --indigo:#322469; --indigo-soft:#ece8fb; --paper:#fffdf8; --cream:#fdfaf2;
  --gold:#e4a311; --gold-lt:#f5c84a; --belt:#b67e0a; --line:#e7e0cf; --line-2:#ddd4c0;
  --muted:#6f6786; --muted-2:#8c84a6; --rood:#e24b4a;
  color:var(--ink); line-height:1.5; background:linear-gradient(180deg,#fbf5e9,#f4ecda);
}
.zv-cart .wrap { max-width:1180px; margin:0 auto; padding:0 clamp(20px,3.6vw,52px); }
.zv-cart .cartbar { background:var(--paper); border-bottom:1px solid var(--line); }
.zv-cart .cartbar .wrap { display:flex; align-items:baseline; gap:14px; padding:22px 0; flex-wrap:wrap; }
.zv-cart .cartbar h1 { font-size:clamp(26px,3vw,36px); font-weight:900; color:var(--indigo); letter-spacing:-.02em; }
.zv-cart .cartbar .cnt { font-size:14px; font-weight:700; color:var(--muted); }
.zv-cart .cartbar .cont { margin-left:auto; display:inline-flex; align-items:center; gap:8px; font-size:14.5px; font-weight:800; color:var(--indigo); text-decoration:none; }
.zv-cart .cartbar .cont svg { width:16px; height:16px; transform:rotate(180deg); }
.zv-cart .cwrap { padding:clamp(24px,3vw,40px) 0 90px; }
.zv-cart .clayout { display:grid; grid-template-columns:1.15fr .85fr; gap:26px; align-items:start; }
@media(max-width:920px){ .zv-cart .clayout { grid-template-columns:1fr; } }
.zv-cart .citems { background:var(--paper); border:1px solid var(--line); border-radius:20px; overflow:hidden; box-shadow:0 22px 52px -44px rgba(26,18,48,.5); }
.zv-cart .citem { display:grid; grid-template-columns:88px 1fr auto; gap:18px; padding:22px; border-bottom:1px solid var(--line); align-items:start; }
.zv-cart .citem:last-child { border-bottom:none; }
.zv-cart .ci-thumb { width:88px; height:88px; border-radius:14px; background:var(--indigo-soft); color:var(--indigo); display:grid; place-items:center; overflow:hidden; }
.zv-cart .ci-thumb svg { width:44px; height:44px; }
.zv-cart .ci-thumb img { width:100%; height:100%; object-fit:cover; }
.zv-cart .ci-line { font-size:11.5px; font-weight:800; letter-spacing:.13em; text-transform:uppercase; color:var(--belt); }
.zv-cart .ci-name { font-size:18px; font-weight:900; color:var(--indigo); margin-top:3px; letter-spacing:-.01em; }
.zv-cart .ci-name a { color:inherit; text-decoration:none; }
.zv-cart .ci-meta { font-size:13.5px; font-weight:600; color:var(--muted); margin-top:6px; line-height:1.5; }
.zv-cart .ci-tags { display:flex; gap:8px; flex-wrap:wrap; margin-top:11px; }
.zv-cart .ci-tag { font-size:11.5px; font-weight:700; color:var(--indigo); background:var(--indigo-soft); border-radius:999px; padding:4px 11px; }
.zv-cart .ci-actions { display:flex; align-items:center; gap:16px; margin-top:14px; flex-wrap:wrap; }
.zv-cart .qty { display:inline-flex; align-items:center; border:1.5px solid var(--line-2); border-radius:999px; overflow:hidden; }
.zv-cart .qty .qbtn { width:34px; height:34px; background:var(--cream); border:none; color:var(--indigo); font-size:18px; font-weight:800; line-height:34px; text-align:center; text-decoration:none; }
.zv-cart .qty .qbtn:hover { background:var(--indigo-soft); }
.zv-cart .qty span { min-width:34px; text-align:center; font-size:15px; font-weight:800; color:var(--ink); }
.zv-cart .ci-remove { background:none; border:none; color:var(--muted); font-size:13px; font-weight:700; display:inline-flex; align-items:center; gap:6px; text-decoration:none; }
.zv-cart .ci-remove:hover { color:var(--rood); }
.zv-cart .ci-remove svg { width:14px; height:14px; }
.zv-cart .ci-right { text-align:right; display:flex; flex-direction:column; align-items:flex-end; gap:12px; }
.zv-cart .ci-price { font-size:19px; font-weight:900; color:var(--ink); white-space:nowrap; }
.zv-cart .ci-price span { font-size:12.5px; font-weight:700; color:var(--muted); }
.zv-cart .ci-note { font-size:12px; font-weight:700; color:var(--muted); text-align:right; line-height:1.4; max-width:160px; }
.zv-cart .ci-badge { display:inline-block; font-size:10.5px; font-weight:900; letter-spacing:.05em; text-transform:uppercase; color:var(--indigo); background:var(--indigo-soft); border-radius:6px; padding:3px 8px; }
.zv-cart .csummary { position:sticky; top:96px; background:var(--paper); border:1px solid var(--line); border-radius:20px; padding:24px; box-shadow:0 22px 52px -44px rgba(26,18,48,.5); }
.zv-cart .csummary h2 { font-size:18px; font-weight:900; color:var(--indigo); }
.zv-cart .srow { display:flex; justify-content:space-between; gap:12px; font-size:14.5px; font-weight:600; color:#5b5374; padding:11px 0; border-bottom:1px solid var(--line); }
.zv-cart .srow b { font-weight:800; color:var(--ink); }
.zv-cart .srow.total { font-size:17px; color:var(--ink); border-bottom:none; padding-top:15px; }
.zv-cart .srow.total b { font-size:22px; color:var(--indigo); }
.zv-cart .s-sub { font-size:12.5px; font-weight:600; color:var(--muted); margin:2px 0 16px; line-height:1.5; }
.zv-cart .btn { display:inline-flex; align-items:center; gap:9px; border:none; cursor:pointer; border-radius:12px; font:inherit; font-weight:800; text-decoration:none; padding:14px 24px; }
.zv-cart .btn svg { width:18px; height:18px; }
.zv-cart .btn--gold { background:linear-gradient(180deg,var(--gold-lt),var(--gold)); color:#3a2a06; box-shadow:0 14px 30px -18px rgba(228,163,17,.9); }
.zv-cart .btn--ghost { background:transparent; color:var(--indigo); border:1.5px solid var(--line); }
.zv-cart .cta-checkout { width:100%; justify-content:center; margin-top:4px; }
.zv-cart .c-guarantee { margin-top:18px; display:flex; flex-direction:column; gap:11px; }
.zv-cart .c-guarantee div { display:flex; align-items:center; gap:11px; font-size:13px; font-weight:700; color:#5b5374; }
.zv-cart .c-guarantee i { flex:none; width:26px; height:26px; border-radius:50%; background:var(--indigo-soft); color:var(--indigo); display:grid; place-items:center; }
.zv-cart .c-guarantee i svg { width:15px; height:15px; }
.zv-cart .pay-row { display:flex; gap:8px; align-items:center; margin-top:16px; padding-top:16px; border-top:1px solid var(--line); flex-wrap:wrap; }
.zv-cart .pay-row span { font-size:12px; font-weight:800; color:var(--muted-2); }
.zv-cart .pay-chip { font-size:11px; font-weight:800; color:var(--indigo); background:var(--cream); border:1px solid var(--line); border-radius:7px; padding:5px 9px; }
.zv-cart .cempty { text-align:center; background:var(--paper); border:1px solid var(--line); border-radius:20px; padding:clamp(40px,6vw,72px) 24px; box-shadow:0 22px 52px -44px rgba(26,18,48,.5); }
.zv-cart .cempty .ic { width:84px; height:84px; border-radius:50%; background:var(--indigo-soft); color:var(--indigo); display:grid; place-items:center; margin:0 auto 22px; }
.zv-cart .cempty .ic svg { width:42px; height:42px; }
.zv-cart .cempty h2 { font-size:26px; font-weight:900; color:var(--indigo); letter-spacing:-.02em; }
.zv-cart .cempty p { font-size:16px; font-weight:500; color:#5b5374; margin:12px auto 0; max-width:44ch; line-height:1.55; }
.zv-cart .cempty .ce-cta { display:flex; gap:13px; justify-content:center; flex-wrap:wrap; margin-top:28px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Winkelwagen",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "sub_type", "label": "Abonnement-producttype", "default": "Beveiligingsabonnement", "info": "Producten met dit type (Shopify 'Type' veld) tonen als maandbedrag via SEPA-incasso en tellen niet mee in 'Vandaag te betalen'." },
    { "type": "text", "id": "sub_tag", "label": "Abonnement-producttag (fallback)", "default": "abonnement", "info": "Alternatief: producten met deze tag tellen ook als abonnement. Geen huidig pakket gebruikt deze tag; het producttype hierboven is de betrouwbare indicator." }
  ]
}
{% endschema %}
