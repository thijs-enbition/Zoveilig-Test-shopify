      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (cart) { cartWriting = false; updateCartCount(cart); renderCart(cart, true); })
      .catch(function () { cartWriting = false; if (revert) revert(); showCartError(); });
  }

  function cartRowHtml(it) {
    var p = it.properties || {};
    // Full label = "Oplossing · Pakket" (e.g. "Langer Thuis · Zeker"), from the line's own properties.
    var full = (p['Oplossing'] ? esc(p['Oplossing']) + ' · ' : '') + esc(p['Pakket'] || it.product_title || '');
    var sku = p['SKU'] || it.sku || '';
