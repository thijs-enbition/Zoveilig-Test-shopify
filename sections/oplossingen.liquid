    if (window.ZV_LEAD_ENDPOINT) {
      try { window.fetch(window.ZV_LEAD_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=UTF-8' }, body: JSON.stringify(rec), keepalive: true, mode: 'no-cors' }).catch(function () {}); } catch (e) {}
    }
    try { var L = JSON.parse(localStorage.getItem('zv_leads') || '[]'); L.push(rec); localStorage.setItem('zv_leads', JSON.stringify(L)); } catch (e) {}
  }
  function init() {
    document.querySelectorAll('[data-vista]').forEach(function (box) {
      if (box.dataset.bound) return; box.dataset.bound = '1';
      var openBtn = box.querySelector('[data-vista-open]'),
          form = box.querySelector('[data-vista-form]'),
          done = box.querySelector('[data-vista-done]'),
          err = box.querySelector('[data-vista-err]');
      if (openBtn) openBtn.addEventListener('click', function () { openBtn.hidden = true; if (form) form.hidden = false; });
      if (form) form.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = ((form.querySelector('[name=name]') || {}).value || '').trim();
        var phone = ((form.querySelector('[name=phone]') || {}).value || '').trim();
        var time = ((form.querySelector('[name=time]') || {}).value || '').trim();
        var consent = !!(form.querySelector('[name=consent]') || {}).checked;
        if (!name) { err.textContent = 'Vul uw naam in.'; err.hidden = false; return; }
        if (!phone) { err.textContent = 'Vul uw telefoonnummer in.'; err.hidden = false; return; }
        if (!consent) { err.textContent = 'Bevestig dat wij u mogen terugbellen.'; err.hidden = false; return; }
        err.hidden = true;
        submitLead({
          lead_type: 'vista', name: name, phone: phone, preferred_callback_time: time, consent: consent,
          item_name: box.getAttribute('data-item') || 'Mijn Thuis Vista', item_id: box.getAttribute('data-odoo') || 'MT-VIS',
          monthly_price: box.getAttribute('data-price') || '', solution_category: 'security', cta_location: 'oplossingen_vista'
        });
        if (form) form.hidden = true; if (done) done.hidden = false;
      });
    });
  }
  if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
})();
