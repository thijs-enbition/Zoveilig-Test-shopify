{% javascript %}
(function () {
  var page = document.querySelector('[data-zv-oplossingen]');
  if (!page) return;

  /* ---------- tab / panel switching + deep-link ---------- */
  var tabs = [].slice.call(page.querySelectorAll('[data-opl-tab]'));
  var panels = {};
  page.querySelectorAll('[data-opl-panel]').forEach(function (p) { panels[p.getAttribute('data-opl-panel')] = p; });

  function fire(name, detail) {
    var ZV = window.ZVMeasurement;
    if (ZV && typeof ZV.track === 'function') { try { ZV.track(name, detail || {}); } catch (e) {} }
  }

  var shownId = null;
  function show(id, push) {
    if (!panels[id]) return;
    var changed = id !== shownId;
    tabs.forEach(function (t) {
      var on = t.getAttribute('data-opl-tab') === id;
      t.classList.toggle('on', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    Object.keys(panels).forEach(function (k) { panels[k].hidden = k !== id; });
    if (push && history.pushState) { try { history.pushState({ opl: id }, '', '#' + id); } catch (e) {} }
    shownId = id;
    if (changed) fire('solution_tab_select', { solution: id });   // no duplicate on repeat activation
  }

  tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.getAttribute('data-opl-tab'), true); }); });

  var hash = (location.hash || '').replace('#', '');
  if (hash && panels[hash]) show(hash, false);
  window.addEventListener('hashchange', function () {
    var h = (location.hash || '').replace('#', '');
    if (panels[h]) show(h, false);
  });

  /* ---------- shared cart helper (Shopify line item properties) ---------- */
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function money(cents) { return '€' + (cents / 100).toFixed(2).replace('.', ','); }
  function euroToCents(s) { var m = /(\d+)(?:[.,](\d{1,2}))?/.exec(s || ''); if (!m) return 0; return parseInt(m[1], 10) * 100 + (m[2] ? parseInt((m[2] + '0').slice(0, 2), 10) : 0); }

  /* live-update a card's shown price from its checked options (woning / abonnementen) */
  function recomputeCardPrice(card) {
    var amtEl = card.querySelector('.pcard__price .amt'); if (!amtEl) return;
    var base = parseInt(card.dataset.priceCents, 10); if (isNaN(base) || base <= 0) return;
    var extra = 0;
    card.querySelectorAll('.pcard__plus-opt input:checked').forEach(function (inp) {
      var pr = inp.closest('.pcard__plus-opt').querySelector('.pcard__plus-pr');
      if (pr && /\+/.test(pr.textContent)) extra += euroToCents(pr.textContent);
    });
    amtEl.textContent = money(base + extra);
    amtEl.classList.add('is-updated');
    if (card._priceT) clearTimeout(card._priceT);
    card._priceT = setTimeout(function () { amtEl.classList.remove('is-updated'); }, 600);
  }

  /* Keep the header cart badge in lock-step with the real Shopify cart.
     The active header is the custom zv-header (<a class="cart"><span class="dot">N</span>),
     which only server-renders the dot when cart.item_count > 0 — so add/remove must
     create it, update it, and remove it at zero. A Dawn .cart-count-bubble is handled too
     as a fallback. The badge can never show a stale non-zero count while /cart is empty. */
  function updateCartCount(cart) {
    var n = (cart && cart.item_count) ? cart.item_count : 0;

    // Custom Zo Veilig header: <a class="cart"> ... <span class="dot">N</span>
    document.querySelectorAll('a.cart').forEach(function (link) {
      var dot = link.querySelector('.dot');
      if (n > 0) {
        if (!dot) { dot = document.createElement('span'); dot.className = 'dot'; link.appendChild(dot); }
        dot.textContent = n;
      } else if (dot && dot.parentNode) {
        dot.parentNode.removeChild(dot);            // empty cart -> no dot (matches the Liquid `if item_count > 0`)
      }
      link.setAttribute('aria-label', 'Winkelwagen, ' + n + ' artikelen');
    });

    // Dawn fallback header: .cart-count-bubble inside #cart-icon-bubble
    var icon = document.getElementById('cart-icon-bubble');
    var bubble = document.querySelector('.cart-count-bubble');
    if (icon || bubble) {
      if (n > 0) {
        if (!bubble && icon) {
          bubble = document.createElement('div');
          bubble.className = 'cart-count-bubble';
          bubble.innerHTML = '<span aria-hidden="true"></span><span class="visually-hidden"></span>';
          icon.appendChild(bubble);
        }
        if (bubble) {
          var vis = bubble.querySelector('span[aria-hidden="true"]');
          if (vis) vis.textContent = (n < 100 ? n : '');
          bubble.hidden = false; bubble.classList.remove('hidden');
        }
      } else if (bubble && bubble.parentNode) {
        bubble.parentNode.removeChild(bubble);
      }
    }

    document.querySelectorAll('[data-cart-count]').forEach(function (el) { el.textContent = n; });
    try { document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart } })); } catch (e) {}
  }

  /* Self-heal on load: fetch the authoritative Shopify cart and reconcile the badge,
     so a stale server-rendered count (e.g. left over from a cart emptied elsewhere) is corrected. */
  window.fetch('/cart.js').then(function (r) { return r.json(); }).then(updateCartCount).catch(function () {});

  function addToCart(variantId, properties, mode, btn) {
    if (!variantId || (btn && btn.dataset.busy === '1')) return;
    var label = '';
    if (btn) { btn.dataset.busy = '1'; btn.disabled = true; btn.setAttribute('aria-busy', 'true'); label = btn.innerHTML; btn.dataset.label = label; }
    var errEl = btn && btn.parentNode && btn.parentNode.querySelector('.pcard__err'); if (errEl) errEl.remove();
    return window.fetch('/cart/add.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: 1, properties: properties || {} }] })
    })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (line) {
        var ZV = window.ZVMeasurement;
        if (ZV && ZV.addToCart) ZV.addToCart({ item_id: (line && line.sku) || (properties && properties['SKU']), item_name: properties && properties['Pakket'], item_brand: 'Zo Veilig', price: (line && line.price) ? line.price / 100 : undefined, quantity: 1 }, { cta_location: (btn && btn.getAttribute('data-cta-position')) || 'oplossingen' });
        if (btn) { btn.dataset.busy = ''; btn.disabled = false; btn.removeAttribute('aria-busy'); btn.innerHTML = btn.dataset.label || label; }
        if (mode === 'checkout') { window.location.href = '/checkout'; return; }
        return window.fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
          updateCartCount(cart);
          openCart(cart);
        });
      })
      .catch(function () {
        fire('add_to_cart_error', { sku: properties && properties['SKU'] });
        if (btn) {
          btn.dataset.busy = ''; btn.disabled = false; btn.removeAttribute('aria-busy'); btn.innerHTML = btn.dataset.label || label;
          if (btn.parentNode && !btn.parentNode.querySelector('.pcard__err')) {
            var e = document.createElement('div'); e.className = 'pcard__err'; e.setAttribute('role', 'alert');
            e.textContent = 'Toevoegen mislukt. Probeer het opnieuw.'; btn.parentNode.appendChild(e);
          }
        }
      });
  }

  /* ---------- add-to-cart confirmation drawer (Shopify /cart.js backed) ---------- */
  var cartEl = document.getElementById('opl-cart');
  // Portal to <body> so position:fixed is viewport-relative (never trapped by a section ancestor).
  if (cartEl && cartEl.parentNode !== document.body) document.body.appendChild(cartEl);
  var cartLastFocus = null, cartKey = null, cartState = null, cartWriting = false;

  var CART_CHECK = '<svg viewBox="0 0 24 24" fill="none"><path d="M4.5 12.5l5 5 10-11" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var CART_ARROW = '<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  function showCartError() {
    var s = cartEl.querySelector('.addcart__scroll'); if (!s) return;
    var e = s.querySelector('.addcart__err');
    if (!e) { e = document.createElement('div'); e.className = 'addcart__err'; e.setAttribute('role', 'alert'); s.appendChild(e); }
    e.textContent = 'Bijwerken mislukt. Probeer het opnieuw.';
  }

