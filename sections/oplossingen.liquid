    if (woning) {
      var key = woning.getAttribute('data-zv-line-woning'), on = woning.checked;
      var line = null, its = (cartState && cartState.items) || [];
      for (var i = 0; i < its.length; i++) { if (its[i].key === key) { line = its[i]; break; } }
      if (!line) { woning.checked = !on; return; }
      var props = {}, lp = line.properties || {};
      for (var k in lp) { if (lp.hasOwnProperty(k)) props[k] = lp[k]; }
      if (on) props['Woning'] = 'Groter dan 100 m²'; else delete props['Woning'];
      woning.disabled = true;
      cartWrite('/cart/change.js', { id: key, properties: props }, function () { woning.checked = !on; woning.disabled = false; });
      return;
    }
    var addon = e.target.closest('[data-zv-addon]');
