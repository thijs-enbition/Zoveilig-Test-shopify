.pbd-deploy li b { color: var(--indigo); }

/* add-to-cart confirmation drawer (addcart- classes; header / scroll / footer regions). */
.addcart { position: fixed; inset: 0; z-index: 10000; }
.addcart[hidden] { display: none; }
/* .addcart .addcart__scrim: 2 classes outranks the base reset `div:empty{display:none}`, which would otherwise hide the empty backdrop. */
.addcart .addcart__scrim { position: fixed; inset: 0; display: block; background: rgba(20, 14, 40, 0.6); animation: acFade 0.2s ease; }
@keyframes acFade { from { opacity: 0; } to { opacity: 1; } }
.addcart__panel { position: fixed; top: 0; right: 0; height: 100vh; height: 100dvh; width: min(820px, 100vw); background: var(--paper); box-shadow: -30px 0 70px -30px rgba(26, 18, 48, 0.5); display: flex; flex-direction: column; animation: acSlide 0.26s cubic-bezier(0.4, 0, 0.2, 1); }
@keyframes acSlide { from { transform: translateX(100%); } to { transform: translateX(0); } }

.addcart__head { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 30px 32px; background: var(--paper); border-bottom: 1px solid var(--line); min-height: 96px; }
.addcart__t { display: flex; align-items: center; gap: 12px; font-size: 17px; font-weight: 900; color: var(--indigo); letter-spacing: -0.01em; }
.addcart__chk { width: 32px; height: 32px; border-radius: 50%; background: var(--ok); display: grid; place-items: center; flex: none; }
.addcart__chk svg { width: 18px; height: 18px; color: #fff; }
.addcart__x { width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); background: #fff; color: var(--muted); display: grid; place-items: center; font-size: 22px; line-height: 1; cursor: pointer; flex: none; transition: border-color 0.15s, color 0.15s; }
.addcart__x:hover { border-color: var(--indigo); color: var(--indigo); }

.addcart__scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; padding: 24px 32px 40px; }
.addcart__count { font-size: 12.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
.addcart__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
.addcart__item { background: #fff; border: 1px solid var(--line); border-radius: 15px; overflow: hidden; }
.addcart__item-head { display: flex; align-items: flex-start; gap: 14px; padding: 17px 18px; }
.addcart__info { flex: 1; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.addcart__name { font-size: 16px; font-weight: 900; color: var(--indigo); line-height: 1.2; }
.addcart__meta { font-size: 12px; font-weight: 700; color: var(--belt); letter-spacing: 0.02em; }
.addcart__pricewrap { display: flex; align-items: flex-start; gap: 10px; flex: none; }
.addcart__price { font-size: 15px; font-weight: 900; color: var(--indigo); white-space: nowrap; }
.addcart__price .per { font-size: 12px; font-weight: 700; color: var(--muted); }
.addcart__rm { width: 26px; height: 26px; border-radius: 7px; border: 1px solid var(--line); background: #fff; color: var(--muted); display: grid; place-items: center; font-size: 16px; line-height: 1; cursor: pointer; flex: none; transition: border-color 0.15s, color 0.15s; }
.addcart__rm:hover { border-color: var(--red); color: var(--red); }
.addcart__opt { display: flex; align-items: center; gap: 11px; padding: 12px 18px; background: var(--sand); border-top: 1px solid var(--line); cursor: pointer; }
.addcart__opt input { width: 18px; height: 18px; accent-color: var(--indigo); flex: none; cursor: pointer; }
.addcart__opt-label { flex: 1; font-size: 13px; font-weight: 800; color: var(--indigo); }
.addcart__opt-price { font-size: 13px; font-weight: 900; color: var(--belt); flex: none; }

.addcart__note { font-size: 13px; font-weight: 600; color: var(--muted); margin-top: 16px; line-height: 1.45; }
.addcart__empty { font-size: 14px; font-weight: 600; color: var(--muted); margin: 20px 0; text-align: center; }
.addcart__err { color: var(--red-deep); font-size: 12.5px; font-weight: 700; margin-top: 8px; }

.addcart__sec-h { font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 26px 0 12px; }
.addcart__addon { display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; background: var(--paper); border: 1px solid var(--line); border-radius: 13px; margin-bottom: 10px; cursor: pointer; transition: border-color 0.15s; }
.addcart__addon:hover { border-color: var(--line-2); }
.addcart__addon input { width: 18px; height: 18px; accent-color: var(--indigo); flex: none; cursor: pointer; margin-top: 1px; }
.addcart__addon-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.addcart__addon-t { display: block; font-size: 14px; font-weight: 800; color: var(--indigo); }
.addcart__addon-d { display: block; font-size: 12.5px; font-weight: 600; color: var(--muted); line-height: 1.4; }
.addcart__addon-price { font-size: 13px; font-weight: 900; color: var(--belt); flex: none; white-space: nowrap; }

.pcard__price .amt { transition: color 0.35s ease; }
.pcard__price .amt.is-updated { color: var(--belt); }

.addcart__foot { flex: 0 0 auto; padding: 18px 32px 22px; background: var(--paper); border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 11px; }
.addcart__cont { font-family: inherit; font-weight: 800; font-size: 15px; color: var(--indigo); background: #fff; border: 2px solid var(--indigo); border-radius: 12px; padding: 14px; cursor: pointer; transition: background 0.15s; }
.addcart__cont:hover { background: var(--indigo-soft); }
.addcart__go { display: inline-flex; align-items: center; justify-content: center; gap: 9px; font-weight: 900; font-size: 15px; color: var(--ink); background: var(--gold); border-radius: 12px; padding: 14px; text-decoration: none; box-shadow: 0 2px 0 var(--belt); transition: transform 0.14s, box-shadow 0.14s; }
.addcart__go svg { width: 17px; height: 17px; }
.addcart__go:hover { transform: translateY(-1px); box-shadow: 0 4px 0 var(--belt), 0 12px 24px -12px rgba(180, 126, 10, 0.7); }
.addcart__x:focus-visible, .addcart__rm:focus-visible, .addcart__cont:focus-visible, .addcart__go:focus-visible, .addcart__opt input:focus-visible, .addcart__addon input:focus-visible { outline: 2px solid var(--indigo); outline-offset: 2px; }
@media (max-width: 860px) { .addcart__panel { width: 100vw; } }
@media (max-width: 560px) { .addcart__head { padding: 22px 20px; min-height: 84px; } .addcart__scroll { padding: 20px 20px 36px; } .addcart__foot { padding: 16px 20px 20px; } }
.pcard__direct[aria-busy="true"], .pb-buy[aria-busy="true"] { opacity: 0.6; cursor: default; }
.pcard__err { color: var(--red-deep); font-size: 12.5px; font-weight: 700; margin-top: 6px; }

@media (prefers-reduced-motion: reduce) { .catnav__t, .vhero__cta a, .pcard, .pcard__direct, .why__link svg { transition: none; } .pb-scrim, .pb-panel, .addcart__scrim, .addcart__panel { animation: none; } }
