{%- comment -%}
  Oplossingen page core: category tabs + package cards + the three CTAs.
  1:1 port of oplossingen/pages.jsx (catnav tabs + .pcard grid). Ported this slice:
  tabs, cards, "Meer informatie" / "In winkelwagen" / "Bel mij terug", compare + finder.

  DATA SOURCE: Shopify Products (per the CMS brief: SKU, price, variants, media come from
  Products, never metaobjects). Each category tab renders a product collection chosen in the
  Theme Editor. Card fields: title, price, first-variant SKU, featured media, and optional
  metafields (custom.platform, custom.hook, custom.features as a list, custom.category2).

  The pricing config supplies only the derived model (activation, 1.5x commitment, contract);
  it does not set the monthly price shown here, which is the product price.

  MEASUREMENT: every CTA carries data-* attributes and calls window.ZVMeasurement.* via
  assets/oplossingen.js. add_to_cart fires ONLY after Shopify confirms the line.

  DEFERRED (next slices): the configurator accordion (package_option_view/select), Lio,
  the abonnementen block, and the full compare page.
{%- endcomment -%}

{%- liquid
  assign cats = section.blocks | where: 'type', 'category'
-%}

<section class="pak" id="paks" data-zv-oplossingen data-currency="EUR">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color:var(--belt);">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 style="font-size:clamp(28px,3.4vw,44px);font-weight:900;color:var(--indigo);letter-spacing:-.02em;margin-top:10px;">{{ section.settings.heading }}</h2>{%- endif -%}

    {%- if cats.size > 0 -%}
      <div class="catnav" role="tablist" aria-label="Oplossingscategorieën" style="display:flex;align-items:center;gap:14px;justify-content:center;flex-wrap:wrap;margin:24px 0 30px;">
        <span class="catnav__lbl">Kies je situatie</span>
        <div class="catnav__tabs">
          {%- for block in cats -%}
            {%- assign cat = block.settings.cat_key -%}
            <button
              class="catnav__t{% if forloop.first %} on{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="cat-{{ cat }}"
              data-cat="{{ cat }}"
              data-cat-name="{{ block.settings.label | escape }}"
              {{ block.shopify_attributes }}
            >
              <b>{{ block.settings.label }}</b>
              <span>{{ block.settings.sublabel }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      {%- for block in cats -%}
        {%- assign cat = block.settings.cat_key -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <div class="pak__panel" id="cat-{{ cat }}" role="tabpanel" data-cat-panel="{{ cat }}"{% unless forloop.first %} hidden{% endunless %}>
          <div class="pak__head">
            <div class="pak__head-row">
              <div>
                {%- if block.settings.panel_heading != blank -%}<h3>{{ block.settings.panel_heading }}</h3>{%- endif -%}
                {%- if block.settings.panel_sub != blank -%}<p class="ph-sub">{{ block.settings.panel_sub }}</p>{%- endif -%}
              </div>
              {%- if section.settings.compare_url != blank -%}
                <a class="compare" href="{{ section.settings.compare_url }}" data-cta-location="oplossingen_{{ cat }}" data-cta-text="Vergelijk" data-zv-compare>
                  Vergelijk
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>

          <div class="pcard-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;max-width:1080px;margin:0 auto;">
            {%- for product in collection.products -%}
              {%- assign v = product.selected_or_first_available_variant -%}
              {%- assign sku = v.sku | default: product.metafields.custom.sku -%}
              {%- assign popular = false -%}
              {%- if product.metafields.custom.popular == true -%}{%- assign popular = true -%}{%- endif -%}
              <article
                class="pcard{% if popular %} pop{% endif %}"
                data-item-id="{{ sku | escape }}"
                data-item-name="{{ product.title | escape }}"
                data-item-brand="Zo Veilig"
                data-item-category="{{ block.settings.label | escape }}"
                data-item-category2="{{ product.metafields.custom.category2 | escape }}"
                data-price="{{ v.price | money_without_currency | strip }}"
                data-quantity="1"
                data-variant-id="{{ v.id }}"
                data-product-url="{{ product.url }}"
              >
                {%- if popular -%}<span class="pcard__flag">Meest gekozen</span>{%- endif -%}
                {%- if product.featured_media -%}
                  <span class="pcard__shot">{{ product.featured_media | image_url: width: 300 | image_tag: alt: product.title, loading: 'lazy' }}</span>
                {%- endif -%}
                {%- if product.metafields.custom.platform != blank -%}<div class="pcard__plat">{{ product.metafields.custom.platform }}</div>{%- endif -%}
                <div class="pcard__name">{{ product.title }}</div>
                {%- if product.metafields.custom.hook != blank -%}<div class="pcard__hook">{{ product.metafields.custom.hook }}</div>{%- endif -%}

                {%- if product.metafields.custom.features != blank -%}
                  <ul class="pcard__feats">
                    {%- for feat in product.metafields.custom.features.value -%}
                      <li><span class="fk"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{ feat }}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <div class="pcard__foot">
                  <div class="pcard__price">
                    <span class="amt">{{ v.price | money }}</span>
                    <span class="per">/mnd</span>
                  </div>
                  {%- if product.metafields.custom.price_sub != blank -%}<div class="pcard__sub">{{ product.metafields.custom.price_sub }}</div>{%- endif -%}
                  {%- if sku != blank -%}<div class="pcard__sku">SKU &middot; {{ sku }}</div>{%- endif -%}

                  <div class="pcard__cta">
                    <a class="btn {% if popular %}btn--gold{% else %}btn--ghost{% endif %}" href="{{ product.url }}" data-cta-text="Meer informatie" data-cta-location="oplossingen_{{ cat }}" data-zv-package-view>Meer informatie</a>
                    <button type="button" class="btn btn--indigo" data-cta-text="In winkelwagen" data-cta-location="oplossingen_{{ cat }}" data-zv-add-to-cart{% unless v.available %} disabled{% endunless %}>In winkelwagen</button>
                    <details class="pcard__plus" data-zv-callback-wrap>
                      <summary data-zv-callback-trigger data-cta-text="Bel mij terug" data-cta-location="oplossingen_{{ cat }}">
                        Bel mij terug
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </summary>
                      {%- render 'zv-callback-form',
                        item_id: sku, item_name: product.title, solution_category: block.settings.label,
                        monthly_price: v.price, cta_location: 'oplossingen_card', endpoint: section.settings.callback_endpoint -%}
                    </details>
                  </div>
                </div>
              </article>
            {%- else -%}
              {%- if request.design_mode -%}<p style="color:var(--muted);">Koppel een collectie aan tab "{{ block.settings.label }}" om pakketten te tonen.</p>{%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      {%- if section.settings.finder_url != blank -%}
        <div style="text-align:center;margin-top:34px;">
          <a class="btn btn--gold" href="{{ section.settings.finder_url }}" data-cta-text="Vind uw oplossing" data-cta-location="oplossingen" data-zv-finder>Vind uw oplossing</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.pak { padding: clamp(40px, 5vw, 72px) 0; background: var(--cream); }
.catnav__lbl { font-size: 11.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
.catnav__tabs { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
.catnav__t { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; border: 1.5px solid var(--line-2); background: #fff; border-radius: 13px; padding: 9px 18px; cursor: pointer; font-family: inherit; text-align: left; transition: border-color 0.15s, background 0.15s, transform 0.15s; }
.catnav__t b { font-size: 15px; font-weight: 800; color: #3a3550; line-height: 1.15; }
.catnav__t span { font-size: 11.5px; font-weight: 600; color: var(--muted-2); }
.catnav__t:hover { border-color: var(--indigo); transform: translateY(-1px); }
.catnav__t:hover b { color: var(--indigo); }
.catnav__t.on { background: var(--indigo); border-color: var(--indigo); }
.catnav__t.on b { color: #fff; }
.catnav__t.on span { color: #cdc6e8; }
.pak__head { max-width: 1080px; margin: 0 auto 26px; }
.pak__head-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.pak__head h3 { font-size: clamp(24px, 2.6vw, 32px); font-weight: 900; color: var(--indigo); letter-spacing: -0.015em; line-height: 1.05; }
.pak__head .ph-sub { font-size: 15px; font-weight: 600; color: var(--muted); margin-top: 10px; line-height: 1.45; }
.pak__head .compare { font-size: 14px; font-weight: 800; color: var(--indigo); text-decoration: none; display: inline-flex; align-items: center; gap: 7px; }
.pak__head .compare svg { width: 16px; height: 16px; }
.pcard { position: relative; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; padding: 26px 24px 24px; display: flex; flex-direction: column; box-shadow: 0 1px 2px rgba(26, 18, 48, 0.04); transition: border-color 0.2s ease, box-shadow 0.2s ease; }
.pcard:hover { border-color: var(--line-2); box-shadow: 0 6px 20px -12px rgba(26, 18, 48, 0.22); }
.pcard.pop { border-color: var(--indigo); box-shadow: 0 6px 20px -12px rgba(50, 36, 105, 0.28); }
.pcard__flag { align-self: flex-start; margin-bottom: 12px; color: var(--belt); font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
.pcard__shot { display: flex; align-items: center; justify-content: center; height: 152px; margin: -4px 0 14px; background: #fff; border: 1px solid var(--line); border-radius: 6px; padding: 16px; }
.pcard__shot img { max-height: 118px; max-width: 86%; width: auto; object-fit: contain; filter: drop-shadow(0 16px 22px rgba(26, 18, 48, 0.16)); }
.pcard__plat { font-size: 11px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-2); }
.pcard__name { font-size: 23px; font-weight: 900; color: var(--indigo); line-height: 1.05; margin-top: 3px; letter-spacing: -0.01em; }
.pcard__hook { font-size: 14.5px; font-weight: 600; color: #5b5374; margin-top: 8px; line-height: 1.4; }
.pcard__feats { list-style: none; margin-top: 16px; display: flex; flex-direction: column; gap: 9px; padding: 0; }
.pcard__feats li { display: flex; align-items: flex-start; gap: 9px; font-size: 13.5px; font-weight: 600; color: #3a3550; line-height: 1.35; }
.pcard__feats li .fk { width: 16px; height: 16px; display: grid; place-items: center; flex: none; margin-top: 2px; color: var(--ok); }
.pcard__feats li .fk svg { width: 14px; height: 14px; }
.pcard__foot { margin-top: auto; padding-top: 20px; }
.pcard__price { display: flex; align-items: baseline; gap: 7px; }
.pcard__price .amt { font-size: 27px; font-weight: 900; color: var(--ink); letter-spacing: -0.01em; }
.pcard__price .per { font-size: 13.5px; font-weight: 700; color: var(--muted); }
.pcard__sub { font-size: 12.5px; font-weight: 600; color: var(--muted-2); margin-top: 3px; }
.pcard__sku { font-family: ui-monospace, Menlo, monospace; font-size: 12px; font-weight: 500; color: var(--muted-2); margin-top: 8px; letter-spacing: 0.02em; }
.pcard__cta { margin-top: 16px; display: flex; flex-direction: column; gap: 8px; }
.pcard__cta .btn { width: 100%; justify-content: center; font-size: 14.5px; padding: 13px 18px; border-radius: 6px; }
.pcard__cta .btn--indigo { border: none; }
.pcard__plus { border: none; border-top: 1px solid var(--line); }
.pcard__plus summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 13.5px; font-weight: 800; color: var(--indigo); padding: 12px 2px; }
.pcard__plus summary::-webkit-details-marker { display: none; }
.pcard__plus summary:hover { color: var(--belt); }
.pcard__plus summary svg { width: 15px; height: 15px; transition: transform 0.2s; }
.pcard__plus[open] summary svg { transform: rotate(180deg); }
.zv-callback { margin-top: 8px; }
.zv-cb-fields { display: flex; flex-direction: column; gap: 10px; }
.zv-cb-field span { display: block; font-size: 12.5px; font-weight: 700; color: var(--muted); margin-bottom: 4px; }
.zv-cb-field input, .zv-cb-field select { width: 100%; padding: 10px 12px; border: 1px solid var(--line-2); border-radius: 8px; font-family: inherit; font-size: 14px; }
.zv-cb-consent { display: flex; align-items: flex-start; gap: 9px; margin: 12px 0; font-size: 12.5px; font-weight: 600; color: #4a4458; line-height: 1.4; }
.zv-cb-consent input { margin-top: 2px; flex: none; }
.zv-cb-submit { width: 100%; justify-content: center; }
.zv-cb-status { margin-top: 10px; font-size: 13px; font-weight: 700; }
.zv-cb-status[data-kind="error"] { color: var(--rood); }
.zv-cb-status[data-kind="success"] { color: var(--ok); }
{% endstylesheet %}

{% schema %}
{
  "name": "Oplossingen",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Onze oplossingen" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Kies de bescherming die bij uw situatie past" },
    { "type": "url", "id": "compare_url", "label": "Vergelijk-link" },
    { "type": "url", "id": "finder_url", "label": "Keuzehulp-link (Vind uw oplossing)" },
    { "type": "url", "id": "callback_endpoint", "label": "Callback-endpoint (Odoo/CRM webhook)", "info": "POST-URL voor 'Bel mij terug' leads. Leeg = knop meldt fout." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        { "type": "text", "id": "cat_key", "label": "Sleutel (living/security/persoonlijk)", "default": "living" },
        { "type": "text", "id": "label", "label": "Label", "default": "Langer Thuis" },
        { "type": "text", "id": "sublabel", "label": "Sublabel", "default": "Zorg & inzicht" },
        { "type": "collection", "id": "collection", "label": "Pakketten-collectie" },
        { "type": "text", "id": "panel_heading", "label": "Paneel-kop" },
        { "type": "textarea", "id": "panel_sub", "label": "Paneel-subtekst" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Oplossingen",
      "blocks": [
        { "type": "category", "settings": { "cat_key": "living", "label": "Langer Thuis", "sublabel": "Zorg & inzicht" } },
        { "type": "category", "settings": { "cat_key": "security", "label": "Mijn Thuis", "sublabel": "Beveiliging" } },
        { "type": "category", "settings": { "cat_key": "persoonlijk", "label": "Veilig Onderweg", "sublabel": "Onderweg" } }
      ]
    }
  ]
}
{% endschema %}
