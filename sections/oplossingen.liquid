      '</div><div class="addcart__pricewrap">' +
        '<span class="addcart__price">' + money(it.price) + '<span class="per">/mnd</span></span>' +
        '<button type="button" class="addcart__rm" data-cart-remove="' + esc(it.key) + '" aria-label="Verwijder ' + esc(pkg) + '">×</button>' +
      '</div></div>' +
      '<label class="addcart__opt"><input type="checkbox" data-zv-line-woning="' + esc(it.key) + '"' + (woningOn ? ' checked' : '') +
        ' aria-label="Woning groter dan 100 m² voor ' + esc(pkg) + '">' +
        '<span class="addcart__opt-label">Woning groter dan 100 m²</span><span class="addcart__opt-price">+€4/mnd</span></label>' +
    '</li>';
  }

  function renderCart(cart, preserveScroll) {
