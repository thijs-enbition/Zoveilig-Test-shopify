{%- comment -%} ZV-BUILD: drawer-fix-db378b0 {%- endcomment -%}
{%- comment -%}
  Oplossingen landing page — 1:1 port of "Zo Veilig Oplossingspaginas.html" (pages.jsx).
  Structure: a category tab switcher (.catnav), and per category a full-width background-photo
  hero (.vhero) + partner strip + package grid of designed tile cards (.pcard.pcard--tile).

  The dark card header + product photo + "IN HET PAKKET" are baked into the designed tile
  image (assets/opl-tile-NN.jpg, one per package). Price + SKU are read from the Shopify
  product; the sub-line + tile mapping come from the finder_key map below (design copy).

  Design CSS is copied VERBATIM from the design file (class names are unique to this page).
  A scoped reset neutralises Dawn's base margins (the design relies on a global *{margin:0}).
  GTM: every CTA exposes data-* hooks (no analytics logic here).

  Includes, per solution: hero + partner strip + package grid, the "Waarom Zo Veilig" cards
  (block settings), and — shared below the active panel — the Stappen and Partners bands.
  "Meer informatie" opens the accessible "breakout" detail modal (data island #opl-modal-data,
  keyed by finder_key; focus-trap, Escape, restore-focus, no bg scroll). Add-to-cart posts to
  /cart/add.js with line item properties (Pakket/SKU/Oplossing/Platform/Bron/Woning). Without
  JS, "Meer informatie" falls back to the product page.

  Deferred to a separate milestone (by design): a custom slide-in cart drawer (we navigate to
  /cart instead), and the GTM/GA4/Consent wiring (only data-* hooks are emitted here).
{%- endcomment -%}

{%- assign sols = section.blocks | where: 'type', 'solution' -%}

{%- if sols.size > 0 -%}
<div class="opl-page" id="oplossingen-page" data-zv-oplossingen>

  <div class="catnav" role="tablist" aria-label="Onze oplossingen">
    <span class="catnav__lbl">Onze oplossingen</span>
    <div class="catnav__tabs">
      {%- for b in sols -%}
        <button class="catnav__t{% if forloop.first %} on{% endif %}" type="button" role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="panel-{{ b.settings.anchor }}"
          data-opl-tab="{{ b.settings.anchor }}" data-zv-event="solution_view" data-solution-type="{{ b.settings.anchor }}" data-solution-name="{{ b.settings.eyebrow | escape }}"
          data-cta-name="tab_{{ b.settings.anchor }}" data-cta-position="oplossingen_subnav" {{ b.shopify_attributes }}>
          <b>{{ b.settings.eyebrow }}</b><span>{{ b.settings.sublabel }}</span>
        </button>
      {%- endfor -%}
    </div>
  </div>

  {%- for b in sols -%}
    {%- assign anchor = b.settings.anchor -%}
    {%- comment -%}
      The `collection` setting is stored as a handle string in the JSON template, so
      `b.settings.collection` is that string — resolve it through the `collections` lookup.
      (Handle the object form too, in case it's ever set via the theme editor picker.)
      NOTE: the products must be published to the Online Store channel or this is empty.
    {%- endcomment -%}
    {%- assign coll = b.settings.collection -%}
    {%- if coll.products == blank -%}{%- assign coll = collections[b.settings.collection] -%}{%- endif -%}
    <div class="opl-panel" id="panel-{{ anchor }}" role="tabpanel" data-opl-panel="{{ anchor }}"
         aria-label="{{ b.settings.eyebrow | escape }}"{% unless forloop.first %} hidden{% endunless %}>

      <section class="hero" data-section-name="{{ anchor }}">
        <div class="vhero">
          {%- if b.settings.hero_asset != blank -%}<img class="vhero__img" src="{{ b.settings.hero_asset | asset_url }}" alt="{{ b.settings.eyebrow | escape }}" style="object-position:{{ b.settings.hero_pos | default: 'center' }};"{% if forloop.first %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %} width="1240" height="580">{%- endif -%}
          <div class="vhero__copy">
            <span class="vhero__eye">{{ b.settings.eyebrow }}</span>
            {%- if b.settings.headline != blank -%}<h2>{{ b.settings.headline }}</h2>{%- endif -%}
            {%- assign trust = b.settings.trust | strip | newline_to_br | split: '<br />' -%}
            <ul class="vhero__bul">
              {%- for t in trust -%}{%- assign tt = t | strip -%}{%- if tt != blank -%}
                <li><span class="bchk"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{ tt }}</li>
              {%- endif -%}{%- endfor -%}
            </ul>
            <div class="vhero__cta">
              <a class="cta-gold" href="{{ b.settings.hero_cta_url | default: '/#keuzehulp' }}" data-zv-event="book_advice" data-solution-type="{{ anchor }}" data-cta-name="vind_uw_oplossing" data-cta-position="{{ anchor }}_hero" data-zv-finder>{{ b.settings.hero_cta_label | default: 'Vind uw oplossing' }}<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </div>
        </div>
        <div class="vhero__partners">
          <span class="vhero__pnote">Beveiligd met bewezen partners</span>
          <div class="vhero__logos">
            <span class="lchip sec"><img src="{{ 'securitas-preferred-partner.png' | asset_url }}" alt="Securitas Preferred Partner" loading="lazy" width="150" height="30"></span>
            <span class="lchip"><img src="{{ 'partner-nami.png' | asset_url }}" alt="NAMI" loading="lazy" width="90" height="24"></span>
            <span class="lchip"><img src="{{ 'partner-climax.png' | asset_url }}" alt="Climax" loading="lazy" width="110" height="24"></span>
            <span class="lchip"><img src="{{ 'partner-alarmcom.png' | asset_url }}" alt="Alarm.com" loading="lazy" width="120" height="24"></span>
          </div>
        </div>
      </section>

      {%- assign is_coming_soon = false -%}{%- if b.settings.eyebrow contains 'Onderweg' -%}{%- assign is_coming_soon = true -%}{%- endif -%}
      <section class="pak{% if is_coming_soon %} cs{% endif %}" data-section-name="{{ anchor }}">
        <div class="pak__head">
          <div class="pak__head-row">
            {%- if is_coming_soon -%}<h3>Binnenkort beschikbaar</h3>{%- elsif b.settings.pak_heading != blank -%}<h3>{{ b.settings.pak_heading }}</h3>{%- endif -%}
            {%- unless is_coming_soon -%}<a class="compare" href="{{ b.settings.compare_url | default: '/#keuzehulp' }}" data-zv-event="compare_packages" data-solution-type="{{ anchor }}" data-cta-name="niet_zeker" data-cta-position="{{ anchor }}_paks" data-zv-finder>{{ b.settings.compare_label | default: 'Niet zeker welk niveau bij u past?' }}<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{%- endunless -%}
          </div>
          {%- if b.settings.pak_sub != blank -%}<p class="ph-sub">{{ b.settings.pak_sub }}</p>{%- endif -%}
        </div>

        {%- if is_coming_soon -%}
          <div class="cs-wrap">
            <div class="cs-copy"><p>Veilig Onderweg wordt een persoonlijk alarm voor onderweg en thuis: één druk op de knop of automatische valdetectie verbindt u met de meldkamer. We werken de precieze specificaties en prijzen nog uit.</p></div>
            <div class="cs-formbox">
              <b>Blijf op de hoogte</b>
              <form class="cs-form" data-cs-form>
                <label>E-mailadres<input type="email" name="email" placeholder="uw@email.nl" required></label>
                <label>Telefoonnummer<input type="tel" name="phone" placeholder="06 12345678" required></label>
                <label class="cs-check"><input type="checkbox" name="consent"><span>Ik ga akkoord met het <a href="{% render 'zv-route', key: 'privacyverklaring' %}" target="_blank" rel="noopener">privacybeleid</a>.</span></label>
                <div class="cs-err" data-cs-err hidden></div>
                <button type="submit" class="btn btn--gold">Laat uw gegevens achter</button>
              </form>
              <div class="cs-done" data-cs-done hidden><span class="cs-done-ic"><svg viewBox="0 0 24 24" fill="none"><path d="M4.5 12.5l5 5 10-11" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><b>Bedankt.</b> We nemen contact met u op zodra er meer bekend is.</div>
            </div>
          </div>
        {%- elsif coll and coll.products.size > 0 -%}
          <div class="pgrid" data-n="{{ coll.products.size }}">
            {%- for p in coll.products -%}
              {%- assign fk = p.metafields.custom.finder_key.value -%}
              {%- assign tile = '' -%}{%- assign sub = '' -%}{%- assign popular = false -%}
              {%- case fk -%}
                {%- when 'aware' -%}{%- assign tile = 'opl-tile-01.jpg' -%}{%- assign sub = 'NAMI aiAware · 3 Wi-Fi sensing plugs + 1 deursensor · geen meldkamer' -%}
                {%- when 'aware_plus' -%}{%- assign tile = 'opl-tile-02.jpg' -%}{%- assign popular = true -%}{%- assign sub = 'NAMI aiCare · 3 Wi-Fi activity sensoren (~100 m²), deursensor per toegang en 2 PIR · geen meldkamer' -%}
                {%- when 'care' -%}{%- assign tile = 'opl-tile-03.jpg' -%}{%- assign sub = 'Climax · 1 centrale/hub, 2 magneetcontacten, 2 PIR, keuze uit 3 paniekknoppen en 2 rookmelders · incl. meldkamer' -%}
                {%- when 'secure' -%}{%- assign tile = 'opl-tile-04.jpg' -%}{%- assign sub = 'NAMI Alarm15 · Alarm Pod, SensePlug, PIR, deursensor en codepaneel · geen meldkamer of camera' -%}
                {%- when 'guard' -%}{%- assign tile = 'opl-tile-05.jpg' -%}{%- assign popular = true -%}{%- assign sub = 'Climax · hub, codepaneel, rookmelder, PIR en deurcontact · incl. meldkamer, camera optioneel' -%}
                {%- when 'secure_plus' -%}{%- assign tile = 'opl-tile-06.jpg' -%}{%- assign sub = 'Alarm.com · hub, binnencamera, buitencamera en videodeurbel · incl. meldkamer en camera' -%}
                {%- when 'liogo_solo' -%}{%- assign tile = 'opl-tile-10.jpg' -%}{%- assign sub = 'Prijs en specs volgen' -%}
                {%- when 'liogo_guard' -%}{%- assign tile = 'opl-tile-11.jpg' -%}{%- assign sub = 'Prijs en specs volgen' -%}
              {%- endcase -%}
              {%- assign v = p.selected_or_first_available_variant -%}
              {%- comment -%}
                PRICING STATUS (single source of truth: Shopify variant + pricing.config.json):
                - Package monthly price is read live from the Shopify variant ({{ p.price }}), never hard-coded here.
                - Veilig Onderweg / LioGo (liogo_solo, liogo_guard) is PRICE_PENDING → price 0 → "Prijs volgt".
                - Langer Thuis / Mijn Thuis package prices are CURRENT_WORKING (provisional, not yet commercially final).
                - All optional add-ons (uitbreidingen, abonnementen) are provisional → shown as "Prijs volgt", not a literal.
                Confirmed amounts must live only in pricing.config.json / snippets/zv-pricing.liquid (CI check #9 enforces this).
              {%- endcomment -%}
              {%- assign price_known = false -%}{%- if p.price and p.price > 0 -%}{%- assign price_known = true -%}{%- endif -%}
              {%- comment -%} Vista (MT-VIS / secure_plus) is callout-only (maatwerk): geen vaste prijs, geen koop-accordions, alleen de VISTA Lead callback. {%- endcomment -%}
              {%- assign is_vista = false -%}{%- if v.sku == 'MT-VIS' or fk == 'secure_plus' -%}{%- assign is_vista = true -%}{%- assign price_known = false -%}{%- endif -%}
              {%- assign short_name = p.title | remove_first: b.settings.eyebrow | strip -%}
              <article class="pcard pcard--tile{% if popular %} pop{% endif %}" data-odoo-sku="{{ v.sku }}"
                       data-zv-event="package_view" data-solution-type="{{ anchor }}" data-solution-name="{{ b.settings.eyebrow | escape }}" data-package-name="{{ short_name | escape }}"
                       data-package-sku="{{ v.sku }}" data-product-handle="{{ p.handle }}" data-product-id="{{ p.id }}" data-variant-id="{{ v.id }}"
                       data-finder-key="{{ fk }}" data-popular="{{ popular }}" data-available="{{ v.available }}"
                       data-price-known="{{ price_known }}" data-price="{% if price_known %}{{ p.price | money_without_trailing_zeros }}{% else %}Prijs volgt{% endif %}" data-price-cents="{{ p.price }}" data-per="{% if price_known %}/mnd{% endif %}">
                {%- if popular -%}<span class="pcard__flag">Meest gekozen</span>{%- endif -%}
                {%- if tile != blank -%}<span class="pcard__tileimg"><img src="{{ tile | asset_url }}" alt="{{ short_name | escape }}" loading="lazy" width="600" height="820"></span>{%- endif -%}
                <div class="pcard__foot">
                  <div class="pcard__price">
                    {%- if price_known -%}<span class="amt">{{ p.price | money_without_trailing_zeros }}</span><span class="per">/mnd</span>{%- elsif is_vista -%}<span class="amt">Geen vast pakket</span>{%- else -%}<span class="amt">Prijs volgt</span>{%- endif -%}
                  </div>
                  {%- if sub != blank -%}<div class="pcard__sub">{{ sub }}</div>{%- endif -%}
                  {%- if v.sku != blank -%}<div class="pcard__sku">SKU · {{ v.sku }}</div>{%- endif -%}

                  {%- if price_known -%}
                    <details class="pcard__plus">
                      <summary>Woning groter dan 100 m²?<svg viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
                      <label class="pcard__plus-opt"><input type="checkbox"><span>Ja, per extra etage</span><span class="pcard__plus-pr">+€4/mnd</span></label>
                    </details>
                    <details class="pcard__plus">
                      <summary>Uitbreidingen toevoegen<svg viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
                      {%- assign ub = b.settings.uitbreidingen | strip | newline_to_br | split: '<br />' -%}
                      {%- comment -%} Add-on prices are provisional (non-Onderweg): show the pending label, never a literal amount. Confirmed prices come from Shopify (package monthly) or the central pricing config. {%- endcomment -%}
                      {%- for u in ub -%}{%- assign parts = u | strip | split: '|' -%}{%- if parts[0] != blank -%}
                        <label class="pcard__plus-opt"><input type="checkbox"><span>{{ parts[0] | strip }}</span><span class="pcard__plus-pr">{{ parts[1] | default: 'Prijs volgt' | strip }}</span></label>
                      {%- endif -%}{%- endfor -%}
                    </details>
                    <details class="pcard__plus">
                      <summary>Abonnementen<svg viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
                      <label class="pcard__plus-opt"><input type="checkbox"><span>Domotica</span><span class="pcard__plus-pr">Prijs volgt</span></label>
                      <label class="pcard__plus-opt"><input type="checkbox"><span>Ontzorgpakket</span><span class="pcard__plus-pr">Prijs volgt</span></label>
                    </details>
                  {%- endif -%}

                  <div class="pcard__cta">
                    {%- if v.sku == 'MT-VIS' or fk == 'secure_plus' -%}
                      {%- comment -%} Vista is callout-only (maatwerk): no self-checkout, no detail drawer. Conversion is a VISTA Lead callback -> window.ZV_LEAD_ENDPOINT (Odoo CRM). {%- endcomment -%}
                      <div class="pcard__vista" data-vista data-odoo="{{ v.sku | default: 'MT-VIS' }}" data-item="{{ p.title | default: 'Mijn Thuis Vista' | escape }}" data-price="{% if price_known %}{{ p.price | money }}{% else %}Geen vast pakket{% endif %}">
                        <button type="button" class="btn btn--gold" data-vista-open data-zv-event="vista_lead_open" data-solution-type="{{ anchor }}" data-package-sku="{{ v.sku }}" data-cta-name="bel_mij_terug_vista" data-cta-position="{{ anchor }}_paks">Bel mij terug over Vista<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                        <a class="pcard__vista-more" href="/pages/camera-hardware" data-zv-event="vista_camera_hardware" data-cta-name="bekijk_camerahardware">Bekijk de camerahardware<svg viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                        <form class="pcard__vista-form" data-vista-form hidden>
                          <input type="text" name="name" placeholder="Naam" autocomplete="name" required>
                          <input type="tel" name="phone" placeholder="Telefoonnummer" autocomplete="tel" required>
                          <input type="text" name="time" placeholder="Wanneer mogen wij bellen? (optioneel)">
                          <label class="pcard__vista-consent"><input type="checkbox" name="consent"><span>Ik geef toestemming dat Zo Veilig mij terugbelt over Vista.</span></label>
                          <div class="pcard__vista-err" data-vista-err hidden></div>
                          <button type="submit">Verstuur terugbelverzoek</button>
                        </form>
                        <div class="pcard__vista-done" data-vista-done hidden><svg viewBox="0 0 24 24" fill="none"><path d="M4.5 12.5l5 5 10-11" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>Bedankt. Wij bellen u terug over Vista.</div>
                      </div>
                    {%- else -%}
                      {%- comment -%} Matches the design: a BUTTON that opens the detail drawer — never an <a href="/products/…"> (which would navigate). {%- endcomment -%}
                      <button type="button" class="btn {% if popular %}btn--gold{% else %}btn--ghost{% endif %}" data-zv-detail data-finder-key="{{ fk }}" data-product-url="{{ p.url }}" data-zv-event="package_detail_open" data-solution-type="{{ anchor }}" data-package-sku="{{ v.sku }}" data-cta-name="meer_informatie" data-cta-position="{{ anchor }}_paks" aria-haspopup="dialog">Meer informatie<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                      {%- if price_known and v.available -%}
                        <button type="button" class="pcard__direct" data-zv-add data-variant="{{ v.id }}" data-zv-event="add_to_cart" data-solution-type="{{ anchor }}" data-solution-name="{{ b.settings.eyebrow | escape }}" data-package-sku="{{ v.sku }}" data-cta-name="in_winkelwagen" data-cta-position="{{ anchor }}_paks" data-selected-term="" data-selected-addon="">In winkelwagen<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- elsif request.design_mode -%}
          <p class="ph-sub" style="text-align:center;">Koppel de collectie "{{ b.settings.collection }}".</p>
        {%- endif -%}

        {%- if b.settings.note != blank -%}
          <div class="pgnote">
            <span class="pn-ic"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 8v4l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span><b>Binnenkort meer.</b> {{ b.settings.note }}</span>
          </div>
        {%- endif -%}
      </section>

      {%- comment -%} Waarom Zo Veilig — WhyBlock (design shows the first two feature rows). {%- endcomment -%}
      {%- if b.settings.why_heading != blank and b.settings.why_1_img != blank -%}
        <section class="why" data-section-name="{{ anchor }}">
          <div class="why__head">
            <span class="why__eye"><span class="d"></span>Waarom Zo Veilig</span>
            <h3>{{ b.settings.why_heading }}</h3>
          </div>
          <div class="why__grid">
            {%- for i in (1..2) -%}
              {%- assign kimg = 'why_' | append: i | append: '_img' -%}
              {%- assign ktitle = 'why_' | append: i | append: '_title' -%}
              {%- assign kbody = 'why_' | append: i | append: '_body' -%}
              {%- assign klabel = 'why_' | append: i | append: '_link_label' -%}
              {%- assign kurl = 'why_' | append: i | append: '_link_url' -%}
              {%- assign wimg = b.settings[kimg] -%}
              {%- if wimg != blank -%}
                <article class="why__card">
                  <div class="why__ph"><img src="{{ wimg | asset_url }}" alt="{{ b.settings[ktitle] | escape }}" loading="lazy" width="800" height="600"></div>
                  <h4>{{ b.settings[ktitle] }}</h4>
                  <p>{{ b.settings[kbody] }}</p>
                  {%- if b.settings[klabel] != blank -%}
                    {%- assign wurl = b.settings[kurl] -%}
                    {%- if wurl == blank -%}{%- assign wurl = '#' | append: anchor -%}{%- endif -%}
                    <a class="why__link" href="{{ wurl }}"{% if wurl contains '://' %} target="_blank" rel="noopener noreferrer"{% endif %} data-zv-event="why_link" data-solution-type="{{ anchor }}" data-cta-name="why_{{ i }}" data-cta-position="{{ anchor }}_why">{{ b.settings[klabel] }}<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                  {%- endif -%}
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    </div>
  {%- endfor -%}

  {%- comment -%} Stappen + Partners are solution-agnostic; rendered once below the active panel. {%- endcomment -%}
  <section class="stappen" data-section-name="stappen">
    <h2>{{ section.settings.service_heading | default: 'Online wanneer u wilt. Persoonlijk wanneer u dat prettig vindt.' | escape }}</h2>
    <p class="st-sub">{{ section.settings.service_intro | default: 'Bestel eenvoudig online of laat u adviseren door een van onze specialisten. U kiest zelf hoeveel ondersteuning u prettig vindt.' | escape }}</p>
    <div class="steprow">
      {%- comment -%} 4 benefit items; eyebrow/title/text are theme-editor manageable, icons are fixed per slot. {%- endcomment -%}
      {%- assign s_def = 'Online~Direct online regelen~Kies uw beschermingsniveau en bestel veilig online, wanneer het u uitkomt.|Advies~Persoonlijk advies~Twijfelt u? Samen kiezen we de oplossing die het beste bij uw situatie past.|Montage~Vakkundige installatie~Onze monteurs installeren alles professioneel en zorgen dat u direct aan de slag kunt.|Altijd~Ook daarna bereikbaar~Vragen of later uitbreiden? Wij blijven uw vaste aanspreekpunt.' | split: '|' -%}
      {%- for row in s_def -%}
        {%- assign d = row | split: '~' -%}
        {%- assign idx = forloop.index -%}
        {%- assign k_eb = 'benefit_' | append: idx | append: '_eyebrow' -%}
        {%- assign k_ti = 'benefit_' | append: idx | append: '_title' -%}
        {%- assign k_tx = 'benefit_' | append: idx | append: '_text' -%}
        {%- assign eb = section.settings[k_eb] | default: d[0] -%}
        {%- assign ti = section.settings[k_ti] | default: d[1] -%}
        {%- assign tx = section.settings[k_tx] | default: d[2] -%}
        <div class="stap{% if idx == 4 %} hl{% endif %}">
          <div class="sic" aria-hidden="true">{%- case idx -%}
            {%- when 1 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M9 10h6M9 14h6M9 18h3"/></svg>
            {%- when 2 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke-linecap="round"/><circle cx="12" cy="15.5" r="1.4" fill="currentColor" stroke="none"/></svg>
            {%- when 3 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0 5 5l-9.4 9.4a2.1 2.1 0 0 1-3-3z"/><path d="M5 11l3 3"/></svg>
            {%- when 4 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12a7 7 0 0 1 14 0"/><rect x="3.5" y="12" width="3.5" height="6" rx="1.6"/><rect x="17" y="12" width="3.5" height="6" rx="1.6"/><path d="M19 18v.6a2.4 2.4 0 0 1-2.4 2.4H13"/></svg>
          {%- endcase -%}</div>
          <div><span class="sk">{{ eb | escape }}</span><b>{{ ti | escape }}</b><p>{{ tx | escape }}</p>
            {%- if idx == 4 and section.settings.phone_label != blank -%}
              {%- assign tel = section.settings.phone | default: '0881221111' | remove: ' ' -%}
              <a class="belbtn" href="tel:{{ tel }}" aria-label="Bel Zo Veilig, {{ section.settings.phone_label | default: '088 122 11 11' | escape }}" data-zv-event="call_click" data-cta-name="bel_ons" data-cta-position="stappen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h3l1.5 4-2 1.5a11 11 0 0 0 5 5l1.5-2 4 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 4 6a2 2 0 0 1 1-2z"/></svg>{{ section.settings.phone_label | default: '088 122 11 11' | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <section class="partners" data-section-name="partners">
    <div class="partners__t">
      <div class="eb">{{ section.settings.partners_eyebrow | default: 'De beste technologie' | escape }}</div>
      <h2 class="partners__h">{{ section.settings.partners_heading | default: 'De beste technologie. Eén vertrouwd aanspreekpunt.' | escape }}</h2>
      <p>{{ section.settings.partners_body | default: 'Wij kiezen niet voor één merk, maar voor de beste technologie die past bij uw situatie. Daarom werken we samen met toonaangevende partners zoals Alarm.com, Climax, NAMI en Securitas. Zo profiteert u van innovatieve en betrouwbare oplossingen, terwijl u voor advies, installatie en service altijd één vast aanspreekpunt heeft: Zo Veilig.' }}</p>
      {%- if section.settings.show_walkthrough -%}
        <a class="walkthrough-btn" href="{{ section.settings.walkthrough_url | default: '#' }}"{% if section.settings.walkthrough_url == blank %} aria-disabled="true"{% endif %}>
          <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-8z"/></svg></span>
          {{ section.settings.walkthrough_label | default: 'Start de rondleiding' | escape }}
        </a>
      {%- endif -%}
    </div>
    <div class="partners__logos">
      {%- comment -%} 4 partner logo cards; each is theme-editor manageable (image_picker) with an
        approved-asset fallback so the row is never empty. Alarm.com uses a wider card. {%- endcomment -%}
      {%- assign p_defaults = 'securitas-preferred-partner.png~Securitas Preferred Partner~sec|partner-nami.png~NAMI~|partner-climax.png~Climax~|partner-alarmcom.png~Alarm.com~wide' | split: '|' -%}
      {%- for row in p_defaults -%}
        {%- assign d = row | split: '~' -%}
        {%- assign idx = forloop.index -%}
        {%- assign k_logo = 'partner_' | append: idx | append: '_logo' -%}
        {%- assign k_alt = 'partner_' | append: idx | append: '_alt' -%}
        {%- assign k_url = 'partner_' | append: idx | append: '_url' -%}
        {%- assign logo = section.settings[k_logo] -%}
        {%- assign alt = section.settings[k_alt] | default: d[1] -%}
        {%- assign purl = section.settings[k_url] -%}
        {%- capture chip_cls -%}logochip{% if d[2] != blank %} {{ d[2] }}{% endif %}{%- endcapture -%}
        {%- capture chip_inner -%}
          {%- if logo != blank -%}
            {{ logo | image_url: height: 68 | image_tag: alt: alt, loading: 'lazy', widths: '90, 180', class: 'logochip__img' }}
          {%- else -%}
            <img class="logochip__img" src="{{ d[0] | asset_url }}" alt="{{ alt | escape }}" loading="lazy" width="150" height="34">
          {%- endif -%}
        {%- endcapture -%}
        {%- if purl != blank -%}
          <a class="{{ chip_cls }}" href="{{ purl }}" target="_blank" rel="noopener" aria-label="{{ alt | escape }}">{{ chip_inner }}</a>
        {%- else -%}
          <span class="{{ chip_cls }}">{{ chip_inner }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

