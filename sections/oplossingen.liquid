  function openPackageFromUrl() {
    var fk;
    try { fk = new URLSearchParams(location.search).get('pakket'); } catch (e) { fk = null; }
    if (!fk) return;
    var anchor = null;
    for (var id in panels) { if (panels.hasOwnProperty(id) && cardByFk(panels[id], fk)) { anchor = id; break; } }
    if (!anchor) return;
    show(anchor, false);                                 // reveal the package's solution tab
    if (DATA.pkg[fk]) openModal(panels[anchor], fk);     // open its Meer informatie modal
  }
  openPackageFromUrl();
})();
/* ---- Veilig Onderweg 'Binnenkort beschikbaar' lead form (posts to window.ZV_LEAD_ENDPOINT) ---- */
(function () {
  function submitLead(payload) {
    var rec = Object.assign({ ts: Date.now() }, payload);
    if (window.ZV_LEAD_ENDPOINT) { try { window.fetch(window.ZV_LEAD_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=UTF-8' }, body: JSON.stringify(rec), keepalive: true, mode: 'no-cors' }).catch(function () {}); } catch (e) {} }
    try { var L = JSON.parse(localStorage.getItem('zv_leads') || '[]'); L.push(rec); localStorage.setItem('zv_leads', JSON.stringify(L)); } catch (e) {}
  }
  function init() {
    document.querySelectorAll('[data-cs-form]').forEach(function (form) {
      if (form.dataset.bound) return; form.dataset.bound = '1';
      var err = form.querySelector('[data-cs-err]'), box = form.closest('.cs-formbox'), done = box && box.querySelector('[data-cs-done]');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = ((form.querySelector('[name=email]') || {}).value || '').trim();
        var phone = ((form.querySelector('[name=phone]') || {}).value || '').trim();
        var consent = !!(form.querySelector('[name=consent]') || {}).checked;
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { err.textContent = 'Vul een geldig e-mailadres in.'; err.hidden = false; return; }
        if (!phone) { err.textContent = 'Vul uw telefoonnummer in.'; err.hidden = false; return; }
        if (!consent) { err.textContent = 'Ga akkoord met het privacybeleid om verder te gaan.'; err.hidden = false; return; }
        err.hidden = true;
        submitLead({ lead_type: 'coming-soon-onderweg', email: email, phone: phone, consent: consent, cta_location: 'coming_soon_onderweg' });
        form.style.display = 'none'; if (done) done.hidden = false;
      });
    });
  }
  if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
})();
/* ---- Vista: callout-only VISTA Lead callback (posts to window.ZV_LEAD_ENDPOINT / Odoo CRM) ---- */
(function () {
  function submitLead(payload) {
