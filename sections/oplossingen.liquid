{% stylesheet %}
/* Dawn-proof reset: the design relies on a global *{margin:0}; scope it to this page only. */
.opl-page h2, .opl-page h3, .opl-page h4, .opl-page p, .opl-page ul, .opl-page li, .opl-page summary { margin: 0; padding: 0; }
.opl-page ul { list-style: none; }
.opl-page { background: var(--paper); }
.opl-panel[hidden] { display: none; }

/* ---- category switcher (VERBATIM) ---- */
.catnav { display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; padding: 15px clamp(20px, 3.4vw, 48px); background: var(--cream); border-bottom: 1px solid var(--line); }
.catnav__lbl { font-size: 11.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
.catnav__tabs { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
.catnav__t { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; border: 1.5px solid var(--line-2); background: #fff; border-radius: 13px; padding: 9px 18px; cursor: pointer; font-family: inherit; text-align: left; transition: border-color 0.15s, background 0.15s, transform 0.15s; }
.catnav__t b { font-size: 15px; font-weight: 800; color: #3a3550; line-height: 1.15; }
.catnav__t span { font-size: 11.5px; font-weight: 600; color: var(--muted-2); }
.catnav__t:hover { border-color: var(--indigo); transform: translateY(-1px); }
.catnav__t:hover b { color: var(--indigo); }
.catnav__t.on { background: var(--indigo); border-color: var(--indigo); }
.catnav__t.on b { color: #fff; }
.catnav__t.on span { color: #cdc6e8; }
@media (max-width: 640px) { .catnav__lbl { display: none; } .catnav__t { padding: 8px 14px; } }

/* ---- hero (VERBATIM) ---- */
.hero { position: relative; display: block; background: var(--paper); max-width: 1240px; margin: 0 auto; padding: clamp(10px, 1.4vw, 18px) clamp(20px, 3.6vw, 52px) clamp(24px, 3vw, 40px); }
.vhero { position: relative; overflow: visible; border-radius: 0; height: clamp(440px, 44vw, 600px); display: flex; align-items: center; background: repeating-linear-gradient(135deg, #2d2156 0 22px, #281c54 22px 44px); box-shadow: none; }
.vhero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; border-radius: 8px; box-shadow: 0 40px 90px -54px rgba(26, 18, 48, 0.6); }
.vhero::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: 8px; pointer-events: none; background: linear-gradient(90deg, rgba(18, 12, 38, 0.5) 0%, transparent 26%, transparent 74%, rgba(18, 12, 38, 0.5) 100%); }
.vhero__copy { position: relative; z-index: 2; margin: 0 0 0 clamp(-96px, -6.5vw, -44px); max-width: 440px; background: rgba(253, 250, 242, 0.94); border-radius: 6px; padding: clamp(26px, 2.7vw, 38px); box-shadow: 0 40px 80px -40px rgba(26, 18, 48, 0.6); }
.vhero__eye { font-size: 12.5px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: #b67e0a; }
.hero .vhero__copy h2 { font-size: clamp(24px, 2.4vw, 34px); font-weight: 900; line-height: 1.05; letter-spacing: -0.02em; color: var(--indigo); margin-top: 14px; text-wrap: balance; }
.vhero__bul { list-style: none; margin-top: 18px; display: flex; flex-direction: column; gap: 10px; }
