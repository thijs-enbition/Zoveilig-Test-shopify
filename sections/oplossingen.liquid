/* Meer informatie modal / breakout (pb- and pbd- classes). NB: no bare asterisk-slash in this comment. */
.pb-scrim { position: fixed; inset: 0; z-index: 9999; background: rgba(17, 14, 45, 0.52); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); display: flex; justify-content: flex-end; animation: pbFade 0.2s ease; }
