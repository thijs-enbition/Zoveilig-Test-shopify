  function focusables() { return [].slice.call(scrim.querySelectorAll('button, [href], input, [tabindex]:not([tabindex="-1"])')).filter(function (el) { return !el.disabled && el.offsetParent !== null; }); }

  function openModal(panel, fk) {
    activePanel = panel;
