      window.fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: rm.getAttribute('data-cart-remove'), quantity: 0 }) })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
