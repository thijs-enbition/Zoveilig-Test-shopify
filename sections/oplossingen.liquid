.pbd-plus { margin-top: 12px; padding: 13px 14px; border-radius: 12px; background: var(--sand); border: 1px solid var(--line); display: block; cursor: pointer; transition: background 0.15s, border-color 0.15s; }
.pbd-plus.on { background: #eef3ff; border-color: var(--indigo); }
.pbd-plus-row { display: flex; align-items: flex-start; gap: 11px; }
.pbd-plus input { width: 19px; height: 19px; margin-top: 1px; accent-color: #322469; flex: none; cursor: pointer; }
.pbd-plus-t { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.pbd-plus-t span:first-child { font-size: 12.5px; font-weight: 800; letter-spacing: 0.02em; color: var(--indigo); }
.pbd-plus-pr { font-size: 13px; font-weight: 900; color: var(--belt); }
.pbd-plus-items { font-size: 12px; font-weight: 600; color: var(--muted); margin-top: 5px; line-height: 1.4; }
.pbd-soon { display: flex; gap: 10px; margin-top: 16px; background: var(--indigo-soft); border: 1px solid #e2ddf1; border-radius: 8px; padding: 13px 14px; color: var(--indigo); }
.pbd-soon svg { width: 20px; height: 20px; flex: none; margin-top: 1px; }
.pbd-soon span { font-size: 12.5px; font-weight: 600; color: #4a4458; line-height: 1.45; }
.pbd-guarantee { display: flex; gap: 11px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 8px; padding: 14px 16px; color: var(--gold-lt); }
.pbd-guarantee svg { width: 20px; height: 20px; flex: none; margin-top: 1px; }
.pbd-guarantee span { font-size: 12.5px; font-weight: 600; color: #cdc6e8; line-height: 1.45; }
.pbd-guarantee b { color: #fff; font-weight: 800; }
.pbd-info { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 22px; display: grid; gap: 18px; }
