  /* categorise a card's checked options into { woning, terms[], addons[] } */
  function readCardOptions(card) {
    var out = { woning: '', terms: [], addons: [] };
    if (!card) return out;
    card.querySelectorAll('.pcard__plus').forEach(function (det) {
      var head = det.querySelector('summary');
      var label = head ? head.textContent.trim().toLowerCase() : '';
      det.querySelectorAll('.pcard__plus-opt input:checked').forEach(function (inp) {
        var opt = inp.closest('.pcard__plus-opt');
        var name = opt && opt.querySelector('span') ? opt.querySelector('span').textContent.trim() : '';
        if (!name) return;
        if (label.indexOf('woning') === 0) out.woning = 'Groter dan 100 m² (+€4/mnd per etage)';
        else if (label.indexOf('abonnement') === 0) out.terms.push(name);
        else out.addons.push(name);
      });
    });
    return out;
  }

