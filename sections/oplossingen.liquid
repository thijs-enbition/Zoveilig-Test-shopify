.pbd-plat { font-size: 11px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-2); }
.pbd-buy-name { font-size: 21px; font-weight: 900; color: var(--indigo); line-height: 1.05; margin-top: 4px; letter-spacing: -0.01em; }
.pbd-price { display: flex; align-items: baseline; gap: 7px; margin-top: 14px; }
.pbd-amt { font-size: 30px; font-weight: 900; color: var(--ink); letter-spacing: -0.01em; }
.pbd-per { font-size: 14px; font-weight: 700; color: var(--muted); }
.pbd-sub { font-size: 12.5px; font-weight: 600; color: var(--muted-2); margin-top: 5px; line-height: 1.4; }
