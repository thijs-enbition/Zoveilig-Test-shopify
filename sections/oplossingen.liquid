{%- comment -%}
  Oplossingen landing page — 1:1 port of "Zo Veilig Oplossingspaginas.html" (pages.jsx).
  Structure: a category tab switcher (.catnav), and per category a full-width background-photo
  hero (.vhero) + partner strip + package grid of designed tile cards (.pcard.pcard--tile).

  The dark card header + product photo + "IN HET PAKKET" are baked into the designed tile
  image (assets/opl-tile-NN.jpg, one per package). Price + SKU are read from the Shopify
  product; the sub-line + tile mapping come from the finder_key map below (design copy).

  Design CSS is copied VERBATIM from the design file (class names are unique to this page).
  A scoped reset neutralises Dawn's base margins (the design relies on a global *{margin:0}).
  GTM: every CTA exposes data-* hooks (no analytics logic here).

  Deferred to next stages (scoped, not built here): the "Meer informatie" detail modal
  (breakout.jsx), the slide-in cart drawer + add-ons/abonnementen, and the Waarom/steps/tech
  bands. "Meer informatie" links to the product page; "In winkelwagen" adds the variant.
{%- endcomment -%}

{%- assign sols = section.blocks | where: 'type', 'solution' -%}

{%- if sols.size > 0 -%}
<div class="opl-page" id="oplossingen-page" data-zv-oplossingen>

  <div class="catnav" role="tablist" aria-label="Onze oplossingen">
    <span class="catnav__lbl">Onze oplossingen</span>
    <div class="catnav__tabs">
      {%- for b in sols -%}
        <button class="catnav__t{% if forloop.first %} on{% endif %}" type="button" role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="panel-{{ b.settings.anchor }}"
          data-opl-tab="{{ b.settings.anchor }}" data-zv-event="solution_view" data-solution-type="{{ b.settings.anchor }}"
          data-cta-name="tab_{{ b.settings.anchor }}" data-cta-position="oplossingen_subnav" {{ b.shopify_attributes }}>
          <b>{{ b.settings.eyebrow }}</b><span>{{ b.settings.sublabel }}</span>
        </button>
      {%- endfor -%}
    </div>
  </div>

  {%- for b in sols -%}
    {%- assign anchor = b.settings.anchor -%}
    {%- assign coll = collections[b.settings.collection] -%}
    <div class="opl-panel" id="panel-{{ anchor }}" role="tabpanel" data-opl-panel="{{ anchor }}"
         aria-label="{{ b.settings.eyebrow | escape }}"{% unless forloop.first %} hidden{% endunless %}>

      <section class="hero" data-section-name="{{ anchor }}">
        <div class="vhero">
          {%- if b.settings.hero_asset != blank -%}<img class="vhero__img" src="{{ b.settings.hero_asset | asset_url }}" alt="{{ b.settings.eyebrow | escape }}" style="object-position:{{ b.settings.hero_pos | default: 'center' }};" loading="lazy" width="1240" height="580">{%- endif -%}
          <div class="vhero__copy">
            <span class="vhero__eye">{{ b.settings.eyebrow }}</span>
            {%- if b.settings.headline != blank -%}<h2>{{ b.settings.headline }}</h2>{%- endif -%}
            {%- assign trust = b.settings.trust | strip | newline_to_br | split: '<br />' -%}
            <ul class="vhero__bul">
              {%- for t in trust -%}{%- assign tt = t | strip -%}{%- if tt != blank -%}
                <li><span class="bchk"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{ tt }}</li>
              {%- endif -%}{%- endfor -%}
            </ul>
            <div class="vhero__cta">
              <a class="cta-gold" href="{{ b.settings.hero_cta_url | default: '/#keuzehulp' }}" data-zv-event="book_advice" data-solution-type="{{ anchor }}" data-cta-name="vind_uw_oplossing" data-cta-position="{{ anchor }}_hero" data-zv-finder>{{ b.settings.hero_cta_label | default: 'Vind uw oplossing' }}<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </div>
        </div>
        <div class="vhero__partners">
          <span class="vhero__pnote">Beveiligd met bewezen partners</span>
          <div class="vhero__logos">
            <span class="lchip sec"><img src="{{ 'securitas-preferred-partner.png' | asset_url }}" alt="Securitas Preferred Partner" loading="lazy" width="150" height="30"></span>
            <span class="lchip"><img src="{{ 'partner-nami.png' | asset_url }}" alt="NAMI" loading="lazy" width="90" height="24"></span>
            <span class="lchip"><img src="{{ 'partner-climax.png' | asset_url }}" alt="Climax" loading="lazy" width="110" height="24"></span>
            <span class="lchip"><img src="{{ 'partner-alarmcom.png' | asset_url }}" alt="Alarm.com" loading="lazy" width="120" height="24"></span>
          </div>
        </div>
      </section>

      <section class="pak" data-section-name="{{ anchor }}">
        <div class="pak__head">
          <div class="pak__head-row">
            {%- if b.settings.pak_heading != blank -%}<h3>{{ b.settings.pak_heading }}</h3>{%- endif -%}
            <a class="compare" href="{{ b.settings.compare_url | default: '/#keuzehulp' }}" data-zv-event="compare_packages" data-solution-type="{{ anchor }}" data-cta-name="niet_zeker" data-cta-position="{{ anchor }}_paks" data-zv-finder>{{ b.settings.compare_label | default: 'Niet zeker welk niveau bij u past?' }}<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
          {%- if b.settings.pak_sub != blank -%}<p class="ph-sub">{{ b.settings.pak_sub }}</p>{%- endif -%}
        </div>

        {%- if coll and coll.products.size > 0 -%}
          <div class="pgrid" data-n="{{ coll.products.size }}">
            {%- for p in coll.products -%}
              {%- assign fk = p.metafields.custom.finder_key -%}
              {%- assign tile = '' -%}{%- assign sub = '' -%}{%- assign popular = false -%}
              {%- case fk -%}
                {%- when 'aware' -%}{%- assign tile = 'opl-tile-01.jpg' -%}{%- assign sub = 'NAMI aiAware · 3 Wi-Fi sensing plugs + 1 deursensor · geen meldkamer' -%}
                {%- when 'aware_plus' -%}{%- assign tile = 'opl-tile-02.jpg' -%}{%- assign popular = true -%}{%- assign sub = 'NAMI aiCare · 3 Wi-Fi activity sensoren (~100 m²), deursensor per toegang en 2 PIR · geen meldkamer' -%}
                {%- when 'care' -%}{%- assign tile = 'opl-tile-03.jpg' -%}{%- assign sub = 'Climax · 1 centrale/hub, 2 magneetcontacten, 2 PIR, keuze uit 3 paniekknoppen en 2 rookmelders · incl. meldkamer' -%}
                {%- when 'secure' -%}{%- assign tile = 'opl-tile-04.jpg' -%}{%- assign sub = 'NAMI Alarm15 · Alarm Pod, SensePlug, PIR, deursensor en codepaneel · geen meldkamer of camera' -%}
                {%- when 'guard' -%}{%- assign tile = 'opl-tile-05.jpg' -%}{%- assign popular = true -%}{%- assign sub = 'Climax · hub, codepaneel, rookmelder, PIR en deurcontact · incl. meldkamer, camera optioneel' -%}
                {%- when 'secure_plus' -%}{%- assign tile = 'opl-tile-06.jpg' -%}{%- assign sub = 'Alarm.com · hub, binnencamera, buitencamera en videodeurbel · incl. meldkamer en camera' -%}
                {%- when 'liogo_solo' -%}{%- assign tile = 'opl-tile-10.jpg' -%}{%- assign sub = 'Prijs en specs volgen' -%}
                {%- when 'liogo_guard' -%}{%- assign tile = 'opl-tile-11.jpg' -%}{%- assign sub = 'Prijs en specs volgen' -%}
              {%- endcase -%}
              {%- assign v = p.selected_or_first_available_variant -%}
              {%- assign price_known = false -%}{%- if p.price and p.price > 0 -%}{%- assign price_known = true -%}{%- endif -%}
              {%- assign short_name = p.title | remove_first: b.settings.eyebrow | strip -%}
              <article class="pcard pcard--tile{% if popular %} pop{% endif %}" data-odoo-sku="{{ v.sku }}"
                       data-zv-event="package_view" data-solution-type="{{ anchor }}" data-package-name="{{ short_name | escape }}"
                       data-package-sku="{{ v.sku }}" data-product-handle="{{ p.handle }}" data-product-id="{{ p.id }}" data-variant-id="{{ v.id }}">
                {%- if popular -%}<span class="pcard__flag">Meest gekozen</span>{%- endif -%}
                {%- if tile != blank -%}<span class="pcard__tileimg"><img src="{{ tile | asset_url }}" alt="{{ short_name | escape }}" loading="lazy" width="600" height="820"></span>{%- endif -%}
                <div class="pcard__foot">
                  <div class="pcard__price">
                    {%- if price_known -%}<span class="amt">{{ p.price | money_without_trailing_zeros }}</span><span class="per">/mnd</span>{%- else -%}<span class="amt">Prijs volgt</span>{%- endif -%}
                  </div>
                  {%- if sub != blank -%}<div class="pcard__sub">{{ sub }}</div>{%- endif -%}
                  {%- if v.sku != blank -%}<div class="pcard__sku">SKU · {{ v.sku }}</div>{%- endif -%}

                  {%- if price_known -%}
                    <details class="pcard__plus">
                      <summary>Woning groter dan 100 m²?<svg viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
                      <label class="pcard__plus-opt"><input type="checkbox"><span>Ja, per extra etage</span><span class="pcard__plus-pr">+€4/mnd</span></label>
                    </details>
                    <details class="pcard__plus">
                      <summary>Uitbreidingen toevoegen<svg viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
                      {%- assign ub = b.settings.uitbreidingen | strip | newline_to_br | split: '<br />' -%}
                      {%- for u in ub -%}{%- assign parts = u | strip | split: '|' -%}{%- if parts[0] != blank -%}
                        <label class="pcard__plus-opt"><input type="checkbox"><span>{{ parts[0] | strip }}</span><span class="pcard__plus-pr">{{ parts[1] | default: '€0,00' | strip }}</span></label>
                      {%- endif -%}{%- endfor -%}
                    </details>
                    <details class="pcard__plus">
                      <summary>Abonnementen<svg viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
                      <label class="pcard__plus-opt"><input type="checkbox"><span>Domotica</span><span class="pcard__plus-pr">+€4,00/mnd</span></label>
                      <label class="pcard__plus-opt"><input type="checkbox"><span>Ontzorgpakket</span><span class="pcard__plus-pr">Prijs volgt</span></label>
                    </details>
                  {%- endif -%}

                  <div class="pcard__cta">
                    <a class="btn btn--ghost" href="{{ p.url }}" data-zv-event="product_select" data-solution-type="{{ anchor }}" data-package-sku="{{ v.sku }}" data-cta-name="meer_informatie" data-cta-position="{{ anchor }}_paks">Meer informatie<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                    {%- if price_known and v.available -%}
                      <button type="button" class="pcard__direct" data-zv-add data-variant="{{ v.id }}" data-zv-event="add_to_cart" data-solution-type="{{ anchor }}" data-package-sku="{{ v.sku }}" data-cta-name="in_winkelwagen" data-cta-position="{{ anchor }}_paks">In winkelwagen<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- elsif request.design_mode -%}
          <p class="ph-sub" style="text-align:center;">Koppel de collectie "{{ b.settings.collection }}".</p>
        {%- endif -%}

        {%- if b.settings.note != blank -%}
          <div class="pgnote">
            <span class="pn-ic"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 8v4l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span><b>Binnenkort meer.</b> {{ b.settings.note }}</span>
          </div>
        {%- endif -%}
      </section>
    </div>
  {%- endfor -%}
</div>
{%- elsif request.design_mode -%}
  <div style="padding:60px;text-align:center;color:#6f6786;">Oplossingen: voeg "Oplossing" blokken toe.</div>
{%- endif -%}

{% stylesheet %}
/* Dawn-proof reset: the design relies on a global *{margin:0}; scope it to this page only. */
.opl-page h2, .opl-page h3, .opl-page h4, .opl-page p, .opl-page ul, .opl-page li, .opl-page summary { margin: 0; padding: 0; }
.opl-page ul { list-style: none; }
.opl-page { background: var(--paper); }
.opl-panel[hidden] { display: none; }

/* ---- category switcher (VERBATIM) ---- */
.catnav { display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; padding: 15px clamp(20px, 3.4vw, 48px); background: var(--cream); border-bottom: 1px solid var(--line); }
.catnav__lbl { font-size: 11.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
.catnav__tabs { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
.catnav__t { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; border: 1.5px solid var(--line-2); background: #fff; border-radius: 13px; padding: 9px 18px; cursor: pointer; font-family: inherit; text-align: left; transition: border-color 0.15s, background 0.15s, transform 0.15s; }
.catnav__t b { font-size: 15px; font-weight: 800; color: #3a3550; line-height: 1.15; }
.catnav__t span { font-size: 11.5px; font-weight: 600; color: var(--muted-2); }
.catnav__t:hover { border-color: var(--indigo); transform: translateY(-1px); }
.catnav__t:hover b { color: var(--indigo); }
.catnav__t.on { background: var(--indigo); border-color: var(--indigo); }
.catnav__t.on b { color: #fff; }
.catnav__t.on span { color: #cdc6e8; }
@media (max-width: 640px) { .catnav__lbl { display: none; } .catnav__t { padding: 8px 14px; } }

/* ---- hero (VERBATIM) ---- */
.hero { position: relative; display: block; background: var(--paper); padding: clamp(18px, 2.6vw, 30px) clamp(16px, 3vw, 40px) clamp(8px, 1.6vw, 16px); }
.vhero { position: relative; overflow: hidden; border-radius: 24px; min-height: clamp(440px, 54vh, 580px); display: flex; align-items: center; background: repeating-linear-gradient(135deg, #2d2156 0 22px, #281c54 22px 44px); box-shadow: 0 46px 100px -54px rgba(26, 18, 48, 0.75); }
.vhero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
.vhero::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgba(26, 18, 48, 0.8) 0%, rgba(26, 18, 48, 0.52) 38%, rgba(26, 18, 48, 0.12) 66%, transparent 88%); }
.vhero__copy { position: relative; z-index: 2; max-width: 560px; padding: clamp(32px, 5vw, 72px); }
.vhero__eye { font-size: 12.5px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-lt); }
.hero .vhero__copy h2 { font-size: clamp(38px, 5vw, 62px); font-weight: 900; line-height: 1; letter-spacing: -0.02em; color: #fff; margin-top: 16px; text-wrap: balance; }
.vhero__bul { margin-top: 26px; display: flex; flex-direction: column; gap: 13px; }
.vhero__bul li { display: flex; align-items: center; gap: 12px; font-size: 15.5px; font-weight: 700; color: rgba(255, 255, 255, 0.95); }
.vhero__bul .bchk { width: 26px; height: 26px; border-radius: 50%; background: var(--gold); display: grid; place-items: center; flex: none; }
.vhero__bul .bchk svg { width: 15px; height: 15px; color: var(--indigo); }
.vhero__cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
.vhero__cta a { display: inline-flex; align-items: center; gap: 9px; font-weight: 800; font-size: 15px; border-radius: 13px; padding: 14px 22px; text-decoration: none; transition: transform 0.14s; }
.vhero__cta a:hover { transform: translateY(-1px); }
.vhero__cta a svg { width: 18px; height: 18px; }
.vhero__cta .cta-gold { background: var(--gold); color: var(--ink); box-shadow: 0 2px 0 var(--belt); }
.vhero__partners { display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; max-width: 1240px; margin: 0 auto; padding: clamp(16px, 2.2vw, 26px) 4px clamp(4px, 1vw, 10px); }
.vhero__pnote { font-size: 12.5px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
.vhero__logos { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.vhero__logos .lchip { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 10px 16px; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 24px -18px rgba(26, 18, 48, 0.4); }
.vhero__logos .lchip img { height: 24px; width: auto; display: block; }
.vhero__logos .lchip.sec img { height: 30px; }

/* ---- product grid (VERBATIM) ---- */
.pak { position: relative; padding: clamp(34px, 3.6vw, 50px) clamp(24px, 3.4vw, 56px) clamp(30px, 3vw, 42px); background: linear-gradient(180deg, #fbf5e9 0%, #f4ecda 100%); border-top: 1px solid var(--line); }
.pak__head { max-width: 1080px; margin: 0 auto 26px; }
.pak__head-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.pak__head h3 { font-size: clamp(24px, 2.6vw, 32px); font-weight: 900; color: var(--indigo); letter-spacing: -0.015em; line-height: 1.05; }
.pak__head .ph-sub { font-size: 15px; font-weight: 600; color: var(--muted); margin-top: 10px; line-height: 1.45; }
.pak__head .compare { font-size: 14px; font-weight: 800; color: var(--indigo); text-decoration: none; display: inline-flex; align-items: center; gap: 7px; }
.pak__head .compare svg { width: 16px; height: 16px; }
.pgrid { display: grid; gap: 20px; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); max-width: calc(var(--cols, 3) * 360px); margin-left: auto; margin-right: auto; }
.pgrid[data-n="1"] { --cols: 1; } .pgrid[data-n="2"] { --cols: 2; } .pgrid[data-n="3"] { --cols: 3; }
.pcard { position: relative; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; padding: 26px 24px 24px; display: flex; flex-direction: column; box-shadow: 0 1px 2px rgba(26, 18, 48, 0.04); transition: border-color 0.2s ease, box-shadow 0.2s ease; }
.pcard:hover { border-color: var(--line-2); box-shadow: 0 6px 20px -12px rgba(26, 18, 48, 0.22); }
.pcard.pop { border-color: var(--indigo); box-shadow: 0 6px 20px -12px rgba(50, 36, 105, 0.28); }
.pcard__flag { align-self: flex-start; margin-bottom: 12px; color: var(--belt); font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
.pcard--tile { padding-top: 14px; }
.pcard__tileimg { border-radius: 6px; overflow: hidden; margin: 0 0 16px; border: 1px solid var(--line); }
.pcard__tileimg img { width: 100%; height: auto; display: block; }
.pcard__foot { margin-top: auto; padding-top: 4px; }
.pcard__price { display: flex; align-items: baseline; gap: 7px; }
.pcard__price .amt { font-size: 27px; font-weight: 900; color: var(--ink); letter-spacing: -0.01em; }
.pcard__price .per { font-size: 13.5px; font-weight: 700; color: var(--muted); }
.pcard__sub { font-size: 12.5px; font-weight: 600; color: var(--muted-2); margin-top: 3px; }
.pcard__sku { font-size: 12px; font-weight: 500; color: var(--muted-2); margin-top: 8px; letter-spacing: 0.02em; font-variant-numeric: tabular-nums; }
.pcard__cta { margin-top: 16px; display: flex; flex-direction: column; gap: 8px; }
.pcard__plus { margin-top: 0; border: none; border-top: 1px solid var(--line); border-radius: 0; overflow: hidden; background: none; }
.pcard__plus summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 13px; font-weight: 700; color: var(--indigo); padding: 12px 2px; transition: color 0.15s; }
.pcard__plus summary:hover { color: var(--belt); }
.pcard__plus summary::-webkit-details-marker { display: none; }
.pcard__plus summary svg { width: 15px; height: 15px; transition: transform 0.2s; }
.pcard__plus[open] summary svg { transform: rotate(180deg); }
.pcard__plus-opt { display: flex; align-items: center; gap: 9px; padding: 0 2px 12px; font-size: 13px; font-weight: 700; color: #4a4458; cursor: pointer; }
.pcard__plus-opt input { width: 17px; height: 17px; accent-color: #322469; flex: none; cursor: pointer; }
.pcard__plus-opt span:nth-of-type(1) { flex: 1; }
.pcard__plus-pr { font-weight: 900; color: var(--belt); }
.pcard__cta .btn { width: 100%; justify-content: center; font-size: 14.5px; padding: 13px 18px; border-radius: 6px; }
.pcard__cta .btn--ghost { border-width: 1.5px; }
.pcard__direct { width: 100%; justify-content: center; display: inline-flex; align-items: center; gap: 7px; border: none; background: none; font-family: inherit; font-weight: 800; font-size: 13.5px; color: var(--indigo); cursor: pointer; padding: 5px 4px; transition: color 0.14s; }
.pcard__direct svg { width: 15px; height: 15px; transition: transform 0.16s; }
.pcard__direct:hover { color: var(--belt); }
.pcard__direct:hover svg { transform: translateX(3px); }
.pgnote { display: flex; align-items: center; gap: 12px; margin: 26px auto 0; background: var(--indigo-soft); border: 1px solid #ddd5f0; border-radius: 14px; padding: 14px 18px; max-width: 760px; }
.pgnote .pn-ic { width: 34px; height: 34px; border-radius: 10px; background: #fff; display: grid; place-items: center; flex: none; box-shadow: inset 0 0 0 1px #ddd5f0; }
.pgnote .pn-ic svg { width: 20px; height: 20px; color: var(--indigo); }
.pgnote b { color: var(--indigo); font-weight: 800; }
.pgnote span { font-size: 13.5px; font-weight: 600; color: #4a4458; line-height: 1.4; }
@media (max-width: 820px) { .vhero__copy { max-width: none; } }
@media (max-width: 720px) { .pgrid, .pgrid[data-n="2"], .pgrid[data-n="3"] { --cols: 1; max-width: 420px; } }
@media (prefers-reduced-motion: reduce) { .catnav__t, .vhero__cta a, .pcard, .pcard__direct { transition: none; } }
{% endstylesheet %}

{% javascript %}
(function () {
  var page = document.querySelector('[data-zv-oplossingen]');
  if (!page) return;
  var tabs = [].slice.call(page.querySelectorAll('[data-opl-tab]'));
  var panels = {};
  page.querySelectorAll('[data-opl-panel]').forEach(function (p) { panels[p.getAttribute('data-opl-panel')] = p; });

  function show(id, push) {
    if (!panels[id]) return;
    tabs.forEach(function (t) {
      var on = t.getAttribute('data-opl-tab') === id;
      t.classList.toggle('on', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    Object.keys(panels).forEach(function (k) { panels[k].hidden = k !== id; });
    if (push && history.replaceState) { try { history.replaceState(null, '', '#' + id); } catch (e) {} }
  }

  tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.getAttribute('data-opl-tab'), true); }); });

  // Deep-link: homepage buckets link to /pages/oplossingen#langer-thuis etc.
  var hash = (location.hash || '').replace('#', '');
  if (hash && panels[hash]) show(hash, false);
  window.addEventListener('hashchange', function () {
    var h = (location.hash || '').replace('#', '');
    if (panels[h]) show(h, false);
  });

  // "In winkelwagen": add the variant to the Shopify cart, fire add_to_cart, go to cart.
  page.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('[data-zv-add]');
    if (!btn) return;
    var id = btn.getAttribute('data-variant');
    if (!id) return;
    btn.disabled = true;
    window.fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: id, quantity: 1 }] }) })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (line) {
        var ZV = window.ZVMeasurement;
        if (ZV && ZV.addToCart) ZV.addToCart({ item_id: (line && line.sku) || btn.getAttribute('data-package-sku'), item_brand: 'Zo Veilig', price: (line && line.price) ? line.price / 100 : undefined, quantity: 1 }, { cta_location: btn.getAttribute('data-cta-position') });
        window.location.href = '/cart';
      })
      .catch(function () { btn.disabled = false; });
  });
})();
{% endjavascript %}

