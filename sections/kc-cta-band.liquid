{{ 'zv-kc.css' | asset_url | stylesheet_tag }}

<div class="zv-kc">
  <section class="cta-band">
    <div class="wrap">
      <div class="ct-tx">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      <div class="ct-actions">
        {%- if section.settings.primary_label != blank -%}
          <a
            class="btn btn--ink"
            href="{{ section.settings.primary_link | default: '#' }}"
            data-zv-event="view_item_list"
            data-zv-source="kenniscentrum_cta"
          >
            {{- section.settings.primary_label | escape -}}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_label != blank -%}
          <a
            class="btn btn--onlight"
            href="{{ section.settings.secondary_link | default: '#' }}"
            data-zv-event="generate_lead"
            data-zv-lead-type="advice"
            data-zv-source="kenniscentrum_cta"
          >
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "KC CTA band",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Van kennis naar de juiste oplossing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Weet je genoeg? Bekijk de pakketten die hierbij passen."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Onze gidsen helpen je kiezen. Onze pakketten maken het waar, met een vertrouwd gezicht dat met je meedenkt."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primaire knop",
      "default": "Bekijk pakketten"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primaire link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secundaire knop",
      "default": "Gratis adviesgesprek"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secundaire link"
    }
  ],
  "presets": [{ "name": "KC CTA band" }]
}
{% endschema %}
