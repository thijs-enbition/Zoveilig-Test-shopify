{%- comment -%}
  Zo Veilig header: utility bar + sticky nav.
  1:1 port of the design pack header (Homepage.html: .util + nav.sf-nav).

  Navigation is a Shopify primitive (Online Store > Navigation), NOT a metaobject, so the
  nav links and the utility links come from link list menus chosen in the Theme Editor.
  Logo, phone number and the utility message are theme/section settings.
  Cart count is live from the cart object.
{%- endcomment -%}

<div class="util">
  <div class="wrap">
    <div class="u-l">
      <span class="pulse" aria-hidden="true"></span>
      <span>{{ section.settings.util_message }}</span>
    </div>
    <div class="u-r">
      {%- if section.settings.utility_menu != blank -%}
        {%- for link in linklists[section.settings.utility_menu].links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <a class="ph hideph" href="tel:{{ section.settings.phone | remove: ' ' }}">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ section.settings.phone }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<nav class="sf-nav" aria-label="Hoofdnavigatie">
  <div class="wrap">
    <a class="sf-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: height: 72 | image_tag: alt: shop.name, loading: 'eager', widths: '72, 144, 216' }}
      {%- else -%}
        <img src="{{ 'zo-veilig-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="150" height="45">
      {%- endif -%}
    </a>

    {%- if section.settings.menu != blank -%}
      <ul class="sf-links">
        {%- for link in linklists[section.settings.menu].links -%}
          <li class="{% if link.active or link.child_active %}active{% endif %}">
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="sf-right">
      {%- if section.settings.show_search -%}
        <a class="sf-iconlink" href="{{ routes.search_url }}" aria-label="Zoeken">
          <svg class="sf-icn" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </a>
      {%- endif -%}

      <a class="cart" href="{{ routes.cart_url }}" aria-label="Winkelwagen, {{ cart.item_count }} artikelen">
        <svg class="sf-icn" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12L4 3H2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="20" r="1.6" fill="currentColor"/><circle cx="18" cy="20" r="1.6" fill="currentColor"/></svg>
        {%- if cart.item_count > 0 -%}<span class="dot">{{ cart.item_count }}</span>{%- endif -%}
      </a>

      {%- if section.settings.cta_text != blank -%}
        <a class="btn btn--gold" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Zo Veilig header",
  "settings": [
    { "type": "header", "content": "Utility bar" },
    { "type": "text", "id": "util_message", "label": "Melding", "default": "Nederlandse meldkamer, 24/7 bewaakt door Securitas" },
    { "type": "link_list", "id": "utility_menu", "label": "Utility-menu" },
    { "type": "text", "id": "phone", "label": "Telefoonnummer", "default": "088 012 3456" },
    { "type": "header", "content": "Navigatie" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Hoofdmenu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Zoekicoon tonen", "default": true },
    { "type": "text", "id": "cta_text", "label": "Knoptekst", "default": "Zakelijk" },
    { "type": "url", "id": "cta_link", "label": "Knoplink" }
  ]
}
{% endschema %}
