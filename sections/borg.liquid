{%- comment -%}
  Zo Veilig — BORG-certificering. Intro + 3 handleiding-CTA's + een grid met
  één pill-knop per beveiligingscomponent, elk linkend naar het bijbehorende
  certificaat (Shopify file, url in het blok-setting). Header + footer komen
  uit het thema. Links routeren via zv-route.
{%- endcomment -%}

{%- liquid
  assign intro_alt = section.settings.heading | default: 'Inbraakbeveiliging met BORG-keurmerk'
-%}

<div class="zv-borg">
  <section class="borg-intro">
    <div class="wrap">
      <div class="intro-media">
        {%- if section.settings.intro_image != blank -%}
          {{ section.settings.intro_image | image_url: width: 900 | image_tag: alt: intro_alt, loading: 'lazy' }}
        {%- else -%}
          <div class="intro-media-fallback" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="10" width="18" height="10" rx="1.5"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/><circle cx="12" cy="15" r="1.6" fill="currentColor" stroke="none"/></svg>
          </div>
        {%- endif -%}
      </div>
      <div class="intro-copy">
        <span class="eyebrow">{{ section.settings.eyebrow | default: 'Verzekeringscertificaten' | escape }}</span>
        <h1>{{ section.settings.heading | default: 'Inbraakbeveiliging met BORG-keurmerk' | escape }}</h1>
        <p class="lead">{{ section.settings.intro_text | default: "Met het BORG-certificaat kunt u aantonen dat uw bedrijfspand of woning goed beveiligd is tegen inbraak. Bij het verzekeren van uw pand kan een verzekeraar een BORG-certificaat eisen. Zo is de verzekeraar er zeker van dat de beveiligingsinstallatie door een echte vakman is aangelegd. Er zijn verzekeraars die korting op de premie bieden als u een BORG-certificaat kunt overleggen. Hieronder vindt u de linkjes naar de certificaten per component type terug." }}</p>

        <div class="borg-ctas">
          {%- if section.settings.cta1_label != blank -%}
            <a class="btn btn--blue" href="{{ section.settings.cta1_url | default: '#' }}" {% if section.settings.cta1_url != blank %}target="_blank" rel="noopener"{% endif %}>{{ section.settings.cta1_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="btn btn--gold" href="{{ section.settings.cta2_url | default: '#' }}" {% if section.settings.cta2_url != blank %}target="_blank" rel="noopener"{% endif %}>{{ section.settings.cta2_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta3_label != blank -%}
            <a class="btn btn--blue btn--wide" href="{{ section.settings.cta3_url | default: '#' }}" {% if section.settings.cta3_url != blank %}target="_blank" rel="noopener"{% endif %}>{{ section.settings.cta3_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <section class="borg-certs">
    <div class="wrap">
      <div class="certs-box">
        <img class="certs-mark" src="{{ 'zo-veilig-logo.png' | asset_url }}" alt="" loading="lazy" width="90" height="24" aria-hidden="true">
        <div class="certs-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'certificaat' -%}
              {%- if block.settings.pdf_url != blank -%}
                <a class="cert-pill" href="{{ block.settings.pdf_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              {%- else -%}
                <span class="cert-pill cert-pill--empty" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.zv-borg {
  --ink:#1a1230; --indigo:#322469; --gold:#E4A311; --blue:#00509F; --canvas:#f7efe0; --paper:#fffdf8;
  --line:#e6dcc6; --muted:#6f6786;
  background:var(--canvas); color:var(--ink);
}
.zv-borg .wrap { max-width:1180px; margin:0 auto; padding:0 32px; }
@media(max-width:720px){ .zv-borg .wrap{ padding:0 20px; } }
.zv-borg .eyebrow { font-size:12px; font-weight:800; letter-spacing:.26em; text-transform:uppercase; color:var(--blue); display:inline-block; }
.zv-borg h1 { font-size:clamp(28px,4vw,38px); font-weight:900; letter-spacing:-.015em; color:var(--indigo); line-height:1.08; margin-top:12px; }
.zv-borg .lead { font-size:16.5px; font-weight:500; color:#473f5e; line-height:1.62; margin-top:18px; }

.zv-borg .btn { font-weight:800; font-size:14.5px; border:none; border-radius:999px; padding:14px 24px; line-height:1; display:inline-flex; align-items:center; justify-content:center; gap:10px; cursor:pointer; text-decoration:none; text-align:center; transition:transform .15s,box-shadow .15s; white-space:normal; }
.zv-borg .btn--blue { background:var(--blue); color:#fff; box-shadow:0 10px 26px -12px rgba(0,80,159,.6); }
.zv-borg .btn--blue:hover { transform:translateY(-2px); }
.zv-borg .btn--gold { background:var(--gold); color:var(--ink); box-shadow:0 10px 26px -12px rgba(180,126,10,.85); }
.zv-borg .btn--gold:hover { transform:translateY(-2px); }
.zv-borg .btn--wide { width:100%; }
.zv-borg a:focus-visible, .zv-borg button:focus-visible { outline:2px solid var(--indigo); outline-offset:3px; }

.zv-borg .borg-intro .wrap { padding:64px 32px; display:grid; grid-template-columns:0.85fr 1.15fr; gap:48px; align-items:center; }
@media(max-width:880px){ .zv-borg .borg-intro .wrap{ grid-template-columns:1fr; gap:32px; padding:44px 20px; } }
.zv-borg .intro-media-fallback { display:flex; align-items:center; justify-content:center; aspect-ratio:1/1; max-width:320px; margin:0 auto; border-radius:24px; background:var(--paper); border:1px solid var(--line); color:var(--blue); }
.zv-borg .intro-media-fallback svg { width:35%; height:35%; }
.zv-borg .intro-media img { width:100%; display:block; border-radius:24px; }
.zv-borg .borg-ctas { display:flex; flex-wrap:wrap; gap:12px; margin-top:26px; }
.zv-borg .borg-ctas .btn:not(.btn--wide) { flex:1 1 220px; }
.zv-borg .borg-ctas .btn--wide { flex:1 1 100%; }

.zv-borg .borg-certs .wrap { padding:0 32px 72px; }
@media(max-width:720px){ .zv-borg .borg-certs .wrap{ padding:0 20px 52px; } }
.zv-borg .certs-box { position:relative; background:var(--paper); border:1px solid var(--line); border-radius:22px; padding:36px; box-shadow:0 26px 60px -46px rgba(26,18,48,.5); }
.zv-borg .certs-mark { position:absolute; top:22px; right:26px; opacity:.5; }
.zv-borg .certs-grid { display:flex; flex-wrap:wrap; gap:12px; padding-right:100px; }
@media(max-width:560px){ .zv-borg .certs-grid{ padding-right:0; } .zv-borg .certs-mark{ display:none; } }
.zv-borg .cert-pill { display:inline-flex; align-items:center; font-size:13px; font-weight:800; letter-spacing:.02em; text-transform:uppercase; color:var(--ink); background:#fbe9c7; border:1px solid #eccf86; border-radius:999px; padding:11px 18px; text-decoration:none; transition:background .15s,transform .15s; }
.zv-borg .cert-pill:hover { background:var(--gold); transform:translateY(-1px); }
.zv-borg .cert-pill--empty { opacity:.55; cursor:default; }
.zv-borg .cert-pill--empty:hover { background:#fbe9c7; transform:none; }
{% endstylesheet %}

{% schema %}
{
  "name": "BORG-certificering",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verzekeringscertificaten" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Inbraakbeveiliging met BORG-keurmerk" },
    { "type": "textarea", "id": "intro_text", "label": "Introtekst" },
    { "type": "image_picker", "id": "intro_image", "label": "Illustratie" },
    { "type": "header", "content": "Knoppen" },
    { "type": "text", "id": "cta1_label", "label": "Knop 1 tekst", "default": "Handleiding alarmsysteem" },
    { "type": "url", "id": "cta1_url", "label": "Knop 1 link (PDF of pagina)" },
    { "type": "text", "id": "cta2_label", "label": "Knop 2 tekst", "default": "Handleiding camera's" },
    { "type": "url", "id": "cta2_url", "label": "Knop 2 link (PDF of pagina)" },
    { "type": "text", "id": "cta3_label", "label": "Knop 3 tekst", "default": "Taken voor de gebruiker van het alarmsysteem" },
    { "type": "url", "id": "cta3_url", "label": "Knop 3 link (PDF of pagina)" }
  ],
  "blocks": [
    {
      "type": "certificaat",
      "name": "Certificaat",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Component" },
        { "type": "url", "id": "pdf_url", "label": "Certificaat (link naar Shopify-bestand)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BORG-certificering",
      "blocks": [
        { "type": "certificaat", "settings": { "label": "Bewegingssensor" } },
        { "type": "certificaat", "settings": { "label": "Rookmelder" } },
        { "type": "certificaat", "settings": { "label": "Magneetcontact" } },
        { "type": "certificaat", "settings": { "label": "Centrale" } },
        { "type": "certificaat", "settings": { "label": "Huisdierpir (IRP-9)" } },
        { "type": "certificaat", "settings": { "label": "Paniekknop" } },
        { "type": "certificaat", "settings": { "label": "Codebedienpaneel" } },
        { "type": "certificaat", "settings": { "label": "Huisdierpir (VST-862P)" } },
        { "type": "certificaat", "settings": { "label": "Fotopir" } },
        { "type": "certificaat", "settings": { "label": "Koolmonoxidemelder" } },
        { "type": "certificaat", "settings": { "label": "Buitensirene" } },
        { "type": "certificaat", "settings": { "label": "Buitenpir" } }
      ]
    }
  ]
}
{% endschema %}
