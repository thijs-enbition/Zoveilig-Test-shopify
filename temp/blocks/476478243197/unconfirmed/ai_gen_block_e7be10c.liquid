{% doc %}
  @prompt
    Create a mobile-first replacement for the scenario-card interface in the Oplossingen section. Preserve all existing scenario titles, example quotes, package recommendations, Dutch wording, branding, and desktop usefulness. On phones, replace the long wall of cards with a polished three-group accordion organized by package level: Secure, Guard, and Secure Plus. Each collapsed group should show the package name, a short summary, and the number of matching scenarios. Tapping a group should smoothly fold it open to reveal its scenario cards, with only one group open at a time. Make the scenario cards compact and easy to scan, clearly show the recommended package, and avoid excessive vertical spacing. Include a visible expand indicator, smooth but quick transitions, proper keyboard controls and focus behavior, and support reduced-motion preferences. Avoid horizontal scrolling and layout jumps. On larger screens, use a clean grouped grid or retain a similarly clear accordion if it reads better. The component should fit naturally into the existing Oplossingen design and replace the current scenario interface rather than duplicating it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scenarios-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_body_font.family }}, sans-serif;
  }

  .ai-scenarios-{{ ai_gen_id }}__groups {
    display: grid;
    gap: 12px;
  }

  .ai-scenarios-{{ ai_gen_id }}__group {
    overflow: hidden;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.radius }}px;
    background: {{ block.settings.background_color }};
  }

  .ai-scenarios-{{ ai_gen_id }}__trigger {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    width: 100%;
    padding: 16px;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ai-scenarios-{{ ai_gen_id }}__trigger:focus-visible,
  .ai-scenarios-{{ ai_gen_id }}__scenario:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: -3px;
  }

  .ai-scenarios-{{ ai_gen_id }}__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .ai-scenarios-{{ ai_gen_id }}__name {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.type_header_font.family }}, sans-serif;
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .ai-scenarios-{{ ai_gen_id }}__summary {
    display: block;
    margin-top: 4px;
    color: {{ block.settings.muted_color }};
    font-size: .92rem;
    line-height: 1.35;
  }

  .ai-scenarios-{{ ai_gen_id }}__count,
  .ai-scenarios-{{ ai_gen_id }}__recommendation {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 4px 9px;
    border-radius: 999px;
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.accent_text_color }};
    font-size: .78rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-scenarios-{{ ai_gen_id }}__indicator {
    width: 10px;
    height: 10px;
    border-right: 2px solid {{ block.settings.heading_color }};
    border-bottom: 2px solid {{ block.settings.heading_color }};
    transform: rotate(45deg) translateY(-3px);
    transition: transform .18s ease;
  }

  .ai-scenarios-{{ ai_gen_id }}__trigger[aria-expanded="true"] .ai-scenarios-{{ ai_gen_id }}__indicator {
    transform: rotate(225deg) translate(-2px, -2px);
  }

  .ai-scenarios-{{ ai_gen_id }}__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .2s ease;
  }

  .ai-scenarios-{{ ai_gen_id }}__panel[aria-hidden="false"] {
    grid-template-rows: 1fr;
  }

  .ai-scenarios-{{ ai_gen_id }}__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .ai-scenarios-{{ ai_gen_id }}__cards {
    display: grid;
    gap: 8px;
    padding: 0 12px 12px;
  }

  .ai-scenarios-{{ ai_gen_id }}__scenario {
    display: block;
    padding: 12px;
    border-left: 3px solid {{ block.settings.accent_color }};
    background: {{ block.settings.card_color }};
    color: inherit;
  }

  .ai-scenarios-{{ ai_gen_id }}__scenario-title {
    margin: 0 0 5px;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.type_header_font.family }}, sans-serif;
    font-size: 1rem;
    line-height: 1.25;
  }

  .ai-scenarios-{{ ai_gen_id }}__quote {
    margin: 0;
    color: {{ block.settings.muted_color }};
    font-size: .9rem;
    line-height: 1.4;
  }

  .ai-scenarios-{{ ai_gen_id }}__empty {
    padding: 12px;
    color: {{ block.settings.muted_color }};
    font-size: .9rem;
  }

  @media screen and (min-width: 750px) {
    .ai-scenarios-{{ ai_gen_id }}__groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }

    .ai-scenarios-{{ ai_gen_id }}__panel {
      grid-template-rows: 1fr;
    }

    .ai-scenarios-{{ ai_gen_id }}__indicator {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-scenarios-{{ ai_gen_id }}__panel,
    .ai-scenarios-{{ ai_gen_id }}__indicator {
      transition: none;
    }
  }
{% endstyle %}

<scenario-groups-{{ ai_gen_id }} class="ai-scenarios-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-scenarios-{{ ai_gen_id }}__groups">
    {% for group in (1..3) %}
      {% liquid
        assign name_key = 'group_' | append: group | append: '_name'
        assign summary_key = 'group_' | append: group | append: '_summary'
        assign scenarios_key = 'group_' | append: group | append: '_scenarios'
        assign group_name = block.settings[name_key]
        assign group_summary = block.settings[summary_key]
        assign scenario_text = block.settings[scenarios_key]
        assign scenario_lines = scenario_text | newline_to_br | split: '<br />'
        assign scenario_count = 0
        for line in scenario_lines
          assign clean_line = line | strip
          if clean_line != blank
            assign scenario_count = scenario_count | plus: 1
          endif
        endfor
      %}
      {% assign panel_id = 'ai-scenarios-panel-' | append: ai_gen_id | append: '-' | append: group %}
      <section class="ai-scenarios-{{ ai_gen_id }}__group">
        <button class="ai-scenarios-{{ ai_gen_id }}__trigger" type="button" aria-expanded="false" aria-controls="{{ panel_id }}">
          <span>
            <span class="ai-scenarios-{{ ai_gen_id }}__heading">
              <span class="ai-scenarios-{{ ai_gen_id }}__name">{{ group_name | escape }}</span>
              <span class="ai-scenarios-{{ ai_gen_id }}__count">{{ scenario_count }} scenario's</span>
            </span>
            <span class="ai-scenarios-{{ ai_gen_id }}__summary">{{ group_summary | escape }}</span>
          </span>
          <span class="ai-scenarios-{{ ai_gen_id }}__indicator" aria-hidden="true"></span>
        </button>
        <div id="{{ panel_id }}" class="ai-scenarios-{{ ai_gen_id }}__panel" aria-hidden="true">
          <div class="ai-scenarios-{{ ai_gen_id }}__panel-inner">
            <div class="ai-scenarios-{{ ai_gen_id }}__cards">
              {% for line in scenario_lines %}
                {% assign parts = line | strip | split: '|' %}
                {% if parts[0] != blank %}
                  <article class="ai-scenarios-{{ ai_gen_id }}__scenario" tabindex="-1">
                    <h3 class="ai-scenarios-{{ ai_gen_id }}__scenario-title">{{ parts[0] | strip | escape }}</h3>
                    {% if parts[1] != blank %}<p class="ai-scenarios-{{ ai_gen_id }}__quote">“{{ parts[1] | strip | escape }}”</p>{% endif %}
                    <span class="ai-scenarios-{{ ai_gen_id }}__recommendation">Aanbevolen: {{ group_name | escape }}</span>
                  </article>
                {% endif %}
              {% endfor %}
              {% if scenario_count == 0 %}<p class="ai-scenarios-{{ ai_gen_id }}__empty">Voeg scenario's toe via de instellingen. Gebruik één regel per scenario: titel | voorbeeldquote.</p>{% endif %}
            </div>
          </div>
        </div>
      </section>
    {% endfor %}
  </div>
</scenario-groups-{{ ai_gen_id }}>

<script>
  (function() {
    class ScenarioGroups{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.buttons = Array.from(this.querySelectorAll('.ai-scenarios-{{ ai_gen_id }}__trigger'));
        this.buttons.forEach((button, index) => {
          button.addEventListener('click', () => this.toggle(button, index));
          button.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowDown' || event.key === 'ArrowRight') { event.preventDefault(); this.buttons[(index + 1) % this.buttons.length].focus(); }
            if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') { event.preventDefault(); this.buttons[(index - 1 + this.buttons.length) % this.buttons.length].focus(); }
            if (event.key === 'Home') { event.preventDefault(); this.buttons[0].focus(); }
            if (event.key === 'End') { event.preventDefault(); this.buttons[this.buttons.length - 1].focus(); }
          });
        });
      }

      toggle(button, index) {
        const isOpen = button.getAttribute('aria-expanded') === 'true';
        this.buttons.forEach((item) => {
          item.setAttribute('aria-expanded', 'false');
          const panel = this.querySelector('#' + item.getAttribute('aria-controls'));
          panel.setAttribute('aria-hidden', 'true');
          panel.querySelectorAll('[tabindex="0"]').forEach((element) => element.setAttribute('tabindex', '-1'));
        });
        if (!isOpen) {
          const panel = this.querySelector('#' + button.getAttribute('aria-controls'));
          button.setAttribute('aria-expanded', 'true');
          panel.setAttribute('aria-hidden', 'false');
          panel.querySelectorAll('.ai-scenarios-{{ ai_gen_id }}__scenario').forEach((element) => element.setAttribute('tabindex', '0'));
        }
      }
    }
    customElements.define('scenario-groups-{{ ai_gen_id }}', ScenarioGroups{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Oplossingen scenario's",
  "settings": [
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"header","content":"Groepen"},
    {"type":"text","id":"group_1_name","label":"Groep 1 naam","default":"Secure"},
    {"type":"text","id":"group_1_summary","label":"Groep 1 samenvatting","default":"Voor de basis van veilig online werken"},
    {"type":"textarea","id":"group_1_scenarios","label":"Groep 1 scenario's","info":"Eén regel per scenario: titel | voorbeeldquote"},
    {"type":"text","id":"group_2_name","label":"Groep 2 naam","default":"Guard"},
    {"type":"text","id":"group_2_summary","label":"Groep 2 samenvatting","default":"Extra bescherming en controle voor dagelijks gebruik"},
    {"type":"textarea","id":"group_2_scenarios","label":"Groep 2 scenario's","info":"Eén regel per scenario: titel | voorbeeldquote"},
    {"type":"text","id":"group_3_name","label":"Groep 3 naam","default":"Secure Plus"},
    {"type":"text","id":"group_3_summary","label":"Groep 3 samenvatting","default":"De meest complete bescherming voor uitgebreide behoeften"},
    {"type":"textarea","id":"group_3_scenarios","label":"Groep 3 scenario's","info":"Eén regel per scenario: titel | voorbeeldquote"},
    {"type":"header","content":"Stijl"},
    {"type":"color","id":"background_color","label":"Achtergrond","default":"#ffffff"},
    {"type":"color","id":"card_color","label":"Scenario achtergrond","default":"#f5f3ee"},
    {"type":"color","id":"text_color","label":"Tekst","default":"#322469"},
    {"type":"color","id":"heading_color","label":"Koppen","default":"#322469"},
    {"type":"color","id":"muted_color","label":"Secundaire tekst","default":"#514b68"},
    {"type":"color","id":"border_color","label":"Rand","default":"#c9c3b5"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#e4a311"},
    {"type":"color","id":"accent_text_color","label":"Accenttekst","default":"#322469"},
    {"type":"color","id":"focus_color","label":"Focusrand","default":"#27519b"},
    {"type":"range","id":"radius","label":"Hoekradius","min":0,"max":24,"step":2,"unit":"px","default":4}
  ],
  "presets": [{"name":"Oplossingen scenario's"}],
  "tag": null,
  "class": "oplossingen-scenario-block"
}
{% endschema %}