{%- comment -%}
  One testimonial card. Rendered from a testimonial metaobject passed as `t`.
  Fields: quote, customer_name, customer_context, customer_image, rating.
{%- endcomment -%}
{%- liquid
  assign rating = t.rating | plus: 0
  assign initials = t.customer_name | slice: 0, 1 | upcase
-%}
<article class="rv-card">
  {%- if rating > 0 -%}
    <span class="rv-stars" aria-label="{{ rating }} van 5 sterren">
      {%- for i in (1..5) -%}<svg viewBox="0 0 24 24" fill="{% if i <= rating %}#00b67a{% else %}#d8cdb4{% endif %}" width="16" height="16" aria-hidden="true"><path d="M12 2l3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.8 5.9 20.8 7.1 14l-5-4.8 6.9-.9z"/></svg>{%- endfor -%}
    </span>
  {%- endif -%}
  {%- if t.quote != blank -%}<p class="rv-body">{{ t.quote }}</p>{%- endif -%}
  <div class="rv-by">
    <span class="rv-ava">
      {%- if t.customer_image != blank -%}{{ t.customer_image | image_url: width: 76 | image_tag: alt: t.customer_name, loading: 'lazy' }}{%- else -%}{{ initials }}{%- endif -%}
    </span>
    <div>
      {%- if t.customer_name != blank -%}<div class="rv-name">{{ t.customer_name }}</div>{%- endif -%}
      {%- if t.customer_context != blank -%}<div class="rv-date">{{ t.customer_context }}</div>{%- endif -%}
    </div>
  </div>
</article>
